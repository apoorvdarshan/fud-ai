            "state": "translated",
            "value": "体脂打卡"
          }
        }
      }
    },
    "Log today's body fat % to track your composition trend.": {
      "comment": "Body of the daily body fat reminder notification. % means body fat percentage.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل نسبة دهون جسمك اليوم لتتبّع تغيّر تكوين جسمك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bədən tərkibi trendinizi izləmək üçün bugünkü bədən yağı faizinizi qeyd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapiš dnešní podíl tělesného tuku a sleduj vývoj složení těla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag deinen heutigen Körperfettanteil ein, um den Verlauf deiner Körperzusammensetzung zu verfolgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu porcentaje de grasa corporal de hoy para seguir la evolución de tu composición corporal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ton taux de masse grasse du jour pour suivre l’évolution de ta composition corporelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शरीर की बनावट का रुझान देखने के लिए आज का बॉडी फैट प्रतिशत लॉग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la percentuale di grasso corporeo di oggi per seguire l’andamento della tua composizione corporea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体組成の推移を追うため、今日の体脂肪率を記録しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체성분 추이를 확인하려면 오늘의 체지방률을 기록하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log je vetpercentage van vandaag om het verloop van je lichaamssamenstelling te volgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dzisiejszy procent tkanki tłuszczowej, aby śledzić zmiany składu ciała."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seu percentual de gordura corporal de hoje para acompanhar a evolução da sua composição corporal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează procentul de grăsime corporală de azi ca să urmărești evoluția compoziției corporale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите сегодняшний процент жира, чтобы отслеживать динамику состава тела."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut kompozisyonu eğiliminizi takip etmek için bugünkü vücut yağ oranınızı kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть сьогоднішній відсоток жиру, щоб відстежувати динаміку складу тіла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录今天的体脂率，追踪身体成分趋势。"
          }
        }
      }
    },
    "Fud AI %@ is ready. Tap to update.": {
      "comment": "Body of the app update notification. Fud AI is the app name; the argument is the new version number, such as 7.2.",
      "localizations": {
        "ar": {
