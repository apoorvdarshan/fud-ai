    "Also save meal photos to your gallery when logging": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ أيضًا صور الوجبات في المعرض عند التسجيل"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeyd edərkən yemək fotolarını qalereyada da saxla"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahlzeitfotos beim Protokollieren auch in deiner Galerie speichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also save meal photos to your gallery when logging"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También guarda fotos de comidas en tu galería al registrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer aussi les photos de repas dans votre galerie lors de la saisie"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉग करते समय भोजन की फ़ोटो गैलरी में भी सहेजें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva anche le foto dei pasti nella galleria quando registri"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録時に食事写真をギャラリーにも保存"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록할 때 식사 사진을 갤러리에도 저장"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sla maaltijdfoto's ook op in je galerij bij het loggen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj też zdjęcia posiłków w galerii podczas logowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também salvar fotos de refeições na galeria ao registrar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează și fotografiile meselor în galerie la înregistrare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Также сохранять фото еды в галерею при записи"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Також зберігати фото їжі в галерею під час запису"
          }
        },
        "zh-Hans": {
