    "End your current voice conversation before previewing a voice.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End your current voice conversation before previewing a voice."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنهِ محادثتك الصوتية الحالية قبل معاينة صوت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səs nümunəsini dinləməzdən əvvəl cari səsli söhbətinizi bitirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před poslechem hlasové ukázky ukončete aktuální hlasovou konverzaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
