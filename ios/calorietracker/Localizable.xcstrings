    "This backup doesn't include a finished setup, so let's finish it now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتضمن هذه النسخة الاحتياطية إعدادًا مكتملًا، فلنُكمله الآن."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ehtiyat nüsxədə tamamlanmış quraşdırma yoxdur, gəlin onu indi tamamlayaq."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahle záloha neobsahuje dokončené nastavení, tak ho teď dokončíme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup enthält keine abgeschlossene Einrichtung, also schließen wir sie jetzt ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia no incluye una configuración completa, así que vamos a terminarla ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde ne contient pas de configuration terminée, alors finissons-la maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बैकअप में पूरा सेटअप नहीं है, इसलिए चलिए इसे अभी पूरा करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup non include una configurazione completata, quindi completiamola ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップには完了した設定が含まれていないため、今すぐ設定を完了しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업에는 완료된 설정이 없어요. 지금 설정을 마칠게요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze back-up bevat geen voltooide installatie, dus die ronden we nu af."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia zapasowa nie zawiera ukończonej konfiguracji, więc dokończmy ją teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup não inclui uma configuração concluída, então vamos terminá-la agora."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest backup nu include o configurare finalizată, așa că hai s-o terminăm acum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой резервной копии нет завершённой настройки, поэтому давайте закончим её сейчас."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedekte tamamlanmış bir kurulum yok, şimdi tamamlayalım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця резервна копія не містить завершеного налаштування, тож завершімо його зараз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份不包含已完成的设置，我们现在来完成它。"
          }
        }
      }
    },
    "No iCloud backup found for this Apple ID.": {
