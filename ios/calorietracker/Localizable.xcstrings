    "The voice connection ended. Check your internet connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى الاتصال الصوتي. تحقّق من اتصالك بالإنترنت وحاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Səs bağlantısı sona çatdı. İnternet bağlantınızı yoxlayıb yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlasové spojení skončilo. Zkontroluj připojení k internetu a zkus to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprachverbindung wurde beendet. Prüfe deine Internetverbindung und versuch es noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión de voz terminó. Revisa tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion vocale s’est terminée. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस कनेक्शन समाप्त हो गया। अपना इंटरनेट कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione vocale si è interrotta. Controlla la connessione a Internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声接続が終了しました。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 연결이 종료되었습니다. 인터넷 연결을 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De spraakverbinding is beëindigd. Controleer je internetverbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie głosowe zostało zakończone. Sprawdź połączenie z internetem i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão de voz foi encerrada. Verifique sua conexão com a internet e tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea vocală s-a încheiat. Verifică-ți conexiunea la internet și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовое соединение прервано. Проверьте подключение к интернету и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
