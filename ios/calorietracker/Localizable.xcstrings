    "Plays a short sample without using your microphone. Uses API credits or Fud AI voice minutes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a short sample without using your microphone. Uses API credits or Fud AI voice minutes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل عيّنة قصيرة دون استخدام الميكروفون. يستهلك رصيد API أو دقائق الصوت في Fud AI."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofondan istifadə etmədən qısa səs nümunəsi səsləndirir. API kreditləri və ya Fud AI səs dəqiqələrindən istifadə edir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehraje krátkou ukázku bez použití mikrofonu. Čerpá kredity API nebo hlasové minuty Fud AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt eine kurze Hörprobe ab, ohne dein Mikrofon zu verwenden. Verbraucht API-Guthaben oder Fud AI-Sprachminuten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce una muestra breve sin usar tu micrófono. Consume créditos de API o minutos de voz de Fud AI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit un court extrait sans utiliser votre microphone. Utilise des crédits API ou des minutes vocales Fud AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके माइक्रोफ़ोन का इस्तेमाल किए बिना एक छोटा नमूना सुनाता है। इसमें API क्रेडिट या Fud AI के वॉइस मिनट खर्च होते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce un breve esempio senza usare il microfono. Consuma crediti API o minuti vocali di Fud AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを使わずに短いサンプルを再生します。APIクレジットまたはFud AIの音声利用時間を消費します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 사용하지 않고 짧은 샘플을 재생합니다. API 크레딧 또는 Fud AI 음성 이용 시간이 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt een kort voorbeeld af zonder je microfoon te gebruiken. Verbruikt API-tegoed of Fud AI-spraakminuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarza krótką próbkę bez użycia mikrofonu. Wykorzystuje kredyty API lub minuty rozmów głosowych Fud AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz uma amostra curta sem usar seu microfone. Consome créditos de API ou minutos de voz do Fud AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Redă o mostră scurtă fără a folosi microfonul. Consumă credite API sau minute de voce Fud AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Воспроизводит короткий образец без использования микрофона. Расходует кредиты API или голосовые минуты Fud AI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворює короткий зразок без використання мікрофона. Витрачає кредити API або голосові хвилини Fud AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放一段简短的示例，不使用麦克风。会消耗 API 额度或 Fud AI 语音分钟数。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonunuzu kullanmadan kısa bir örnek oynatır. API kredisi veya Fud AI ses dakikası kullanır."
          }
        }
      }
    },
    "Servings in recipe": {
