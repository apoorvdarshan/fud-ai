    "Men: 10×weight(kg) + 6.25×height(cm) − 5×age + 5\nWomen: 10×weight(kg) + 6.25×height(cm) − 5×age − 161": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرجال: 10×الوزن(كغ) + 6.25×الطول(سم) − 5×العمر + 5\nالنساء: 10×الوزن(كغ) + 6.25×الطول(سم) − 5×العمر − 161"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişilər: 10×çəki(kq) + 6,25×boy(sm) − 5×yaş + 5\nQadınlar: 10×çəki(kq) + 6,25×boy(sm) − 5×yaş − 161"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Männer: 10×Gewicht(kg) + 6,25×Größe(cm) − 5×Alter + 5\nFrauen: 10×Gewicht(kg) + 6,25×Größe(cm) − 5×Alter − 161"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hombres: 10×peso(kg) + 6,25×altura(cm) − 5×edad + 5\nMujeres: 10×peso(kg) + 6,25×altura(cm) − 5×edad − 161"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hommes : 10×poids(kg) + 6,25×taille(cm) − 5×âge + 5\nFemmes : 10×poids(kg) + 6,25×taille(cm) − 5×âge − 161"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुरुष: 10×वज़न(kg) + 6.25×ऊँचाई(cm) − 5×आयु + 5\nमहिलाएँ: 10×वज़न(kg) + 6.25×ऊँचाई(cm) − 5×आयु − 161"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uomini: 10×peso(kg) + 6,25×altezza(cm) − 5×età + 5\nDonne: 10×peso(kg) + 6,25×altezza(cm) − 5×età − 161"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "男性: 10×体重(kg) + 6.25×身長(cm) − 5×年齢 + 5\n女性: 10×体重(kg) + 6.25×身長(cm) − 5×年齢 − 161"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남성: 10×체중(kg) + 6.25×키(cm) − 5×나이 + 5\n여성: 10×체중(kg) + 6.25×키(cm) − 5×나이 − 161"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mannen: 10×gewicht(kg) + 6,25×lengte(cm) − 5×leeftijd + 5\nVrouwen: 10×gewicht(kg) + 6,25×lengte(cm) − 5×leeftijd − 161"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
