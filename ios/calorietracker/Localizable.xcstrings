    "We just launched! Tap to vote and help more people find Fud AI.": {
      "comment": "Body of the Product Hunt launch day notification. Fud AI is the app name.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطلقنا للتو! اضغط للتصويت وساعد المزيد من الأشخاص على اكتشاف Fud AI."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Biz indicə yayımlandıq! Səs vermək üçün toxunun və daha çox insanın Fud AI-ı tapmasına kömək edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě jsme spustili! Klepni, zahlasuj a pomoz dalším lidem najít Fud AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sind gerade gestartet! Tippe, um abzustimmen, und hilf mehr Menschen, Fud AI zu entdecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Acabamos de lanzarnos! Toca para votar y ayuda a que más personas descubran Fud AI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On vient de se lancer ! Touche pour voter et aide plus de monde à découvrir Fud AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने अभी-अभी लॉन्च किया है! वोट करने के लिए टैप करें और ज़्यादा लोगों को Fud AI तक पहुँचने में मदद करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Siamo appena usciti! Tocca per votare e aiuta più persone a scoprire Fud AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ついにローンチしました！タップして投票し、Fud AIをもっと多くの人に届けましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 출시했습니다! 탭하여 투표하고 더 많은 사람이 Fud AI를 알 수 있게 도와주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We zijn net gelanceerd! Tik om te stemmen en help meer mensen Fud AI te ontdekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Właśnie wystartowaliśmy! Stuknij, aby zagłosować i pomóc innym odkryć Fud AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabamos de lançar! Toque para votar e ajude mais pessoas a descobrir o Fud AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocmai ne-am lansat! Atinge pentru a vota și ajută mai mulți oameni să descopere Fud AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы только что запустились! Нажмите, чтобы проголосовать и помочь большему числу людей узнать о Fud AI."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Az önce yayına çıktık! Oy vermek için dokunun ve daha fazla kişinin Fud AI'ı keşfetmesine yardım edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми щойно запустилися! Торкніться, щоб проголосувати й допомогти більшій кількості людей дізнатися про Fud AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们刚刚上线！轻点投票，帮助更多人发现 Fud AI。"
          }
        }
      }
    },
    "No API key configured. Add your key in Settings → AI Provider.": {
      "comment": "Coach chat error when no AI provider API key is saved. Settings → AI Provider is the screen path.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد مفتاح API. أضف مفتاحك في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "API açarı təyin edilməyib. Açarınızı Ayarlar → AI Təminatçısı bölməsində əlavə edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není nastavený žádný klíč API. Přidej svůj klíč v Nastavení → AI poskytovatel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein API-Schlüssel eingerichtet. Füge deinen Schlüssel unter Einstellungen → KI-Anbieter hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave API configurada. Añade tu clave en Ajustes → Proveedor de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé API configurée. Ajoute ta clé dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई API कुंजी सेट नहीं है। सेटिंग्स → AI प्रदाता में अपनी कुंजी जोड़ें।"
          }
        },
