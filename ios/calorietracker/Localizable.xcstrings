            "state": "translated",
            "value": "Çəkini qoruma və hədəf düzəlişi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhaltung & Zielanpassung"
          }
        },
        "es": {
