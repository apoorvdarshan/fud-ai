{
  "sourceLanguage": "en",
  "strings": {
    "barcode.lookup.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline. Check your connection and try scanning again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que no tienes conexión. Revisa tu conexión e intenta escanear de nuevo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, ви офлайн. Перевірте з'єднання та спробуйте сканувати ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı görünüyorsunuz. Bağlantınızı kontrol edip tekrar taramayı deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنك غير متصل بالإنترنت. تحقق من اتصالك وحاول المسح مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Deyəsən, oflayn rejimdəsiniz. Bağlantınızı yoxlayıb yenidən skan edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypadá to, že jsi offline. Zkontroluj připojení a zkus skenovat znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du scheinst offline zu sein. Prüfe deine Verbindung und scanne erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous semblez hors ligne. Vérifiez votre connexion et réessayez de scanner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगता है आप ऑफ़लाइन हैं। अपना कनेक्शन जाँचें और फिर से स्कैन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che tu sia offline. Controlla la connessione e riprova la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインのようです。接続を確認して、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태인 것 같습니다. 연결을 확인하고 다시 스캔하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lijkt offline te zijn. Controleer je verbinding en scan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że jesteś offline. Sprawdź połączenie i zeskanuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que você está offline. Verifique sua conexão e escaneie novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pare că ești offline. Verifică-ți conexiunea și scanează din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, вы не в сети. Проверьте подключение и отсканируйте ещё раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你似乎处于离线状态。请检查网络连接后重新扫描。"
          }
        }
      }
    },
    "barcode.lookup.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts took too long to respond. Try scanning again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts tardó demasiado en responder. Intenta escanear de nuevo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts занадто довго відповідав. Спробуйте сканувати ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts yanıt vermek için çok uzun sürdü. Tekrar taramayı deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق Open Food Facts وقتًا طويلًا للرد. حاول المسح مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts cavab vermək üçün çox vaxt sərf etdi. Yenidən skan edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts odpovídal příliš dlouho. Zkus skenovat znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts hat zu lange gebraucht. Scanne erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts a mis trop de temps à répondre. Réessayez de scanner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts ने जवाब देने में बहुत समय लिया। फिर से स्कैन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts ha impiegato troppo a rispondere. Riprova la scansione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Factsの応答に時間がかかりすぎました。もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts의 응답이 너무 오래 걸렸습니다. 다시 스캔하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts deed er te lang over. Scan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts odpowiadało zbyt długo. Zeskanuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Open Food Facts demorou demais para responder. Escaneie novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts a răspuns prea greu. Scanează din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts отвечал слишком долго. Отсканируйте ещё раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts 响应时间过长。请重新扫描。"
          }
        }
      }
    },
    "barcode.lookup.invalid_barcode": {
      "comment": "Error shown when the scanned barcode is empty or cannot form a safe request.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر قراءة هذا الرمز الشريطي. حاول مسحه ضوئيًا مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu barkodu oxumaq mümkün olmadı. Onu yenidən skan edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Barcode konnte nicht gelesen werden. Scanne ihn erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That barcode could not be read. Try scanning it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer este código de barras. Intenta escanearlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire ce code-barres. Essayez de le scanner à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बारकोड पढ़ा नहीं जा सका। इसे फिर से स्कैन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere questo codice a barre. Prova a scansionarlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバーコードを読み取れませんでした。もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 바코드를 읽을 수 없습니다. 다시 스캔해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze barcode kon niet worden gelezen. Scan hem opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tego kodu kreskowego. Zeskanuj go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler este código de barras. Tente escaneá-lo novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest cod de bare nu a putut fi citit. Scanează-l din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать этот штрихкод. Попробуйте отсканировать его ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати цей штрихкод. Спробуйте відсканувати його ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此条形码。请重新扫描。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu barkod okunamadı. Tekrar taramayı deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čárový kód se nepodařilo přečíst. Zkus ho naskenovat znovu."
          }
        }
      }
    },
    "barcode.lookup.invalid_response": {
      "comment": "Error shown when a barcode response cannot be understood.",
