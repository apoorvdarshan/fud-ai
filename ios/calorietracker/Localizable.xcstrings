        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qısayoldan istifadə etmək üçün Parametrlərdə Oruc izləməni aktiv edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Fasten-Tracking in den Einstellungen, um diese Kurzaktion zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Fasting Tracking in Settings to use this shortcut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el seguimiento de ayuno en Ajustes para usar este atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le suivi du jeûne dans Réglages pour utiliser ce raccourci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस शॉर्टकट का उपयोग करने के लिए सेटिंग्स में उपवास ट्रैकिंग चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il monitoraggio digiuno in Impostazioni per usare questa scorciatoia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットを使うには、設定で断食トラッキングをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축키를 사용하려면 설정에서 단식 추적을 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Vasten bijhouden in Instellingen in om deze snelkoppeling te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Śledzenie postu w Ustawieniach, aby użyć tego skrótu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
