    "You're out of hosted AI actions for today.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفدت إجراءات الذكاء الاصطناعي المستضاف لليوم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün üçün host edilmiş AI əməliyyatlarınız bitdi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro dnešek ti došly akce hostované AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gehosteten KI-Aktionen für heute sind aufgebraucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te quedaste sin acciones de IA alojada por hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez plus d’actions d’IA hébergée pour aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज के लिए आपकी होस्टेड AI कार्रवाइयाँ खत्म हो गई हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai finito le azioni di IA ospitata per oggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日分のホスト型AIの利用回数を使い切りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 사용할 수 있는 호스팅 AI 작업을 모두 사용했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gehoste AI-acties voor vandaag zijn op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na dziś skończyły ci się akcje hostowanego AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas ações de IA hospedada de hoje acabaram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai rămas fără acțiuni AI găzduit pentru azi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действия хостинга ИИ на сегодня закончились."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünlük barındırılan yapay zekâ işlemleriniz bitti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дії хостингу ШІ на сьогодні закінчилися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的托管 AI 次数已用完。"
          }
        }
      }
    },
