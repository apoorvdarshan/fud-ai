          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts a returnat un răspuns neașteptat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts вернул неожиданный ответ."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts повернув неочікувану відповідь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts 返回了意外响应。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts beklenmedik bir yanıt döndürdü."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts vrátil neočekávanou odpověď."
          }
        }
      }
    },
    "barcode.lookup.missing_nutrition": {
      "comment": "Error shown when a barcode exists but has no usable calorie or macronutrient data.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم العثور على هذا الرمز الشريطي، لكن بيانات التغذية غير مكتملة. امسح ملصق القيم الغذائية ضوئيًا بدلًا من ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu barkod tapıldı, lakin qida məlumatları natamamdır. Əvəzində qida dəyəri etiketini skan edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Barcode wurde gefunden, aber die Nährwertangaben sind unvollständig. Scanne stattdessen die Nährwerttabelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This barcode was found, but nutrition data is incomplete. Scan the nutrition label instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró este código de barras, pero los datos nutricionales están incompletos. Escanea la etiqueta nutricional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code-barres a été trouvé, mais les données nutritionnelles sont incomplètes. Scannez plutôt l’étiquette nutritionnelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बारकोड मिल गया, लेकिन पोषण डेटा अधूरा है। इसके बजाय पोषण लेबल स्कैन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice a barre è stato trovato, ma i dati nutrizionali sono incompleti. Scansiona invece l’etichetta nutrizionale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーコードは見つかりましたが、栄養データが不完全です。代わりに栄養成分表示をスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바코드는 찾았지만 영양 정보가 불완전합니다. 대신 영양 성분표를 스캔해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze barcode is gevonden, maar de voedingsgegevens zijn onvolledig. Scan in plaats daarvan het voedingsetiket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaleziono ten kod kreskowy, ale dane żywieniowe są niepełne. Zeskanuj etykietę wartości odżywczych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código de barras foi encontrado, mas os dados nutricionais estão incompletos. Escaneie o rótulo nutricional."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codul de bare a fost găsit, dar datele nutriționale sunt incomplete. Scanează eticheta nutrițională."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Штрихкод найден, но данные о пищевой ценности неполные. Вместо этого отсканируйте этикетку с пищевой ценностью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Штрихкод знайдено, але дані про харчову цінність неповні. Натомість відскануйте етикетку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已找到此条形码，但营养数据不完整。请改为扫描营养成分表。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu barkod bulundu ancak besin verisi eksik. Bunun yerine besin etiketini tarayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čárový kód byl nalezen, ale nutriční údaje jsou neúplné. Naskenuj raději nutriční etiketu."
          }
        }
      }
    },
    "barcode.lookup.network_error": {
      "comment": "Error shown when a barcode request fails because of a network problem.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل البحث عن الرمز الشريطي. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Barkod axtarışı uğursuz oldu. Bağlantınızı yoxlayıb yenidən cəhd edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcode-Suche fehlgeschlagen. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barcode lookup failed. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda del código de barras falló. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la recherche du code-barres. Vérifiez votre connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बारकोड खोज विफल रही। अपना कनेक्शन जाँचें और फिर प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca del codice a barre non riuscita. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーコードの検索に失敗しました。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바코드 조회에 실패했습니다. 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opzoeken van barcode mislukt. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie kodu kreskowego nie powiodło się. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao consultar o código de barras. Verifique sua conexão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Căutarea codului de bare a eșuat. Verifică conexiunea și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти штрихкод. Проверьте подключение и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося знайти штрихкод. Перевірте з'єднання та спробуйте знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条形码查询失败。请检查网络连接后重试。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barkod araması başarısız oldu. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyhledání čárového kódu selhalo. Zkontroluj připojení a zkus to znovu."
          }
        }
      }
    },
    "barcode.lookup.product_not_found": {
      "comment": "Error shown when Open Food Facts does not contain the scanned product.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على المنتج في Open Food Facts. امسح ملصق القيم الغذائية ضوئيًا بدلًا من ذلك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məhsul Open Food Facts-da tapılmadı. Əvəzində qida dəyəri etiketini skan edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkt nicht in Open Food Facts gefunden. Scanne stattdessen die Nährwerttabelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Product not found in Open Food Facts. Scan the nutrition label instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Producto no encontrado en Open Food Facts. Escanea la etiqueta nutricional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Produit introuvable dans Open Food Facts. Scannez plutôt l’étiquette nutritionnelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्पाद Open Food Facts में नहीं मिला। इसके बजाय पोषण लेबल स्कैन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prodotto non trovato in Open Food Facts. Scansiona invece l’etichetta nutrizionale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts に製品が見つかりませんでした。代わりに栄養成分表示をスキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts에서 제품을 찾지 못했습니다. 대신 영양 성분표를 스캔해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Product niet gevonden in Open Food Facts. Scan in plaats daarvan het voedingsetiket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono produktu w Open Food Facts. Zeskanuj etykietę wartości odżywczych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Produto não encontrado no Open Food Facts. Escaneie o rótulo nutricional."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Produsul nu a fost găsit în Open Food Facts. Scanează eticheta nutrițională."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продукт не найден в Open Food Facts. Вместо этого отсканируйте этикетку с пищевой ценностью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продукт не знайдено в Open Food Facts. Натомість відскануйте етикетку з харчовою цінністю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts 中未找到该产品。请改为扫描营养成分表。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürün Open Food Facts'te bulunamadı. Bunun yerine besin etiketini tarayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkt nebyl v Open Food Facts nalezen. Naskenuj raději nutriční etiketu."
          }
        }
      }
    },
    "barcode.lookup.rate_limited": {
      "comment": "Error shown when Open Food Facts temporarily rate-limits barcode requests.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد كبير جدًا من عمليات البحث عن الرموز الشريطية. انتظر قليلًا ثم حاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həddindən çox barkod axtarışı edildi. Bir az gözləyib yenidən cəhd edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Barcode-Suchen. Warte einen Moment und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many barcode lookups. Wait a moment and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas búsquedas de códigos de barras. Espera un momento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de recherches de codes-barres. Patientez un instant et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत अधिक बारकोड खोजें की गई हैं। कुछ देर प्रतीक्षा करके फिर प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe ricerche di codici a barre. Attendi un momento e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バーコードの検索回数が多すぎます。しばらく待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바코드 조회가 너무 많습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel barcodezoekopdrachten. Wacht even en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele wyszukiwań kodów kreskowych. Poczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas consultas de código de barras. Aguarde um momento e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea multe căutări de coduri de bare. Așteaptă puțin și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много запросов штрихкода. Подождите немного и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занадто багато запитів штрихкода. Зачекайте трохи та спробуйте знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条形码查询次数过多。请稍候再试。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla barkod araması yapıldı. Biraz bekleyin ve tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho vyhledávání čárových kódů. Chvíli počkej a zkus to znovu."
          }
        }
      }
    },
    "barcode.lookup.service_unavailable": {
      "comment": "Error shown when the Open Food Facts service returns a server error.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts غير متاح مؤقتًا. حاول مرة أخرى لاحقًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts müvəqqəti olaraq əlçatan deyil. Daha sonra yenidən cəhd edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts ist vorübergehend nicht verfügbar. Versuche es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts is temporarily unavailable. Try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts no está disponible temporalmente. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts est temporairement indisponible. Réessayez plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts अस्थायी रूप से उपलब्ध नहीं है। बाद में फिर प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts non è temporaneamente disponibile. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts は一時的に利用できません。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts를 일시적으로 사용할 수 없습니다. 나중에 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts is tijdelijk niet beschikbaar. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts jest tymczasowo niedostępny. Spróbuj ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Open Food Facts está temporariamente indisponível. Tente novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts este indisponibil temporar. Încearcă din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts временно недоступен. Повторите попытку позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts тимчасово недоступний. Спробуйте пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts 暂时不可用。请稍后再试。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts geçici olarak kullanılamıyor. Daha sonra tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts je dočasně nedostupný. Zkus to později."
          }
        }
      }
    },
