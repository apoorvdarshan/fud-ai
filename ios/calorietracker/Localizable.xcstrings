    "Please say a weight, such as 75 kilograms or 165 pounds.": {
      "comment": "Siri reply when the spoken weight has no number.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرجى قول وزن، مثل 75 kg أو 165 lb."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Zəhmət olmasa çəki deyin, məsələn, 75 kg və ya 165 lb."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekni prosím váhu, například 75 kg nebo 165 lb."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte nenne ein Gewicht, zum Beispiel 75 kg oder 165 lb."
          }
        },
