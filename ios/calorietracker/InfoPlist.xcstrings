{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Fud AI الكاميرا لمسح الطعام والرموز الشريطية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI qida və ştrix-kodları skan etmək üçün kameradan istifadə edir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI verwendet die Kamera, um Lebensmittel und Barcodes zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI uses the camera to scan food and barcodes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI usa la cámara para escanear alimentos y códigos de barras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI utilise l’appareil photo pour scanner les aliments et les codes-barres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI भोजन और बारकोड स्कैन करने के लिए कैमरे का उपयोग करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI usa la fotocamera per scansionare alimenti e codici a barre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AIは、食品やバーコードのスキャンにカメラを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI는 음식과 바코드를 스캔하기 위해 카메라를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI gebruikt de camera om voedsel en barcodes te scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI używa aparatu do skanowania żywności i kodów kreskowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fud AI usa a câmera para escanear alimentos e códigos de barras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI folosește camera pentru a scana alimente și coduri de bare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI использует камеру для сканирования продуктов и штрихкодов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI використовує камеру для сканування продуктів и штрихкодов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI 使用相机扫描食物和条形码。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ Fud AI صور الوجبات في مكتبة الصور عند النقر على حفظ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI \"Yadda saxla\" düyməsinə toxunanda yemək şəkillərini foto kitabxananıza yadda saxlayır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI speichert Mahlzeitfotos in deiner Fotomediathek, wenn du auf Speichern tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI saves meal photos to your photo library when you tap Save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI guarda fotos de comidas en tu biblioteca de fotos cuando tocas Guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI enregistre les photos de repas dans votre photothèque lorsque vous touchez Enregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप सहेजें पर टैप करते हैं, तो Fud AI भोजन की तस्वीरें आपकी फोटो लाइब्रेरी में सहेजता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI salva le foto dei pasti nella libreria foto quando tocchi Salva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AIは「保存」をタップすると、食事の写真をフォトライブラリに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI는 저장을 탭하면 식사 사진을 사진 보관함에 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI slaat maaltijdfoto's op in je fotobibliotheek wanneer je op Opslaan tikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI zapisuje zdjęcia posiłków w bibliotece zdjęć po dotknięciu Zapisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fud AI salva fotos de refeições na sua biblioteca de fotos quando você toca em Salvar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI salvează fotografiile meselor în biblioteca foto când atingi Salvează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI сохраняет фото блюд в медиатеку, когда вы нажимаете «Сохранить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI зберігає фото страв в медiatеку, когда ви нажимаете «Зберегти»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你点按“保存”时，Fud AI 会将餐食照片保存到照片图库。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
