    "Shown in the + menu for one-tap water logging.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر في قائمة + لتسجيل الماء بنقرة واحدة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir toxunuşla su qeydi üçün + menyusunda göstərilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazuje se v nabídce + pro zapsání vody jedním klepnutím."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erscheinen im +-Menü, um Wasser mit einem Tippen zu erfassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestran en el menú + para registrar agua con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichées dans le menu + pour enregistrer l’eau d’un simple toucher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टैप में पानी लॉग करने के लिए + मेनू में दिखती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrate nel menu + per registrare l’acqua con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ メニューに表示され、ワンタップで水分を記録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 메뉴에 표시되어 한 번의 탭으로 물을 기록할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Getoond in het +-menu om water met één tik te registreren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlane w menu + do zapisywania wody jednym dotknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparecem no menu + para registrar água com um toque."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apar în meniul + pentru a înregistra apa cu o singură atingere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показываются в меню «+», чтобы записывать воду одним касанием."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek dokunuşla su kaydı için + menüsünde gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показуються в меню «+», щоб записувати воду одним дотиком."
