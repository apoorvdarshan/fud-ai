        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドイツに住んでいます。ヨーロッパの分量を想定してください。ボディビルのカット中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독일에 살고 있습니다. 유럽식 1인분 크기를 가정해주세요. 보디빌딩 컷 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik woon in Duitsland, ga uit van Europese portiegroottes. Ik zit in een bodybuilding-cut."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieszkam w Niemczech, zakładaj europejskie porcje. Jestem na redukcji kulturystycznej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Moro na Alemanha, considere porções europeias. Estou em fase de cutting de musculação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Locuiesc în Germania, presupune porții europene. Sunt în faza de cut de culturism."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я живу в Германии, считай порции европейскими. Я на сушке для бодибилдинга."
