    "Keep your nutrition and body\nmeasurements in sync automatically.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu nutrición y tus\nmedidas corporales sincronizadas automáticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni sincronizzati automaticamente\nnutrizione e misure corporee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie synchronizuj odżywianie\ni pomiary ciała."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите питание и измерения тела\nв синхронизации автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізуйте харчування та вимірювання\nтіла автоматично."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Udržuj výživu a tělesné míry\nautomaticky synchronizované."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beslenme ve vücut\nölçümlerinizi otomatik olarak eşzamanlı tutun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على مزامنة تغذيتك وقياسات\nجسمك تلقائيًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qidalanma və bədən ölçülərinizi\navtomatik sinxron saxlayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte Ernährung und Körpermaße\nautomatisch synchron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez automatiquement votre nutrition\net vos mesures corporelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
