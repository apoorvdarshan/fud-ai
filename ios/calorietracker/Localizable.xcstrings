    "Couldn't read everything from Apple Health. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة كل البيانات من Apple Health. حاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health-dən bütün məlumatları oxumaq alınmadı. Yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Z Apple Health se nepodařilo načíst všechno. Zkus to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht alles konnte aus Apple Health gelesen werden. Versuch es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer todo desde Apple Health. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de tout lire depuis Apple Health. Réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health से सारा डेटा नहीं पढ़ा जा सका। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere tutto da Apple Health. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Healthからすべてのデータを読み込めませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health에서 모든 데이터를 읽지 못했어요. 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet alles kon uit Apple Health worden gelezen. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać wszystkiego z Apple Health. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler tudo do Apple Health. Tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut citi tot din Apple Health. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать все данные из Apple Health. Попробуйте ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Sağlık'taki verilerin tümü okunamadı. Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати всі дані з Apple Health. Спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从 Apple Health 读取全部数据。请重试。"
          }
        }
