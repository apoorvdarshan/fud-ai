          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Separat de obiectivele de calorii, proteine, carbohidrați și grăsimi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельно от целей по калориям, белкам, углеводам и жирам."
          }
        },
        "zh-Hans": {
