          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há outros participantes no ranking. Puxe para baixo para atualizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există alți participanți clasați. Trage în jos pentru actualizare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Других участников в рейтинге пока нет. Потяните вниз, чтобы обновить."
