        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة الطعام من يومياتك. تبقى المفضلة المحفوظة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, qidanı gündəliyinizdən silir. Saxlanılmış seçilmişlər qalır."
