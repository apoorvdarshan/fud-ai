            "value": "تمت استعادة نسختك الاحتياطية من %@."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarixli ehtiyat nüsxəniz bərpa edildi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záloha z %@ je obnovená."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Backup vom %@ wurde wiederhergestellt."
          }
        },
        "es": {
