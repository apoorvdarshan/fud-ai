    "whisper.error.busy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base مشغول بالفعل. يُرجى الانتظار حتى انتهاء العملية الحالية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base artıq məşğuldur. Cari əməliyyat bitənədək gözləyin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base ist bereits beschäftigt. Bitte warte, bis der aktuelle Vorgang abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base is already busy. Please wait for the current operation to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base ya está ocupado. Espera a que termine la operación actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base est déjà occupé. Veuillez attendre la fin de l’opération en cours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base पहले से व्यस्त है। कृपया मौजूदा प्रक्रिया पूरी होने तक प्रतीक्षा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base è già occupato. Attendi il completamento dell’operazione corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base はすでに処理中です。現在の処理が完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base가 이미 작업 중입니다. 현재 작업이 끝날 때까지 기다려 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base is al bezig. Wacht tot de huidige bewerking is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base jest już zajęty. Poczekaj na zakończenie bieżącej operacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whisper Base já está ocupado. Aguarde a conclusão da operação atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base este deja ocupat. Așteptați finalizarea operațiunii curente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base уже занят. Дождитесь завершения текущей операции."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
