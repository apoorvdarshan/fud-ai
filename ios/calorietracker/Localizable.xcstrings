    "%@ %@ · Renews automatically, cancel anytime.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Renews automatically, cancel anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Se renueva automáticamente, cancela cuando quieras."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · يتجدد تلقائيًا، ويمكنك الإلغاء في أي وقت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Avtomatik yenilənir, istənilən vaxt ləğv edə bilərsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Obnovuje se automaticky, zrušit můžeš kdykoli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Verlängert sich automatisch, jederzeit kündbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Renouvellement automatique, résiliable à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · अपने-आप रिन्यू होता है, कभी भी रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Si rinnova automaticamente, annulla quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · 自動更新。いつでもキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · 자동 갱신되며 언제든지 해지할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Wordt automatisch verlengd, altijd opzegbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Odnawia się automatycznie, możesz anulować w dowolnym momencie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Renova automaticamente, cancele quando quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Se reînnoiește automat, poți anula oricând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Продлевается автоматически, отменить можно в любое время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Otomatik olarak yenilenir, istediğiniz zaman iptal edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · Поновлюється автоматично, скасувати можна будь-коли."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ · 自动续订，可随时取消。"
          }
        }
      }
    },
