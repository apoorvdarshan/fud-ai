    "Microphone access is off. Turn it on for Fud AI in the iOS Settings app to talk to the assistant.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الميكروفون متوقف. فعّله لتطبيق Fud AI في تطبيق الإعدادات لتتحدث إلى المساعد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofona giriş söndürülüb. Köməkçi ilə danışmaq üçün iOS Ayarlar tətbiqində Fud AI üçün onu aktiv edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přístup k mikrofonu je vypnutý. Zapni ho pro Fud AI v aplikaci Nastavení, abys mohl mluvit s asistentem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist aus. Aktiviere ihn für Fud AI in der Einstellungen-App, um mit dem Assistenten zu sprechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono está desactivado. Actívalo para Fud AI en la app Ajustes para hablar con el asistente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès au micro est désactivé. Activez-le pour Fud AI dans l’app Réglages pour parler à l’assistant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन एक्सेस बंद है। असिस्टेंट से बात करने के लिए iOS सेटिंग्स ऐप में Fud AI के लिए इसे चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso al microfono è disattivato. Attivalo per Fud AI nell’app Impostazioni per parlare con l’assistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスがオフになっています。アシスタントと話すには、iOSの「設定」アプリでFud AIのマイクをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근이 꺼져 있습니다. 어시스턴트와 대화하려면 iOS 설정 앱에서 Fud AI의 마이크 접근을 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoontoegang staat uit. Zet het aan voor Fud AI in de Instellingen-app om met de assistent te praten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu jest wyłączony. Włącz go dla Fud AI w aplikacji Ustawienia, aby rozmawiać z asystentem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone está desativado. Ative-o para o Fud AI no app Ajustes para falar com o assistente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesul la microfon este dezactivat. Activează-l pentru Fud AI în aplicația Configurări ca să vorbești cu asistentul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону выключен. Включите его для Fud AI в приложении «Настройки», чтобы говорить с ассистентом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon erişimi kapalı. Asistanla konuşmak için iOS Ayarlar uygulamasında Fud AI için açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона вимкнено. Увімкніть його для Fud AI у програмі «Параметри», щоб говорити з асистентом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风访问已关闭。请在 iOS“设置”App 中为 Fud AI 打开麦克风，才能与助手对话。"
          }
        }
      }
    },
    "Fud AI couldn't check your subscription. Try again in a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Fud AI التحقق من اشتراكك. حاول مرة أخرى بعد قليل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI abunəliyinizi yoxlaya bilmədi. Bir az sonra yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI nemohlo ověřit tvé předplatné. Zkus to znovu za chvíli."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI konnte dein Abo nicht prüfen. Versuch es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI no pudo comprobar tu suscripción. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI n’a pas pu vérifier votre abonnement. Réessayez dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI आपकी सदस्यता जाँच नहीं सका। थोड़ी देर में फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI non è riuscito a controllare il tuo abbonamento. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AIはサブスクリプションを確認できませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI가 구독을 확인하지 못했습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI kon je abonnement niet controleren. Probeer het zo opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI nie mogło sprawdzić twojej subskrypcji. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fud AI não conseguiu verificar sua assinatura. Tente de novo em instantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI nu ți-a putut verifica abonamentul. Încearcă din nou peste puțin timp."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI не удалось проверить вашу подписку. Повторите попытку чуть позже."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI aboneliğinizi kontrol edemedi. Biraz sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI не вдалося перевірити вашу підписку. Спробуйте ще раз трохи згодом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI 无法确认你的订阅。请稍后再试。"
          }
        }
      }
    },
    "The microphone isn't available right now. Try again.": {
