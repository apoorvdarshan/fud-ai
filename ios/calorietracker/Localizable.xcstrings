    "Aggressive but doable. Requires strong discipline.": {
      "comment": "A description of the fastest pace.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exigente pero alcanzable. Requiere mucha disciplina."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggressivo ma fattibile. Richiede molta disciplina."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agresywne, ale wykonalne. Wymaga dużej dyscypliny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агрессивно, но выполнимо. Требует высокой дисциплины."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агресивно, але досяжно. Потребує суворої дисципліни."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Agresivní, ale zvládnutelné. Vyžaduje pevnou disciplínu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zorlayıcı ama ulaşılabilir. Güçlü bir disiplin gerektirir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حازم لكنه قابل للتنفيذ. يتطلب انضباطًا قويًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqressiv, lakin mümkündür. Güclü intizam tələb edir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggressiv, aber machbar. Erfordert starke Disziplin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agressif mais réalisable. Demande une grande discipline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीव्र लेकिन संभव। मज़बूत अनुशासन की ज़रूरत है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "積極的だが実行可能。強い自制心が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공격적이지만 가능합니다. 강한 절제가 필요해요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agressief maar haalbaar. Vereist sterke discipline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agressivo, mas viável. Exige bastante disciplina."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Agresiv, dar realizabil. Necesită disciplină puternică."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激进但可行。需要较强的自律。"
          }
        }
      }
    },
