    "Your food log, weight history, body-fat history, and BYOK API keys stay on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى سجل طعامك وتاريخ وزنك ودهون جسمك ومفاتيح BYOK API على هذا الجهاز."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yemək qeydləriniz, çəki və bədən yağı tarixçəniz və BYOK API açarlarınız bu cihazda qalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Ernährungstagebuch, Gewichtsverlauf, Körperfettverlauf und BYOK-API-Schlüssel bleiben auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu registro de comidas, historial de peso, historial de grasa corporal y claves API BYOK permanecen en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journal alimentaire, l'historique de poids, de masse grasse et vos clés API BYOK restent sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ूड लॉग, वज़न हिस्ट्री, बॉडी-फैट हिस्ट्री और BYOK API कीज़ इसी डिवाइस पर रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il diario alimentare, lo storico di peso e massa grassa e le chiavi API BYOK restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事記録、体重・体脂肪の履歴、BYOKのAPIキーはこの端末内に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식 기록, 체중·체지방 기록, BYOK API 키는 이 기기에만 저장됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je voedingslog, gewichts- en vetpercentagegeschiedenis en BYOK-API-sleutels blijven op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dziennik posiłków, historia wagi i tkanki tłuszczowej oraz klucze API BYOK pozostają na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu diário alimentar, histórico de peso, histórico de gordura corporal e chaves de API BYOK ficam neste aparelho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnalul alimentar, istoricul greutății, al grăsimii corporale și cheile API BYOK rămân pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш дневник питания, история веса и жира, а также BYOK API-ключи остаются на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш журнал харчування, історія ваги, історія відсотка жиру та ключі API (BYOK) залишаються на цьому пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的饮食记录、体重和体脂历史以及 BYOK API 密钥都保存在本设备上。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Deník jídel, historie váhy, historie tělesného tuku i tvoje BYOK API klíče zůstávají v tomto zařízení."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yiyecek günlüğünüz, kilo geçmişiniz, vücut yağ oranı geçmişiniz ve kendi API anahtarlarınız (BYOK) bu cihazda kalır."
          }
        }
      }
    },
    "Your plan auto-adjusts weekly as you log — turn off Adaptive Goals in Settings to keep it fixed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتعدّل خطتك تلقائيًا كل أسبوع حسب تسجيلاتك — أوقف Adaptive Goals من الإعدادات لإبقائها ثابتة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Planınız qeydlərinizə əsasən hər həftə avtomatik tənzimlənir — sabit saxlamaq üçün Parametrlərdə Adaptive Goals-u söndürün."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Plan passt sich wöchentlich an, während du loggst — deaktiviere Adaptive Goals in den Einstellungen, um ihn fest zu lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan se ajusta automáticamente cada semana según lo que registras — desactiva Adaptive Goals en Ajustes para mantenerlo fijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre plan s'ajuste automatiquement chaque semaine selon vos repas — désactivez Adaptive Goals dans Réglages pour le garder fixe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका प्लान आपकी लॉगिंग के अनुसार हर हफ़्ते अपने आप एडजस्ट होता है — इसे स्थिर रखने के लिए सेटिंग्स में Adaptive Goals बंद करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo piano si adatta automaticamente ogni settimana in base ai log — disattiva Adaptive Goals nelle Impostazioni per mantenerlo fisso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランは記録に合わせて週1回自動調整されます。固定したい場合は設定でAdaptive Goalsをオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랜은 기록에 따라 매주 자동 조정됩니다 — 고정하려면 설정에서 Adaptive Goals를 끄세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je plan past zich wekelijks aan op basis van je logs — zet Adaptive Goals uit in Instellingen om het vast te houden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój plan dostosowuje się co tydzień na podstawie wpisów — wyłącz Cele adaptacyjne w Ustawieniach, aby pozostał stały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano se ajusta automaticamente toda semana conforme você registra — desative o Adaptive Goals em Ajustes para mantê-lo fixo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Planul tău se ajustează automat săptămânal pe măsură ce înregistrezi — dezactivează Adaptive Goals din Setări pentru a-l păstra fix."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш план автоматически корректируется каждую неделю по мере записей — отключите Адаптивные цели в настройках, чтобы он оставался неизменным."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш план автоматично коригується щотижня, коли ви ведете записи — вимкніть Адаптивні цілі в Налаштуваннях, щоб зафіксувати його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的计划会根据记录每周自动调整 — 想保持不变，可在设置中关闭 Adaptive Goals。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj plán se každý týden sám upravuje podle zápisů — pokud ho chceš pevný, vypni Adaptivní cíle v Nastavení."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettikçe planınız haftalık olarak otomatik ayarlanır — sabit tutmak için Ayarlar’dan Uyarlanabilir Hedefler’i kapatın."
          }
        }
      }
    },
    "Your support keeps Fud AI free for everyone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعمك يُبقي Fud AI مجانيًا للجميع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəstəyiniz Fud AI-ni hamı üçün pulsuz saxlayır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Unterstützung hält Fud AI für alle kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apoyo mantiene Fud AI gratis para todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre soutien garde Fud AI gratuit pour tous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सहयोग Fud AI को सबके लिए मुफ़्त रखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo supporto mantiene Fud AI gratuita per tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのサポートがFud AIをみんなの無料アプリに保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 후원이 Fud AI를 모두에게 무료로 유지해 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw steun houdt Fud AI gratis voor iedereen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wsparcie utrzymuje Fud AI darmowym dla wszystkich."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu apoio mantém o Fud AI gratuito para todos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprijinul tău menține Fud AI gratuită pentru toți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша поддержка сохраняет Fud AI бесплатным для всех."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша підтримка зберігає Fud AI безкоштовним для всіх."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的支持让 Fud AI 对所有人保持免费。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje podpora drží Fud AI zdarma pro všechny."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteğiniz Fud AI’ın herkes için ücretsiz kalmasına yardımcı olur."
          }
        }
      }
    },
    "Reinstalled or switched phones? Your food log, weight, and body fat now restore automatically from Apple Health.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعدت التثبيت أو غيّرت هاتفك؟ يُستعاد الآن سجل طعامك ووزنك ودهون جسمك تلقائيًا من Apple Health."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yenidən quraşdırmısınız və ya telefonu dəyişmisiniz? Yemək jurnalınız, çəkiniz və bədən yağınız indi Apple Health-dən avtomatik bərpa olunur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu installiert oder neues iPhone? Ernährungstagebuch, Gewicht und Körperfett werden jetzt automatisch aus Apple Health wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reinstalaste o cambiaste de teléfono? Tu registro de comidas, peso y grasa corporal ahora se restauran automáticamente desde Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinstallation ou nouveau téléphone ? Ton journal alimentaire, ton poids et ta masse grasse se restaurent désormais automatiquement depuis Apple Health."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा इंस्टॉल किया या फ़ोन बदला? आपका फ़ूड लॉग, वज़न और बॉडी फ़ैट अब Apple Health से अपने आप बहाल हो जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai reinstallato o cambiato telefono? Diario alimentare, peso e grasso corporeo ora si ripristinano automaticamente da Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再インストールや機種変更をしても、食事記録・体重・体脂肪がApple Healthから自動的に復元されるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재설치했거나 휴대폰을 바꿨나요? 이제 음식 기록, 체중, 체지방이 Apple Health에서 자동으로 복원됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw geïnstalleerd of een nieuwe telefoon? Je voedingslogboek, gewicht en vetpercentage worden nu automatisch hersteld uit Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowna instalacja lub nowy telefon? Dziennik posiłków, waga i tkanka tłuszczowa są teraz automatycznie przywracane z Apple Health."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalou ou trocou de celular? Seu diário alimentar, peso e gordura corporal agora são restaurados automaticamente do Apple Health."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai reinstalat sau ai schimbat telefonul? Jurnalul alimentar, greutatea și grăsimea corporală se restaurează acum automat din Apple Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переустановили приложение или сменили телефон? Дневник питания, вес и процент жира теперь автоматически восстанавливаются из Apple Health."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевстановили застосунок або змінили телефон? Журнал харчування, вага та відсоток жиру тепер автоматично відновлюються з Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安装或更换手机后，你的饮食记录、体重和体脂现在会从 Apple Health 自动恢复。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přeinstalace nebo nový telefon? Deník jídel, váha i tělesný tuk se teď automaticky obnoví z Apple Health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı yeniden yüklediyseniz veya telefon değiştirdiyseniz yiyecek günlüğünüz, kilonuz ve vücut yağ oranınız artık Apple Health’ten otomatik olarak geri yüklenir."
          }
        }
      }
    },
    "Share any meal as a link that opens straight in Fud AI.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك أي وجبة كرابط يفتح مباشرة في Fud AI."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İstənilən yeməyi birbaşa Fud AI-da açılan link kimi paylaşın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile jede Mahlzeit als Link, der direkt in Fud AI öffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte cualquier comida como un enlace que se abre directamente en Fud AI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage n'importe quel repas via un lien qui s'ouvre directement dans Fud AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी भोजन को लिंक के रूप में साझा करें जो सीधे Fud AI में खुलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi qualsiasi pasto come link che si apre direttamente in Fud AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの食事もリンクとして共有でき、Fud AIで直接開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 식사든 링크로 공유하면 Fud AI에서 바로 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel elke maaltijd als een link die direct in Fud AI opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
