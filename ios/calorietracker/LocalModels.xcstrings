    "whisper.providerDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Whisper Base متعدد اللغات بالكامل على هذا الـ iPhone. نزّله مرة واحدة للحصول على نسخ خاص دون اتصال بالإنترنت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoxdilli Whisper Base tamamilə bu iPhone-da işləyir. Məxfi oflayn transkripsiya üçün onu bir dəfə endirin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das mehrsprachige Whisper Base läuft vollständig auf diesem iPhone. Lade es einmalig für private Offline-Transkription herunter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multilingual Whisper Base running entirely on this iPhone. Download once for private offline transcription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base multilingüe se ejecuta íntegramente en este iPhone. Descárgalo una vez para obtener transcripciones privadas sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base multilingue s’exécute entièrement sur cet iPhone. Téléchargez-le une fois pour une transcription privée hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुभाषी Whisper Base पूरी तरह इस iPhone पर चलता है। निजी ऑफ़लाइन ट्रांसक्रिप्शन के लिए इसे एक बार डाउनलोड करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base multilingue viene eseguito interamente su questo iPhone. Scaricalo una volta per trascrizioni private offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多言語対応の Whisper Base はすべてこの iPhone 上で動作します。一度ダウンロードすれば、プライベートなオフライン文字起こしを利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다국어 Whisper Base가 이 iPhone에서 완전히 실행됩니다. 한 번 다운로드하면 비공개 오프라인 전사를 이용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meertalige Whisper Base draait volledig op deze iPhone. Download het eenmalig voor privétranscriptie zonder internetverbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wielojęzyczny Whisper Base działa w całości na tym iPhonie. Pobierz go raz, aby korzystać z prywatnej transkrypcji offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whisper Base multilíngue é executado inteiramente neste iPhone. Baixe uma vez para fazer transcrições privadas off-line."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base multilingv rulează integral pe acest iPhone. Descărcați-l o singură dată pentru transcriere privată offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Многоязычный Whisper Base полностью работает на этом iPhone. Загрузите его один раз для конфиденциальной офлайн-транскрипции."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Многоязичний Whisper Base полностью работает на цьому iPhone. Загрузите его один раз для конфіденційної офлайн-транскрипции."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多语言 Whisper Base 完全在此 iPhone 上运行。下载一次即可进行私密的离线转写。"
          }
        }
      }
    },
