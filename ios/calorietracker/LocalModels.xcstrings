          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de stockage disponible n’a pas pu être vérifié. Le téléchargement du modèle volumineux n’a donc pas démarré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध स्टोरेज की जांच नहीं हो सकी, इसलिए बड़े मॉडल का डाउनलोड शुरू नहीं किया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile verificare lo spazio disponibile, quindi il download del modello di grandi dimensioni non è iniziato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能なストレージを確認できなかったため、大容量モデルのダウンロードは開始されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 저장 공간을 확인할 수 없어 대용량 모델 다운로드를 시작하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De beschikbare opslag kon niet worden gecontroleerd. Daarom is de download van het grote model niet gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się sprawdzić dostępnego miejsca, dlatego nie rozpoczęto pobierania dużego modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o armazenamento disponível, então o download do modelo grande não foi iniciado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spațiul de stocare disponibil nu a putut fi verificat, deci descărcarea modelului mare nu a început."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
