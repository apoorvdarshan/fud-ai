    "Resets at midnight UTC. Credit packs cover busy days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reinicia a medianoche UTC. Los paquetes de créditos cubren los días de más uso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعاد عند منتصف الليل بتوقيت UTC. وتغطي حزم الأرصدة الأيام المزدحمة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "UTC ilə gecə yarısı sıfırlanır. Sıx günlər üçün kredit paketləri var."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovuje se o půlnoci UTC. Na rušné dny jsou tu balíčky kreditů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird um Mitternacht UTC zurückgesetzt. Credit-Pakete helfen an vollen Tagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialisé à minuit UTC. Les packs de crédits couvrent les journées chargées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "UTC आधी रात को रीसेट होता है। व्यस्त दिनों के लिए क्रेडिट पैक हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si azzera a mezzanotte UTC. I pacchetti di crediti coprono le giornate più intense."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UTCの午前0時にリセット。忙しい日はクレジットパックで補えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UTC 자정에 초기화됩니다. 바쁜 날에는 크레딧 팩으로 보충하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt om middernacht UTC gereset. Creditpakketten vangen drukke dagen op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Resetuje się o północy UTC. Na intensywne dni są pakiety kredytów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renovada à meia-noite UTC. Pacotes de créditos cobrem os dias mais movimentados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se resetează la miezul nopții UTC. Pachetele de credite acoperă zilele aglomerate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновляется в полночь по UTC. Пакеты кредитов выручат в насыщенные дни."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gece UTC gece yarısında sıfırlanır. Yoğun günler için kredi paketleri vardır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлюється опівночі за UTC. Пакети кредитів виручать у насичені дні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 UTC 午夜重置。忙碌的日子可用点数包补充。"
          }
        }
      }
    },
