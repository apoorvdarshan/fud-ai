          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティルールに沿った別の表示名を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커뮤니티 규칙을 준수하는 다른 표시 이름을 선택하세요."
          }
        },
        "nl": {
