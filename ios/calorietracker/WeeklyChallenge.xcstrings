    "Enter a handle only—without @, spaces, or a profile URL.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسم المستخدم فقط، دون @ أو رابط."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "@ və ya keçid olmadan yalnız istifadəçi adını daxil edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das Handle ohne @ oder Link eingeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a handle only—without @, spaces, or a profile URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce solo el usuario, sin @ ni enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez uniquement l’identifiant, sans @ ni lien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@ या लिंक के बिना केवल यूज़रनेम लिखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci solo il nome utente, senza @ o link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@やリンクを付けずにユーザー名だけを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@ 또는 링크 없이 사용자 이름만 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer alleen de gebruikersnaam in, zonder @ of link."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź tylko uchwyt - bez @, spacji lub adresu URL profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite somente o nome de usuário, sem @ ou link."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu doar identificatorul, fără @ sau link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите только имя пользователя, без @ и ссылки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть лише ім’я користувача — без @, пробілів чи URL профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅输入用户名，不要包含 @ 或链接。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir kullanıcı adı girin — @, boşluk veya profil URL'si olmadan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej jen uživatelské jméno — bez @, mezer nebo URL profilu."
          }
        }
      }
    },
