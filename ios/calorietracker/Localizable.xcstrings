    "Pair chest/back, shoulders/arms, legs, and core days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina días de pecho/espalda, hombros/brazos, piernas y core."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع بين أيام الصدر/الظهر، والكتفين/الذراعين، والساقين، والجذع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinə/kürək, çiyinlər/qollar, ayaqlar və kor günlərini cütləşdirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinuj dny hrudník/záda, ramena/paže, nohy a střed těla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombiniere Tage für Brust/Rücken, Schultern/Arme, Beine und Rumpf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez des jours pectoraux/dos, épaules/bras, jambes et gainage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छाती/पीठ, कंधे/बाहें, पैर और कोर वाले दिनों को जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina giorni petto/schiena, spalle/braccia, gambe e core."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "胸/背中、肩/腕、脚、体幹の日を組み合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가슴/등, 어깨/팔, 하체, 코어 날을 짝지어 구성합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Combineer dagen voor borst/rug, schouders/armen, benen en core."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącz dni klatka/plecy, barki/ramiona, nogi i core."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine dias de peito/costas, ombros/braços, pernas e core."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Combină zile pentru piept/spate, umeri/brațe, picioare și trunchi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетайте дни грудь/спина, плечи/руки, ноги и кор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göğüs/sırt, omuz/kol, bacak ve core günlerini eşleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поєднуйте дні груди/спина, плечі/руки, ноги та кор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搭配胸/背、肩/臂、腿和核心训练日。"
          }
        }
      }
    },
    "Pair opposing muscle groups for balanced sessions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina grupos musculares opuestos para sesiones equilibradas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجمع بين مجموعات العضلات المتقابلة لجلسات متوازنة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanslı məşqlər üçün əks əzələ qruplarını cütləşdirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojuj protilehlé svalové skupiny pro vyvážené tréninky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombiniere gegenspielende Muskelgruppen für ausgewogene Einheiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez des groupes musculaires opposés pour des séances équilibrées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संतुलित सत्रों के लिए विपरीत मांसपेशी समूहों को जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbina gruppi muscolari opposti per sessioni equilibrate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拮抗する筋群を組み合わせて、バランスの良いセッションにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "균형 잡힌 세션을 위해 반대 근육군을 짝지어 운동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Combineer tegengestelde spiergroepen voor evenwichtige sessies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącz przeciwstawne grupy mięśni, aby sesje były zrównoważone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine grupos musculares opostos para sessões equilibradas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Combină grupe musculare opuse pentru sesiuni echilibrate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетайте мышцы-антагонисты для сбалансированных тренировок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengeli antrenmanlar için karşıt kas gruplarını eşleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поєднуйте м’язи-антагоністи для збалансованих тренувань."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搭配相对肌群，让训练更均衡。"
          }
        }
      }
    },
