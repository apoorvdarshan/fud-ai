    "Get help, share ideas and meet other Fud AI users on Discord.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على المساعدة وشارك أفكارك وتعرّف على مستخدمي Fud AI الآخرين على Discord."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord-da kömək alın, ideyalarınızı bölüşün və digər Fud AI istifadəçiləri ilə tanış olun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Discordu získáš pomoc, sdílíš nápady a potkáš další uživatele Fud AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir Hilfe, teile Ideen und triff andere Fud AI-Nutzer auf Discord."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get help, share ideas and meet other Fud AI users on Discord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide ayuda, comparte ideas y conoce a otros usuarios de Fud AI en Discord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez de l’aide, partagez vos idées et rencontrez d’autres utilisateurs de Fud AI sur Discord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord पर मदद पाएँ, अपने विचार साझा करें और Fud AI के दूसरे उपयोगकर्ताओं से मिलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi aiuto, condividi idee e conosci altri utenti di Fud AI su Discord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Discordで質問したり、アイデアを共有したり、ほかのFud AIユーザーと交流したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord에서 도움을 받고, 아이디어를 나누고, 다른 Fud AI 사용자들을 만나 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg hulp, deel ideeën en ontmoet andere Fud AI-gebruikers op Discord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzyskaj pomoc, dziel się pomysłami i poznaj innych użytkowników Fud AI na Discordzie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça ajuda, compartilhe ideias e conheça outros usuários do Fud AI no Discord."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primește ajutor, împărtășește idei și cunoaște alți utilizatori Fud AI pe Discord."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте помощь, делитесь идеями и общайтесь с другими пользователями Fud AI в Discord."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord’da yardım alın, fikirlerinizi paylaşın ve diğer Fud AI kullanıcılarıyla tanışın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте допомогу, діліться ідеями та знайомтеся з іншими користувачами Fud AI у Discord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Discord 上获取帮助、分享想法，认识其他 Fud AI 用户。"
          }
        }
      }
    },
