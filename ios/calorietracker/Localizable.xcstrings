    "Hosted AI could not identify your subscription. Try Restore Purchases.": {
      "comment": "Hosted AI error when the subscription can't be verified. Restore Purchases is the button name in the paywall.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على الذكاء الاصطناعي المستضاف التعرّف على اشتراكك. جرّب استعادة المشتريات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Host edilmiş AI abunəliyinizi müəyyən edə bilmədi. Alışları Bərpa Et seçimini sınayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostovaná AI nemohla rozpoznat tvé předplatné. Zkus Obnovit nákupy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gehostete KI konnte dein Abo nicht zuordnen. Tippe auf „Käufe wiederherstellen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA alojada no pudo identificar tu suscripción. Prueba Restaurar compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA hébergée n’a pas pu identifier ton abonnement. Essaie Restaurer les achats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्टेड AI आपकी सदस्यता की पहचान नहीं कर सका। खरीदारी पुनर्स्थापित करें आज़माएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA ospitata non è riuscita a identificare il tuo abbonamento. Prova Ripristina acquisti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト型AIがサブスクリプションを確認できませんでした。「購入を復元」をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스팅 AI가 구독을 확인하지 못했습니다. 구입 내역 복원을 시도해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
