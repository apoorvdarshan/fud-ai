    "Get gentle reminders at meal times\nso you never forget to track.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe recordatorios amables a la hora de comer\npara que nunca olvides registrar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi promemoria discreti agli orari dei pasti\nper non dimenticare di registrarli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj delikatne przypomnienia w porach posiłków,\naby nie zapomnieć o śledzeniu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте мягкие напоминания во время еды,\nчтобы не забыть сделать запись."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте м’які нагадування під час їжі,\nщоб ніколи не забувати робити записи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostávej jemná připomenutí v časech jídla,\nať nikdy nezapomeneš zapisovat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğün saatlerinde nazik hatırlatmalar alın,\nböylece kayıt tutmayı hiç unutmayın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على تذكيرات لطيفة في أوقات الوجبات\nحتى لا تنسى التتبع أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yemək vaxtlarında yumşaq xatırlatmalar alın\nki, izləməyi unutmayasınız."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte sanfte Erinnerungen zu den Mahlzeiten,\ndamit du nie vergisst, zu tracken."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez de doux rappels aux heures des repas\npour ne jamais oublier de suivre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भोजन के समय हल्की याद दिलावटें पाएँ\nताकि आप ट्रैक करना न भूलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事の時間に優しくリマインドして\n記録を忘れないようサポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식사 시간에 부드러운 알림을 받아\n기록을 잊지 마세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krijg vriendelijke herinneringen op maaltijden\nzodat je nooit vergeet bij te houden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes leves nos horários das refeições\npara você nunca esquecer de registrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primește mementouri blânde la orele meselor\nca să nu uiți să urmărești."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在用餐时间获得温和提醒，\n让你不会忘记记录。"
          }
        }
      }
    },
    "Get notified when a new version is available. Tap the notification to open the App Store.": {
      "comment": "A footer for the notification settings.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على إشعار عند توفر إصدار جديد. اضغط على الإشعار لفتح App Store."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni versiya mövcud olduqda bildiriş alın. App Store-u açmaq üçün bildirişə toxunun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Mitteilung, wenn eine neue Version verfügbar ist. Tippe auf die Mitteilung, um den App Store zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una notificación cuando haya una nueva versión disponible. Toca la notificación para abrir el App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez une notification quand une nouvelle version est disponible. Touchez la notification pour ouvrir l'App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया वर्ज़न उपलब्ध होने पर सूचना पाएँ। App Store खोलने के लिए सूचना पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica quando è disponibile una nuova versione. Tocca la notifica per aprire l'App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンが利用可能になったら通知を受け取れます。通知をタップするとApp Storeが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 버전이 나오면 알림을 받으세요. 알림을 탭하면 App Store가 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvang een melding wanneer er een nieuwe versie beschikbaar is. Tik op de melding om de App Store te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj powiadomienia o nowej wersji. Stuknij powiadomienie, aby otworzyć App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba uma notificação quando uma nova versão estiver disponível. Toque na notificação para abrir a App Store."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primește o notificare când este disponibilă o versiune nouă. Atinge notificarea pentru a deschide App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте уведомление о выходе новой версии. Нажмите на уведомление, чтобы открыть App Store."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте сповіщення про вихід нової версії. Торкніться сповіщення, щоб відкрити App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新版本时接收通知。点按通知即可打开 App Store。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostaneš oznámení, když bude k dispozici nová verze. Klepnutím na oznámení otevřeš App Store."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir sürüm çıktığında bildirim alın. App Store’u açmak için bildirime dokunun."
          }
        }
      }
    },
