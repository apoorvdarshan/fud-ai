    "Keep the camera fully covered and reduce pressure or movement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ الكاميرا مغطاة بالكامل وقلّل الضغط أو الحركة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameranı tam örtülü saxlayın, təzyiqi və ya hərəkəti azaldın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte die Kamera vollständig bedeckt und verringere Druck oder Bewegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the camera fully covered and reduce pressure or movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén la cámara completamente cubierta y reduce la presión o el movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la caméra entièrement couverte et réduisez la pression ou les mouvements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे को पूरी तरह ढका रखें और दबाव या हलचल कम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la fotocamera completamente coperta e riduci la pressione o il movimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを完全に覆ったまま、力や動きを弱めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 완전히 가린 채 압력이나 움직임을 줄이세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de camera volledig bedekt en verminder de druk of beweging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzymaj aparat całkowicie zakryty i zmniejsz nacisk lub ruch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a câmera totalmente coberta e reduza a pressão ou o movimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ține camera complet acoperită și redu presiunea sau mișcarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью закройте камеру и уменьшите давление или движение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью закройте камеру и уменьшите давление или движение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持相机完全被遮住，并减轻按压力度或减少移动。"
          }
        }
      }
    },
