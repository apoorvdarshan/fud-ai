          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーが設定されていません。設定 → AIプロバイダ でキーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
