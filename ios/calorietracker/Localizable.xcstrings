    "Adds to your log with the exact nutrients from the sender. No photo is included.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُضاف إلى سجلك بنفس القيم الغذائية الدقيقة من المُرسِل. لا تُدرَج أي صورة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndərənin dəqiq qida dəyərləri ilə jurnalınıza əlavə olunur. Şəkil daxil edilmir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird mit den exakten Nährwerten des Absenders zu deinem Protokoll hinzugefügt. Kein Foto enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds to your log with the exact nutrients from the sender. No photo is included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añade a tu registro con los nutrientes exactos del remitente. No se incluye ninguna foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'ajoute à votre journal avec les nutriments exacts de l'expéditeur. Aucune photo n'est incluse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने वाले के सटीक पोषक तत्वों के साथ आपके लॉग में जुड़ जाता है। कोई फ़ोटो शामिल नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene aggiunto al tuo diario con i valori nutrizionali esatti del mittente. Nessuna foto inclusa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信者の正確な栄養価とともにログに追加されます。写真は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낸 사람의 정확한 영양소와 함께 기록에 추가됩니다. 사진은 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt met de exacte voedingswaarden van de afzender aan je logboek toegevoegd. Geen foto inbegrepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje się do dziennika z dokładnymi wartościami odżywczymi od nadawcy. Bez zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona ao seu registro com os nutrientes exatos do remetente. Nenhuma foto é incluída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adaugă în jurnalul tău cu nutrienții exacți de la expeditor. Nicio fotografie nu este inclusă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляется в журнал с точными нутриентами от отправителя. Фото не включается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає до вашого журналу з точними нутрієнтами від відправника. Фотографія не включається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以发送者提供的精确营养成分添加到你的记录中。不包含照片。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá se do tvého deníku s přesnými nutričními hodnotami od odesílatele. Fotka není součástí."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderenin öğündeki besin değerleriyle birlikte günlüğünüze eklenir. Fotoğraf eklenmez."
          }
        }
      }
    },
