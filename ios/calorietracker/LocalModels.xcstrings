    "gemma.deleteMessage": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة النموذج الذي تم تنزيله وذاكرة التخزين المؤقت المترجمة الخاصة به من هذا الـ iPhone. يمكنك تنزيله مرة أخرى لاحقًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Endirilmiş model və onun tərtib edilmiş keş yaddaşı bu iPhone-dan silinəcək. Onu daha sonra yenidən endirə bilərsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heruntergeladene Modell und sein kompilierter Cache werden von diesem iPhone entfernt. Du kannst es später erneut herunterladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded model and its compiled cache will be removed from this iPhone. You can download it again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo descargado y su caché compilada se eliminarán de este iPhone. Puedes volver a descargarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle téléchargé et son cache compilé seront supprimés de cet iPhone. Vous pourrez le télécharger à nouveau plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड किया गया मॉडल और उसका कंपाइल किया हुआ कैश इस iPhone से हटा दिया जाएगा। आप इसे बाद में फिर से डाउनलोड कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello scaricato e la relativa cache compilata verranno rimossi da questo iPhone. Potrai scaricarlo di nuovo in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたモデルとコンパイル済みキャッシュがこの iPhone から削除されます。後でもう一度ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 모델과 컴파일된 캐시가 이 iPhone에서 삭제됩니다. 나중에 다시 다운로드할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gedownloade model en de gecompileerde cache worden van deze iPhone verwijderd. Je kunt het later opnieuw downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrany model i jego skompilowana pamięć podręczna zostaną usunięte z tego iPhone’a. Możesz pobrać go ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo baixado e o cache compilado serão removidos deste iPhone. Você poderá baixá-lo novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul descărcat și memoria cache compilată vor fi eliminate de pe acest iPhone. Îl puteți descărca din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженная модель и её скомпилированный кэш будут удалены с этого iPhone. Позже модель можно будет загрузить снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаженная модель и её скомпільований кеш будут видалені з цього iPhone. Позже модель можно будет загрузить снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的模型及其编译缓存将从此 iPhone 中移除。您稍后可以重新下载。"
          }
        }
      }
    },
    "gemma.requires8GB": {
