    "Try a different muscle, equipment, or search — or reset the filters above.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب عضلة أو معدات أو بحثًا مختلفًا، أو أعد ضبط عوامل التصفية أعلاه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa əzələ, avadanlıq və ya axtarış sınayın, ya da yuxarıdakı filtrləri sıfırlayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche einen anderen Muskel, anderes Equipment oder eine andere Suche – oder setze die Filter oben zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otro músculo, equipamiento o búsqueda, o restablece los filtros de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un autre muscle, un autre équipement ou une autre recherche, ou réinitialisez les filtres ci-dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरी मांसपेशी, उपकरण या खोज आज़माएँ — या ऊपर दिए गए फ़िल्टर रीसेट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova con un altro muscolo, attrezzatura o ricerca, oppure reimposta i filtri qui sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の筋肉・器具・検索条件を試すか、上のフィルターをリセットしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 근육, 기구 또는 검색어를 시도하거나 위의 필터를 초기화해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een andere spier, ander materiaal of een andere zoekopdracht – of reset de filters hierboven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypróbuj inny mięsień, sprzęt lub wyszukiwanie albo zresetuj powyższe filtry."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outro músculo, equipamento ou busca — ou redefina os filtros acima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă alt mușchi, alt echipament sau altă căutare — sau resetează filtrele de mai sus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другую мышцу, инвентарь или запрос — либо сбросьте фильтры выше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте інший м’яз, обладнання або пошуковий запит — чи скиньте фільтри вище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试其他肌肉、器械或搜索词，或重置上方的筛选条件。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkus jiný sval, vybavení nebo hledaný výraz — nebo resetuj filtry výše."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı bir kas veya ekipman seçin ya da başka bir arama yapın; isterseniz yukarıdaki filtreleri sıfırlayın."
          }
        }
      }
    },
