    "Reprocess a logged meal with AI — adjust its name, serving, or note and re-analyze.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد معالجة وجبة مسجلة بالذكاء الاصطناعي — عدّل الاسم أو الكمية أو الملاحظة ثم أعد التحليل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeyd olunmuş yeməyi Sİ ilə yenidən emal edin — adı, porsiyanı və ya qeydi dəyişib yenidən analiz edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verarbeite eine geloggte Mahlzeit neu mit KI — passe Name, Portion oder Notiz an und analysiere erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprocesa una comida registrada con IA: ajusta el nombre, la porción o la nota y vuelve a analizarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retraitez un repas enregistré avec l'IA — ajustez le nom, la portion ou la note, puis relancez l'analyse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉग किए भोजन को AI से दोबारा प्रोसेस करें — नाम, मात्रा या नोट बदलकर फिर से विश्लेषण करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rielabora un pasto registrato con l'AI — modifica nome, porzione o nota e rianalizza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録済みの食事をAIで再解析 — 名前・分量・メモを調整して再分析できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 식사를 AI로 다시 분석 — 이름, 양, 메모를 조정한 뒤 재분석할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwerk een gelogde maaltijd opnieuw met AI — pas naam, portie of notitie aan en analyseer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przetwórz ponownie zapisany posiłek z AI — zmień nazwę, porcję lub notatkę i przeanalizuj od nowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprocesse uma refeição registrada com IA — ajuste o nome, a porção ou a nota e analise de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprocesează o masă înregistrată cu AI — ajustează numele, porția sau nota și analizează din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переобработайте записанный приём пищи с ИИ — измените название, порцию или заметку и проанализируйте заново."
          }
        },
        "uk": {
          "stringUnit": {
