    "Fud AI sends one short request to %@ to check that the key, the model and the endpoint work together. It uses one request from your provider account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI sendet eine kurze Anfrage an %@, um zu prüfen, ob Schlüssel, Modell und Endpunkt zusammenpassen. Das kostet eine Anfrage auf deinem Anbieter-Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI sends one short request to %@ to check that the key, the model and the endpoint work together. It uses one request from your provider account."
          }
        }
      }
    },
