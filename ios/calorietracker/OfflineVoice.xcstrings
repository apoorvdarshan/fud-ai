{
  "sourceLanguage": "en",
  "strings": {
    "Allow microphone access in Settings.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "اسمح بالوصول إلى الميكروفون في الإعدادات."}},
        "az": {"stringUnit": {"state": "translated", "value": "Ayarlarda mikrofona girişə icazə verin."}},
        "cs": {"stringUnit": {"state": "translated", "value": "Povolte přístup k mikrofonu v Nastavení."}},
        "de": {"stringUnit": {"state": "translated", "value": "Erlaube den Mikrofonzugriff in den Einstellungen."}},
        "es": {"stringUnit": {"state": "translated", "value": "Permite el acceso al micrófono en Ajustes."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Autorisez l’accès au microphone dans Réglages."}},
        "hi": {"stringUnit": {"state": "translated", "value": "सेटिंग्स में माइक्रोफ़ोन की अनुमति दें।"}},
        "it": {"stringUnit": {"state": "translated", "value": "Consenti l’accesso al microfono nelle impostazioni."}},
        "ja": {"stringUnit": {"state": "translated", "value": "設定でマイクへのアクセスを許可してください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "설정에서 마이크 접근을 허용하세요."}},
        "nl": {"stringUnit": {"state": "translated", "value": "Sta microfoontoegang toe in Instellingen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zezwól na dostęp do mikrofonu w Ustawieniach."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Permita o acesso ao microfone nos Ajustes."}},
        "ro": {"stringUnit": {"state": "translated", "value": "Permite accesul la microfon în Configurări."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Разрешите доступ к микрофону в настройках."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ayarlardan mikrofon erişimine izin verin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Дозвольте доступ до мікрофона в Налаштуваннях."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "请在设置中允许访问麦克风。"}}
      }
    },
    "Couldn’t capture audio. Try speaking for at least one second.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "تعذّر تسجيل الصوت. حاول التحدث لمدة ثانية واحدة على الأقل."}},
        "az": {"stringUnit": {"state": "translated", "value": "Səsi yazmaq olmadı. Ən azı bir saniyə danışmağa çalışın."}},
        "cs": {"stringUnit": {"state": "translated", "value": "Nepodařilo se nahrát zvuk. Zkuste mluvit alespoň jednu sekundu."}},
        "de": {"stringUnit": {"state": "translated", "value": "Audio konnte nicht aufgenommen werden. Sprich mindestens eine Sekunde lang."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo grabar el audio. Intenta hablar al menos un segundo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "L’enregistrement a échoué. Essayez de parler pendant au moins une seconde."}},
        "hi": {"stringUnit": {"state": "translated", "value": "आवाज़ रिकॉर्ड नहीं हो सकी। कम से कम एक सेकंड बोलकर देखें।"}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile registrare l’audio. Prova a parlare per almeno un secondo."}},
        "ja": {"stringUnit": {"state": "translated", "value": "録音できませんでした。1秒以上話してみてください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "녹음하지 못했습니다. 1초 이상 말해 보세요."}},
        "nl": {"stringUnit": {"state": "translated", "value": "Opnemen is niet gelukt. Probeer minimaal één seconde te spreken."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się nagrać dźwięku. Spróbuj mówić przez co najmniej sekundę."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível gravar o áudio. Tente falar por pelo menos um segundo."}},
        "ro": {"stringUnit": {"state": "translated", "value": "Nu s-a putut înregistra sunetul. Încearcă să vorbești cel puțin o secundă."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось записать звук. Попробуйте говорить не менее одной секунды."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ses kaydedilemedi. En az bir saniye konuşmayı deneyin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Не вдалося записати звук. Спробуйте говорити щонайменше секунду."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法录制音频，请尝试至少说一秒。"}}
      }
    },
    "Couldn’t generate or play a spoken reply.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "تعذّر إنشاء رد صوتي أو تشغيله."}},
        "az": {"stringUnit": {"state": "translated", "value": "Səsli cavabı yaratmaq və ya səsləndirmək olmadı."}},
        "cs": {"stringUnit": {"state": "translated", "value": "Nepodařilo se vytvořit nebo přehrát hlasovou odpověď."}},
        "de": {"stringUnit": {"state": "translated", "value": "Die Sprachantwort konnte nicht erstellt oder abgespielt werden."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se pudo generar o reproducir una respuesta de voz."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Impossible de générer ou de lire une réponse vocale."}},
        "hi": {"stringUnit": {"state": "translated", "value": "आवाज़ में जवाब तैयार या चलाया नहीं जा सका।"}},
        "it": {"stringUnit": {"state": "translated", "value": "Impossibile generare o riprodurre una risposta vocale."}},
        "ja": {"stringUnit": {"state": "translated", "value": "音声での返答を作成または再生できませんでした。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "음성 답변을 생성하거나 재생하지 못했습니다."}},
        "nl": {"stringUnit": {"state": "translated", "value": "Kon geen gesproken antwoord maken of afspelen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się utworzyć lub odtworzyć odpowiedzi głosowej."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Não foi possível gerar ou reproduzir uma resposta falada."}},
        "ro": {"stringUnit": {"state": "translated", "value": "Nu s-a putut genera sau reda un răspuns vocal."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Не удалось создать или воспроизвести голосовой ответ."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Sesli yanıt oluşturulamadı veya oynatılamadı."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Не вдалося створити або відтворити голосову відповідь."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无法生成或播放语音回复。"}}
      }
    },
    "Download LFM3 to use local voice.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "نزّل LFM3 لاستخدام الصوت المحلي."}},
        "az": {"stringUnit": {"state": "translated", "value": "Yerli səsdən istifadə etmək üçün LFM3-ü endirin."}},
        "cs": {"stringUnit": {"state": "translated", "value": "Pro místní hlas stáhněte LFM3."}},
        "de": {"stringUnit": {"state": "translated", "value": "Lade LFM3 herunter, um die lokale Stimme zu nutzen."}},
        "es": {"stringUnit": {"state": "translated", "value": "Descarga LFM3 para usar la voz local."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Téléchargez LFM3 pour utiliser la voix locale."}},
        "hi": {"stringUnit": {"state": "translated", "value": "स्थानीय आवाज़ के लिए LFM3 डाउनलोड करें।"}},
        "it": {"stringUnit": {"state": "translated", "value": "Scarica LFM3 per usare la voce locale."}},
        "ja": {"stringUnit": {"state": "translated", "value": "ローカル音声を使うにはLFM3をダウンロードしてください。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "로컬 음성을 쓰려면 LFM3를 다운로드하세요."}},
        "nl": {"stringUnit": {"state": "translated", "value": "Download LFM3 om de lokale stem te gebruiken."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Pobierz LFM3, aby używać lokalnego głosu."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Baixe o LFM3 para usar a voz local."}},
        "ro": {"stringUnit": {"state": "translated", "value": "Descarcă LFM3 pentru a folosi vocea locală."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Загрузите LFM3, чтобы использовать локальный голос."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Yerel ses için LFM3’ü indirin."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Завантажте LFM3, щоб використовувати локальний голос."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "下载 LFM3 以使用本地语音。"}}
      }
    },
    "English only, one turn at a time. This preview does not use diary tools or the cloud.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "الإنجليزية فقط، جولة واحدة في كل مرة. لا تستخدم المعاينة أدوات اليوميات أو الخدمات السحابية."}},
        "az": {"stringUnit": {"state": "translated", "value": "Yalnız ingiliscə, bir dəfəyə bir sual və cavab. Bu önizləmə gündəlik alətlərindən və buluddan istifadə etmir."}},
        "cs": {"stringUnit": {"state": "translated", "value": "Pouze anglicky, vždy jedna otázka a odpověď. Tato ukázka nepoužívá nástroje deníku ani cloud."}},
        "de": {"stringUnit": {"state": "translated", "value": "Nur Englisch, jeweils eine Frage und Antwort. Diese Vorschau verwendet weder Tagebuchwerkzeuge noch die Cloud."}},
        "es": {"stringUnit": {"state": "translated", "value": "Solo en inglés, un turno a la vez. Esta vista previa no usa las herramientas del diario ni la nube."}},
        "fr": {"stringUnit": {"state": "translated", "value": "En anglais uniquement, un échange à la fois. Cet aperçu n’utilise ni les outils du journal ni le cloud."}},
        "hi": {"stringUnit": {"state": "translated", "value": "सिर्फ़ अंग्रेज़ी में, एक बार में एक सवाल और जवाब। यह झलक डायरी टूल या क्लाउड का इस्तेमाल नहीं करती।"}},
        "it": {"stringUnit": {"state": "translated", "value": "Solo in inglese, un turno alla volta. Questa anteprima non usa gli strumenti del diario né il cloud."}},
        "ja": {"stringUnit": {"state": "translated", "value": "英語のみ、1回につき1往復。このプレビューは日記ツールやクラウドを使用しません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "영어로만 한 번씩 질문하고 답합니다. 이 미리보기는 일기 도구나 클라우드를 사용하지 않습니다."}},
        "nl": {"stringUnit": {"state": "translated", "value": "Alleen Engels, één vraag en antwoord per keer. Dit voorbeeld gebruikt geen dagboektools of cloud."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Tylko po angielsku, po jednym pytaniu i odpowiedzi. Ten podgląd nie korzysta z narzędzi dziennika ani chmury."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Somente em inglês, um turno por vez. Esta prévia não usa as ferramentas do diário nem a nuvem."}},
        "ro": {"stringUnit": {"state": "translated", "value": "Doar în engleză, câte o întrebare și un răspuns. Această previzualizare nu utilizează instrumentele jurnalului sau cloudul."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Только на английском, один вопрос и ответ за раз. В этом режиме предпросмотра инструменты дневника и облако не используются."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Yalnızca İngilizce, her seferinde bir soru ve yanıt. Bu önizleme günlük araçlarını veya bulutu kullanmaz."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Лише англійською, одне запитання й відповідь за раз. Цей попередній перегляд не використовує інструменти щоденника або хмару."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "仅支持英语，每次一问一答。此预览不会使用日记工具或云端。"}}
      }
    },
    "English voice with on-device diary tools. No network tools.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "صوت بالإنجليزية مع أدوات يوميات على الجهاز. لا أدوات عبر الشبكة."}},
        "az": {"stringUnit": {"state": "translated", "value": "İngilis dilində səs və cihazdakı gündəlik alətləri. Şəbəkə alətləri yoxdur."}},
        "cs": {"stringUnit": {"state": "translated", "value": "Hlas v angličtině s nástroji deníku v zařízení. Bez síťových nástrojů."}},
        "de": {"stringUnit": {"state": "translated", "value": "Englische Stimme mit lokalen Tagebuchwerkzeugen. Keine Netzwerkwerkzeuge."}},
        "es": {"stringUnit": {"state": "translated", "value": "Voz en inglés con herramientas del diario en el dispositivo. Sin herramientas de red."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Voix en anglais avec les outils du journal sur cet appareil. Aucun outil réseau."}},
        "hi": {"stringUnit": {"state": "translated", "value": "अंग्रेज़ी आवाज़ और डिवाइस पर मौजूद डायरी टूल। कोई नेटवर्क टूल नहीं।"}},
        "it": {"stringUnit": {"state": "translated", "value": "Voce inglese con strumenti del diario sul dispositivo. Nessuno strumento di rete."}},
        "ja": {"stringUnit": {"state": "translated", "value": "英語音声と端末内の日記ツール。ネットワークを使うツールはありません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "영어 음성 및 기기 내 일기 도구. 네트워크 도구는 사용하지 않습니다."}},
        "nl": {"stringUnit": {"state": "translated", "value": "Engelse stem met dagboektools op dit apparaat. Geen netwerktools."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Angielski głos i narzędzia dziennika na urządzeniu. Bez narzędzi sieciowych."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Voz em inglês com ferramentas do diário no dispositivo. Sem ferramentas de rede."}},
        "ro": {"stringUnit": {"state": "translated", "value": "Voce în engleză cu instrumentele jurnalului pe dispozitiv. Fără instrumente de rețea."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Английский голос и инструменты дневника на устройстве. Без сетевых инструментов."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Cihazdaki günlük araçlarıyla İngilizce ses. Ağ kullanan araç yok."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Англійський голос і інструменти щоденника на пристрої. Без мережевих інструментів."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "英语语音和设备上的日记工具。不使用联网工具。"}}
      }
    },
    "Local voice + connected tools": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "الصوت المحلي + الأدوات المتصلة"}},
        "az": {"stringUnit": {"state": "translated", "value": "Yerli səs + qoşulmuş alətlər"}},
        "cs": {"stringUnit": {"state": "translated", "value": "Místní hlas + připojené nástroje"}},
        "de": {"stringUnit": {"state": "translated", "value": "Lokale Stimme + verbundene Werkzeuge"}},
        "es": {"stringUnit": {"state": "translated", "value": "Voz local + herramientas conectadas"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Voix locale + outils connectés"}},
        "hi": {"stringUnit": {"state": "translated", "value": "स्थानीय आवाज़ + कनेक्ट किए गए टूल"}},
        "it": {"stringUnit": {"state": "translated", "value": "Voce locale + strumenti connessi"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ローカル音声＋接続ツール"}},
        "ko": {"stringUnit": {"state": "translated", "value": "로컬 음성 + 연결된 도구"}},
        "nl": {"stringUnit": {"state": "translated", "value": "Lokale stem + gekoppelde tools"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Głos lokalny + połączone narzędzia"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Voz local + ferramentas conectadas"}},
        "ro": {"stringUnit": {"state": "translated", "value": "Voce locală + instrumente conectate"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Локальный голос + подключённые инструменты"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Yerel ses + bağlı araçlar"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Локальний голос + підключені інструменти"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "本地语音＋联网工具"}}
      }
    },
    "Manage LFM3 download": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "إدارة تنزيل LFM3"}},
        "az": {"stringUnit": {"state": "translated", "value": "LFM3 endirməsini idarə et"}},
        "cs": {"stringUnit": {"state": "translated", "value": "Spravovat stažení LFM3"}},
        "de": {"stringUnit": {"state": "translated", "value": "LFM3-Download verwalten"}},
        "es": {"stringUnit": {"state": "translated", "value": "Gestionar la descarga de LFM3"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gérer le téléchargement de LFM3"}},
        "hi": {"stringUnit": {"state": "translated", "value": "LFM3 डाउनलोड प्रबंधित करें"}},
        "it": {"stringUnit": {"state": "translated", "value": "Gestisci il download di LFM3"}},
        "ja": {"stringUnit": {"state": "translated", "value": "LFM3のダウンロードを管理"}},
        "ko": {"stringUnit": {"state": "translated", "value": "LFM3 다운로드 관리"}},
        "nl": {"stringUnit": {"state": "translated", "value": "LFM3-download beheren"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zarządzaj pobieraniem LFM3"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Gerenciar o download do LFM3"}},
        "ro": {"stringUnit": {"state": "translated", "value": "Gestionează descărcarea LFM3"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Управление загрузкой LFM3"}},
        "tr": {"stringUnit": {"state": "translated", "value": "LFM3 indirmesini yönet"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Керувати завантаженням LFM3"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "管理 LFM3 下载"}}
      }
    },
    "Offer cloud voice fallback": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "عرض خيار الصوت السحابي عند التعذر"}},
        "az": {"stringUnit": {"state": "translated", "value": "Bulud səsi seçimini təklif et"}},
        "cs": {"stringUnit": {"state": "translated", "value": "Nabízet cloudový hlas jako náhradu"}},
        "de": {"stringUnit": {"state": "translated", "value": "Cloud-Stimme als Alternative anbieten"}},
        "es": {"stringUnit": {"state": "translated", "value": "Ofrecer voz en la nube como alternativa"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Proposer la voix dans le cloud en secours"}},
        "hi": {"stringUnit": {"state": "translated", "value": "ज़रूरत पड़ने पर क्लाउड आवाज़ का विकल्प दिखाएँ"}},
        "it": {"stringUnit": {"state": "translated", "value": "Offri la voce cloud come alternativa"}},
        "ja": {"stringUnit": {"state": "translated", "value": "クラウド音声を代替として表示"}},
        "ko": {"stringUnit": {"state": "translated", "value": "대안으로 클라우드 음성 표시"}},
        "nl": {"stringUnit": {"state": "translated", "value": "Cloudspraak als alternatief aanbieden"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Oferuj głos w chmurze jako alternatywę"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Oferecer voz na nuvem como alternativa"}},
        "ro": {"stringUnit": {"state": "translated", "value": "Oferă voce în cloud ca alternativă"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Предлагать облачный голос как запасной вариант"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Alternatif olarak bulut sesini öner"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Пропонувати хмарний голос як запасний варіант"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "提供云端语音作为备选"}}
      }
    },
    "Offline Voice": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "الصوت بلا إنترنت"}},
        "az": {"stringUnit": {"state": "translated", "value": "Oflayn səs"}},
        "cs": {"stringUnit": {"state": "translated", "value": "Hlas offline"}},
        "de": {"stringUnit": {"state": "translated", "value": "Offline-Stimme"}},
        "es": {"stringUnit": {"state": "translated", "value": "Voz sin conexión"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Voix hors ligne"}},
