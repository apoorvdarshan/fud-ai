    "gemma.downloading": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ تنزيل نموذج Gemma 4 المثبّت الإصدار… أبقِ Fud AI مفتوحًا حتى يكتمل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlənmiş Gemma 4 modeli endirilir… Tamamlanana qədər Fud AI-ni açıq saxlayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das festgelegte Gemma-4-Modell wird heruntergeladen… Lass Fud AI geöffnet, bis der Download abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading the pinned Gemma 4 model… Keep Fud AI open until it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargando el modelo fijado de Gemma 4… Mantén Fud AI abierto hasta que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement de la version épinglée du modèle Gemma 4… Gardez Fud AI ouvert jusqu’à la fin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किया गया Gemma 4 मॉडल डाउनलोड हो रहा है… पूरा होने तक Fud AI खुला रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download della versione fissata del modello Gemma 4… Mantieni Fud AI aperto fino al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定バージョンの Gemma 4 モデルをダウンロード中… 完了するまで Fud AI を開いたままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 버전의 Gemma 4 모델을 다운로드하는 중… 완료될 때까지 Fud AI를 열어 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vastgezette versie van het Gemma 4-model wordt gedownload… Houd Fud AI open totdat dit is voltooid."
          }
        },
        "pl": {
