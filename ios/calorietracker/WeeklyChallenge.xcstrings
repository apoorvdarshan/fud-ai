    "Calculated locally. No raw food, water, workout, Health, body-weight, or weight-loss data is uploaded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحسب محليًا. لا تُرفع أي بيانات خام عن الطعام أو الماء أو التمارين أو الصحة أو وزن الجسم أو فقدان الوزن."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerli olaraq hesablanır. Heç bir xam qida, su, məşq, sağlamlıq, bədən çəkisi və ya arıqlama məlumatı yüklənmir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird lokal berechnet. Es werden keine Rohdaten zu Essen, Wasser, Training, Gesundheit, Körpergewicht oder Gewichtsverlust hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculated locally. No raw food, water, workout, Health, body-weight, or weight-loss data is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se calcula en tu dispositivo. No se sube ningún dato sin procesar de comida, agua, entrenamientos, Salud, peso corporal ni pérdida de peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé localement. Aucune donnée brute sur l’alimentation, l’eau, les entraînements, la santé, le poids ou la perte de poids n’est envoyée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय रूप से गणना की जाती है। भोजन, पानी, वर्कआउट, Health, शरीर के वज़न या वज़न घटने का कोई कच्चा डेटा अपलोड नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcolato in locale. Non viene caricato alcun dato grezzo su cibo, acqua, allenamenti, Salute, peso corporeo o perdita di peso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルで計算されます。食事、水分、ワークアウト、ヘルスケア、体重、減量の生データはアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 계산됩니다. 음식, 물, 운동, 건강, 체중, 감량에 관한 원본 데이터는 업로드되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaal berekend. Er worden geen ruwe gegevens over voeding, water, trainingen, Gezondheid, lichaamsgewicht of gewichtsverlies geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliczane lokalnie. Nie są przesyłane żadne surowe dane o jedzeniu, wodzie, treningach, zdrowiu, masie ciała ani utracie wagi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado localmente. Nenhum dado bruto de alimentação, água, treinos, Saúde, peso corporal ou perda de peso é enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculat local. Nu se încarcă date brute despre mâncare, apă, antrenamente, Sănătate, greutatea corporală sau scăderea în greutate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассчитывается на устройстве. Никакие исходные данные о еде, воде, тренировках, здоровье, весе тела или снижении веса не загружаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розраховується на пристрої. Жодні вихідні дані про їжу, воду, тренування, здоров’я, вагу тіла чи схуднення не завантажуються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本地计算。不会上传任何关于饮食、饮水、训练、健康、体重或减重的原始数据。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel olarak hesaplanır. Ham yiyecek, su, antrenman, Sağlık, vücut ağırlığı veya kilo kaybı verisi yüklenmez."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počítá se lokálně. Nenahrávají se žádná nezpracovaná data o jídle, vodě a trénincích, data z Apple Health, tělesná váha ani údaje o hubnutí."
          }
        }
      }
    },
