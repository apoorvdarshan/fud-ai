    "Camera + Camera keeps both shots, stitched side by side.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كاميرا + كاميرا تحتفظ باللقطتين معًا جنبًا إلى جنب."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera + Kamera hər iki kadrı yan-yana birləşdirilmiş saxlayır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera + Kamera behält beide Aufnahmen, Seite an Seite zusammengefügt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara + Cámara conserva ambas capturas, unidas lado a lado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caméra + Caméra conserve les deux prises, assemblées côte à côte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा + कैमरा दोनों फ़ोटो साथ-साथ जोड़कर रखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotocamera + Fotocamera conserva entrambi gli scatti, uniti fianco a fianco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ＋カメラは2枚の写真を並べて保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 + 카메라가 두 장의 사진을 나란히 이어 붙여 보관합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera + Camera bewaart beide foto's, zij aan zij samengevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat + Aparat zachowuje oba ujęcia, połączone obok siebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Câmera + Câmera mantém as duas fotos, unidas lado a lado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cameră + Cameră păstrează ambele cadre, lipite una lângă alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера + Камера сохраняет оба снимка, соединённые рядом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Функція «Камера + Камера» зберігає обидва знімки, об\\'єднані поруч."
