    "**CR10 0–10:** General effort from rest to maximum.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**CR10 0–10:** esfuerzo general, desde reposo hasta el máximo."
          }
        },
        "tr": {
