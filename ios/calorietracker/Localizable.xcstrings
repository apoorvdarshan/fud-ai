        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스팅 AI를 일시적으로 사용할 수 없습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
