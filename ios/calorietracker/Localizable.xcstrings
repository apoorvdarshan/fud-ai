          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostowane AI nie mogło rozpoznać twojej subskrypcji. Spróbuj opcji Przywróć zakupy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA hospedada não conseguiu identificar sua assinatura. Tente Restaurar Compras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
