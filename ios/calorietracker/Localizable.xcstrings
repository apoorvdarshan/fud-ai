    "Open Food Facts has no nutrition for this product. To forget this label, delete the food logs that used it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر لدى Open Food Facts قيم غذائية لهذا المنتج. لنسيان هذا الملصق، احذف سجلات الطعام التي استخدمته."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts-da bu məhsul üçün qida dəyəri yoxdur. Bu etiketi unutmaq üçün ondan istifadə edən qida qeydlərini silin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts pro tento produkt nemá nutriční hodnoty. Chcete-li tento štítek zapomenout, smažte záznamy jídla, které ho použily."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts hat keine Nährwerte für dieses Produkt. Um diese Angaben zu vergessen, lösche die Einträge, die sie verwendet haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts no tiene información nutricional de este producto. Para olvidar esta etiqueta, elimina los registros de comida que la usaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts n'a pas de valeurs nutritionnelles pour ce produit. Pour oublier cette étiquette, supprimez les entrées de repas qui l'ont utilisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts के पास इस उत्पाद का पोषण डेटा नहीं है। इस लेबल को भुलाने के लिए, इसका इस्तेमाल करने वाले फ़ूड लॉग हटाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts non ha valori nutrizionali per questo prodotto. Per dimenticare questa etichetta, elimina le registrazioni dei pasti che l'hanno usata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Factsにはこの商品の栄養情報がありません。この表示を使わないようにするには、それを使った食事記録を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts에 이 제품의 영양 정보가 없습니다. 이 라벨을 지우려면 이 라벨을 사용한 식사 기록을 삭제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts heeft geen voedingswaarden voor dit product. Verwijder de voedingslogs die dit label gebruikten om het te vergeten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts nie ma wartości odżywczych dla tego produktu. Aby zapomnieć tę etykietę, usuń wpisy jedzenia, które jej użyły."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Open Food Facts não tem informações nutricionais deste produto. Para esquecer este rótulo, exclua os registros de alimentos que o usaram."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts nu are valori nutriționale pentru acest produs. Ca să uiți această etichetă, șterge înregistrările de mâncare care au folosit-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Open Food Facts нет данных о пищевой ценности этого продукта. Чтобы забыть эту этикетку, удалите записи о еде, в которых она использовалась."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts'te bu ürün için besin bilgisi yok. Bu etiketi unutmak için onu kullanan yemek kayıtlarını silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Open Food Facts немає даних про харчову цінність цього продукту. Щоб забути цю етикетку, видаліть записи їжі, у яких її використано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts 没有此产品的营养信息。如需忘记此标签，请删除使用过它的饮食记录。"
          }
        }
      }
    },
