    "Workouts you already logged are kept.": {
      "comment": "Confirmation message before deleting a routine.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى التمارين التي سجّلتها محفوظة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Artıq qeyd etdiyiniz məşqlər saxlanılır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Již zapsané tréninky zůstanou zachovány."
          }
        },
        "de": {
