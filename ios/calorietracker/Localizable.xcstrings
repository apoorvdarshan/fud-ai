    "No favorites yet\nSwipe left on any food to add it": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes favoritos\nDesliza a la izquierda en cualquier alimento para añadirlo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz favori yok\nEklemek için herhangi bir yiyeceği sola kaydırın"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مفضلات بعد\nاسحب يسارًا على أي طعام لإضافته"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ sevimli yoxdur\nƏlavə etmək üçün hər hansı yeməyi sola sürüşdürün"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádná oblíbená\nPřejeď na jídle doleva a přidej ho"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Favoriten\nWische bei einem Lebensmittel nach links, um es hinzuzufügen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun favori pour le moment\nGlissez vers la gauche sur un aliment pour l'ajouter"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई पसंदीदा नहीं\nजोड़ने के लिए किसी भी भोजन पर बाएँ स्वाइप करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun preferito\nScorri a sinistra su un cibo per aggiungerlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りはまだありません\n食事を左にスワイプして追加してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기가 아직 없어요\n음식을 왼쪽으로 스와이프하여 추가하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen favorieten\nVeeg naar links op een gerecht om het toe te voegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak ulubionych\nPrzesuń w lewo na posiłku, aby dodać"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum favorito ainda\nDeslize para a esquerda em qualquer alimento para adicioná-lo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Niciun favorit încă\nGlisează stânga pe orice aliment pentru a-l adăuga"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет избранного\nСмахните влево по любой еде, чтобы добавить"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще немає обраних страв\nПроведіть пальцем ліворуч на будь-якій страві, щоб додати її"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未收藏\n向左滑动任意食物即可添加"
          }
        }
      }
    },
