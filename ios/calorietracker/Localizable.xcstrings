    "Try a different muscle, equipment, or search — or create your own exercise.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otro músculo, equipamiento o búsqueda, o crea tu propio ejercicio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı bir kas, ekipman veya arama terimi deneyin ya da kendi egzersizinizi oluşturun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب عضلة أو معدات أو بحثًا مختلفًا — أو أنشئ تمرينك الخاص."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Başqa əzələ, avadanlıq və ya axtarış sınayın — ya da öz hərəkətinizi yaradın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkus jiný sval, vybavení nebo hledání — nebo si vytvoř vlastní cvik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche einen anderen Muskel, andere Geräte oder eine andere Suche – oder erstelle deine eigene Übung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un autre muscle, un autre équipement ou une autre recherche — ou créez votre propre exercice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दूसरी मांसपेशी, उपकरण या खोज आज़माएं — या अपनी एक्सरसाइज़ बनाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un altro muscolo, un’altra attrezzatura o un’altra ricerca, oppure crea il tuo esercizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の筋肉、器具、検索語を試すか、独自の種目を作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 근육, 장비, 검색어를 시도하거나 직접 운동을 만들어 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer een andere spier, ander materiaal of een andere zoekopdracht — of maak je eigen oefening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj innego mięśnia, sprzętu lub wyszukiwania — albo utwórz własne ćwiczenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outro músculo, equipamento ou busca — ou crie seu próprio exercício."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încearcă alt mușchi, alt echipament sau altă căutare — ori creează-ți propriul exercițiu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другую мышцу, снаряжение или запрос — или создайте своё упражнение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте інший м’яз, обладнання чи запит — або створіть власну вправу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试其他肌肉、器械或搜索词——或者创建你自己的动作。"
          }
        }
      }
    },
