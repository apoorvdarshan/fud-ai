    "Group exercises into push, pull, legs, and core work.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa los ejercicios en empuje, tirón, piernas y core."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جمّع التمارين في دفع وسحب وأرجل وجذع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hərəkətləri itələmə, dartma, ayaqlar və kor işinə qruplaşdırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Seskup cviky na tlaky, tahy, nohy a střed těla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppiere Übungen in Drücken, Ziehen, Beine und Rumpf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupez les exercices en poussée, tirage, jambes et gainage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सरसाइज़ को पुश, पुल, लेग्स और कोर में बाँटें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa gli esercizi in spinta, trazione, gambe e core."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種目をプッシュ、プル、脚、体幹に分けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동을 밀기, 당기기, 하체, 코어로 묶습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Groepeer oefeningen in duwen, trekken, benen en core."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogrupuj ćwiczenia na pchające, ciągnące, nogi i core."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupe os exercícios em empurrar, puxar, pernas e core."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupează exercițiile în împingeri, trageri, picioare și trunchi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Группируйте упражнения на жимовые, тяговые, ноги и кор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersizleri itme, çekme, bacak ve core olarak gruplayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Групуйте вправи на жимові, тягові, ноги та кор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将动作分为推、拉、腿和核心训练。"
          }
        }
      }
    },
