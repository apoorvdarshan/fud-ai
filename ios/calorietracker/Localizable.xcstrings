    "Pick one to three nutrients. Water is shown after them while tracking is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ila üç besin öğesi seçin. Su takibi açıkken su bunların ardından gösterilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من عنصر إلى ثلاثة عناصر غذائية. يظهر الماء بعدها أثناء تفعيل التتبع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Birdən üçə qədər qida maddəsi seçin. İzləmə aktiv olduqda su onlardan sonra göstərilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber jednu až tři živiny. Pokud je sledování zapnuté, za nimi se zobrazí voda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein bis drei Nährstoffe. Wasser wird danach angezeigt, solange die Aufzeichnung aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de uno a tres nutrientes. El agua se muestra después mientras el seguimiento esté activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un à trois nutriments. L’eau s’affiche ensuite tant que le suivi est activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक से तीन पोषक तत्व चुनें। ट्रैकिंग चालू रहने पर उनके बाद पानी दिखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli da uno a tre nutrienti. L’acqua viene mostrata dopo, finché il monitoraggio è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "栄養素を1〜3個選んでください。記録がオンの間は、その後に水分が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영양소를 1~3개 선택하세요. 기록이 켜져 있으면 그 뒤에 물이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies één tot drie voedingsstoffen. Water wordt daarna getoond zolang bijhouden is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz od jednego do trzech składników. Gdy śledzenie jest włączone, po nich pokazuje się woda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha de um a três nutrientes. A água aparece depois deles enquanto o registro estiver ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege între unul și trei nutrienți. Apa apare după ei cât timp urmărirea este activată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите от одного до трёх нутриентов. Пока отслеживание включено, после них отображается вода."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть від одного до трьох нутрієнтів. Поки відстеження ввімкнено, після них відображається вода."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一到三种营养素。开启记录时，饮水会显示在它们之后。"
          }
        }
      }
    },
