        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉग करते समय भोजन की फ़ोटो गैलरी में भी सहेजें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva anche le foto dei pasti nella galleria quando registri"
