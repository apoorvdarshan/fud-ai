    },
    "You're all set. Everything is back where you left it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء جاهز. عادت بياناتك كما تركتها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər şey hazırdır. Hər şey qoyduğunuz kimi geri qayıtdı."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovo. Všechno je zpátky na svém místě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles erledigt. Alles ist wieder da, wo du es gelassen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo listo. Todo está como lo dejaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est prêt. Tout est revenu comme tu l’avais laissé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब तैयार है। सब कुछ वैसे ही वापस आ गया है जैसे आपने छोड़ा था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto pronto. È tutto come l’avevi lasciato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了です。すべて元どおりに戻りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비됐어요. 모든 게 그대로 돌아왔어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles is klaar. Alles staat weer zoals je het achterliet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe. Wszystko wróciło na swoje miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo pronto. Está tudo como você deixou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totul e gata. Totul e așa cum l-ai lăsat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё готово. Всё на своих местах."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey hazır. Her şey bıraktığınız gibi geri geldi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе готово. Усе на своїх місцях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切就绪，所有数据都已恢复原样。"
          }
        }
      }
    },
    "A short setup and you're in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد قصير وتبدأ."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qısa quraşdırma və başlayırsınız."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátké nastavení a můžeš začít."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Einrichtung, dann geht’s los."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una configuración breve y listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courte configuration et c’est parti."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस एक छोटा सेटअप और आप तैयार हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una breve configurazione e ci sei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "簡単な設定をすれば始められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간단한 설정만 마치면 시작할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een korte installatie en je kunt aan de slag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótka konfiguracja i gotowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma configuração rápida e pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O configurare scurtă și ești gata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткая настройка — и можно начинать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa bir kurulum ve hazırsınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротке налаштування — і можна починати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成简短设置即可开始。"
          }
        }
      }
    },
    "Nothing came back this time. Try again or start fresh.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتم استعادة أي شيء هذه المرة. حاول مرة أخرى أو ابدأ من جديد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dəfə heç nə qaytarılmadı. Yenidən cəhd edin və ya sıfırdan başlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tentokrát se nic nevrátilo. Zkus to znovu nebo začni od začátku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesmal kam nichts zurück. Versuch es erneut oder starte neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vez no se recuperó nada. Inténtalo de nuevo o empieza desde cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été récupéré cette fois. Réessaie ou repars de zéro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बार कुछ वापस नहीं आया। फिर से कोशिश करें या नए सिरे से शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa volta non è stato recuperato nulla. Riprova o ricomincia da capo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今回は何も戻せませんでした。もう一度試すか、最初から始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번에는 아무것도 되돌리지 못했어요. 다시 시도하거나 새로 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is deze keer niets teruggekomen. Probeer het nog eens of begin opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tym razem nic nie wróciło. Spróbuj ponownie lub zacznij od nowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada voltou desta vez. Tente de novo ou comece do zero."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De data aceasta nu s-a recuperat nimic. Încearcă din nou sau începe de la zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот раз ничего не вернулось. Попробуйте ещё раз или начните заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sefer hiçbir şey geri gelmedi. Tekrar deneyin veya sıfırdan başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього разу нічого не повернулося. Спробуйте ще раз або почніть заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次没有恢复任何数据。请重试或重新开始。"
          }
        }
      }
    },
