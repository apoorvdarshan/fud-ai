            "state": "translated",
            "value": "Мінімальна рекомендація становить 1200 калорій на день."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最低建议为每天 1,200 卡路里。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimální doporučení je 1 200 kalorií denně."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önerilen günlük minimum miktar 1.200 kaloridir."
          }
        }
      }
    },
    "The most balanced pace, motivating and sustainable.": {
      "localizations": {
        "es": {
