    "No leaderboard results are available yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد مشاركون آخرون في الترتيب بعد. اسحب لأسفل للتحديث."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hələ başqa sıralanmış iştirakçı yoxdur. Yeniləmək üçün aşağı çəkin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine weiteren platzierten Teilnehmenden. Zum Aktualisieren nach unten ziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No leaderboard results are available yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay otros participantes clasificados. Desliza hacia abajo para actualizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun autre participant classé pour le moment. Tirez vers le bas pour actualiser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई अन्य रैंक वाला प्रतिभागी नहीं है। रीफ़्रेश करने के लिए नीचे खींचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora altri partecipanti in classifica. Trascina verso il basso per aggiornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのランク入り参加者はまだいません。下に引いて更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 순위에 오른 다른 참가자가 없습니다. 아래로 당겨 새로고침하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nog geen andere gerangschikte deelnemers. Trek omlaag om te vernieuwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dostępnych wyników w tabeli liderów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há outros participantes no ranking. Puxe para baixo para atualizar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există alți participanți clasați. Trage în jos pentru actualizare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Других участников в рейтинге пока нет. Потяните вниз, чтобы обновить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Других участников в рейтинге пока нет. Потяните вниз, чтоби обновить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还没有其他上榜参与者。下拉即可刷新。"
          }
        }
      }
    },
