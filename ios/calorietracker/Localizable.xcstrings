    "Couldn't save this change. Try again.": {
      "comment": "Coach chat error when a suggested exercise could not be saved to the workout diary or library.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ هذا التغيير. حاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dəyişiklik yadda saxlanmadı. Yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změnu se nepodařilo uložit. Zkus to znovu."
          }
