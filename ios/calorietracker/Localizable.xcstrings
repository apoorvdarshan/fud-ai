    "The assistant asks before it logs or changes anything. Deletes are always confirmed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل المساعد قبل أن يسجّل أو يغيّر أي شيء. يتم تأكيد الحذف دائمًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Köməkçi hər hansı bir şeyi qeyd etmədən və ya dəyişmədən əvvəl soruşur. Silmə həmişə təsdiqlənir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistent se zeptá, než cokoli zapíše nebo změní. Mazání se potvrzuje vždy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent fragt, bevor er etwas einträgt oder ändert. Löschen wird immer bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente pregunta antes de registrar o cambiar algo. Las eliminaciones siempre se confirman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant demande avant d’enregistrer ou de modifier quoi que ce soit. Les suppressions sont toujours confirmées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असिस्टेंट कुछ भी लॉग करने या बदलने से पहले पूछता है। हटाने की पुष्टि हमेशा की जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistente chiede prima di registrare o modificare qualcosa. Le eliminazioni vanno sempre confermate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントは記録や変更の前に確認します。削除は常に確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 기록하거나 변경하기 전에 묻습니다. 삭제는 항상 확인합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De assistent vraagt het voordat hij iets logt of wijzigt. Verwijderen wordt altijd bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent pyta, zanim coś zapisze lub zmieni. Usuwanie jest zawsze potwierdzane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O assistente pergunta antes de registrar ou alterar algo. Exclusões são sempre confirmadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistentul întreabă înainte să înregistreze sau să modifice ceva. Ștergerile sunt confirmate întotdeauna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент спрашивает, прежде чем что-то записать или изменить. Удаление всегда подтверждается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistan bir şeyi kaydetmeden veya değiştirmeden önce sorar. Silme işlemleri her zaman onaylanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
