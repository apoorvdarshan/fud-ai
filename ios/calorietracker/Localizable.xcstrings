    },
    "Enter an API key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib einen API-Schlüssel ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an API key."
          }
        }
      }
    },
    "The key is too long.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel ist zu lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is too long."
          }
        }
      }
    },
    "The key contains spaces. Remove them and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel enthält Leerzeichen. Entferne sie und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key contains spaces. Remove them and try again."
          }
