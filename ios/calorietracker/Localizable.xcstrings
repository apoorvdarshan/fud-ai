    "Hosted AI accepts up to %lld photos per request.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA alojada acepta hasta %lld fotos por solicitud."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقبل الذكاء الاصطناعي المستضاف حتى %lld صور لكل طلب."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Host edilmiş AI hər sorğuda %lld fotoya qədər qəbul edir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostovaná AI přijme až %lld fotek na požadavek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gehostete KI akzeptiert bis zu %lld Fotos pro Anfrage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA hébergée accepte jusqu’à %lld photos par requête."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्टेड AI एक अनुरोध में अधिकतम %lld फ़ोटो स्वीकार करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA ospitata accetta fino a %lld foto per richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト型AIは1回のリクエストで最大%lld枚の写真を受け付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스팅 AI는 요청당 최대 %lld장의 사진을 받습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehoste AI accepteert maximaal %lld foto’s per verzoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostowane AI przyjmuje do %lld zdjęć na żądanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA hospedada aceita até %lld fotos por solicitação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-ul găzduit acceptă până la %lld fotografii per solicitare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хостинг ИИ принимает до %lld фото за запрос."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barındırılan yapay zekâ istek başına en fazla %lld fotoğraf kabul eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хостинг ШІ приймає до %lld фото за запит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托管 AI 每次请求最多接受 %lld 张照片。"
          }
        }
      }
    },
    "Hosted AI is busy. Please wait a moment and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA alojada está ocupada. Espera un momento e inténtalo de nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء الاصطناعي المستضاف مشغول. يرجى الانتظار قليلًا ثم المحاولة مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Host edilmiş AI hazırda məşğuldur. Bir az gözləyin və yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostovaná AI je vytížená. Chvíli počkej a zkus to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gehostete KI ist gerade ausgelastet. Bitte warte einen Moment und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA hébergée est occupée. Patiente un instant et réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्टेड AI अभी व्यस्त है। कृपया थोड़ी देर रुककर फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA ospitata è occupata. Attendi un momento e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト型AIが混み合っています。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스팅 AI 요청이 많습니다. 잠시 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehoste AI is druk. Wacht even en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostowane AI jest teraz obciążone. Poczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA hospedada está ocupada. Aguarde um momento e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AI găzduit este ocupat. Așteaptă puțin și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хостинг ИИ перегружен. Подожди немного и попробуй снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barındırılan yapay zekâ meşgul. Lütfen biraz bekleyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хостинг ШІ зараз перевантажений. Зачекай трохи й спробуй ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托管 AI 正忙，请稍候再试。"
          }
        }
      }
    },
    "Hosted AI rejected this request. Please update Fud AI and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA alojada rechazó esta solicitud. Actualiza Fud AI e inténtalo de nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض الذكاء الاصطناعي المستضاف هذا الطلب. يرجى تحديث Fud AI والمحاولة مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Host edilmiş AI bu sorğunu rədd etdi. Fud AI-ni yeniləyin və yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostovaná AI tento požadavek odmítla. Aktualizuj Fud AI a zkus to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gehostete KI hat diese Anfrage abgelehnt. Bitte aktualisiere Fud AI und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA hébergée a refusé cette requête. Mets à jour Fud AI et réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्टेड AI ने यह अनुरोध अस्वीकार कर दिया। कृपया Fud AI अपडेट करें और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA ospitata ha rifiutato questa richiesta. Aggiorna Fud AI e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト型AIがこのリクエストを拒否しました。Fud AIをアップデートしてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스팅 AI가 이 요청을 거부했습니다. Fud AI를 업데이트한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehoste AI heeft dit verzoek geweigerd. Werk Fud AI bij en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostowane AI odrzuciło to żądanie. Zaktualizuj Fud AI i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA hospedada recusou esta solicitação. Atualize o Fud AI e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AI găzduit a respins această cerere. Actualizează Fud AI și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хостинг ИИ отклонил этот запрос. Обнови Fud AI и попробуй снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barındırılan yapay zekâ bu isteği reddetti. Lütfen Fud AI'ı güncelleyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хостинг ШІ відхилив цей запит. Онови Fud AI і спробуй ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托管 AI 拒绝了此请求。请更新 Fud AI 后重试。"
          }
        }
      }
    },
