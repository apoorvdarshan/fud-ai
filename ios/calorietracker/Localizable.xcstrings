    "No worries! We'll use a standard formula\nbased on your height, weight, and age.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡No te preocupes! Usaremos una fórmula estándar\nbasada en tu altura, peso y edad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun problema! Useremo una formula standard\nbasata su altezza, peso ed età."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojnie! Użyjemy standardowego wzoru\nna podstawie wzrostu, wagi i wieku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не переживайте! Мы воспользуемся стандартной формулой\nна основе вашего роста, веса и возраста."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не хвилюйтеся! Ми скористаємося стандартною формулою\nна основі вашого зросту, ваги та віку."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V pohodě! Použijeme standardní vzorec\npodle tvé výšky, váhy a věku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorun değil! Boyunuza, kilonuza ve yaşınıza\ndayalı standart bir formül kullanacağız."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تقلق! سنستخدم صيغة قياسية\nبناءً على طولك ووزنك وعمرك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Narahat olmayın! Boy, çəki və yaşınıza əsasən\nstandart düstur istifadə edəcəyik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Problem! Wir verwenden eine Standardformel\nbasierend auf Größe, Gewicht und Alter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de souci ! Nous utiliserons une formule standard\nbasée sur votre taille, poids et âge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बात नहीं! हम आपकी ऊंचाई, वज़न और उम्र\nके आधार पर एक मानक फ़ॉर्मूला उपयोग करेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大丈夫です！身長、体重、年齢から\n標準的な計算式を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "괜찮아요! 키, 체중, 나이를 기반으로\n표준 공식을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen zorgen! We gebruiken een standaardformule\ngebaseerd op je lengte, gewicht en leeftijd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem problema! Usaremos uma fórmula padrão\ncom base na sua altura, peso e idade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicio grijă! Vom folosi o formulă standard\npe baza înălțimii, greutății și vârstei tale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没关系！我们会根据你的身高、体重和\n年龄使用标准公式计算。"
          }
        }
      }
    },
