    "I accept the Terms of Service and Privacy Policy, including AI provider data sharing described above.": {
      "comment": "A checkbox and label that allows the user to agree to the app's Terms of Service and Privacy Policy.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto los Términos del servicio y la Política de privacidad, incluido el intercambio de datos con el proveedor de IA descrito arriba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetto i Termini di servizio e l'Informativa sulla privacy, inclusa la condivisione dei dati con il provider IA descritta sopra."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akceptuję Warunki korzystania i Politykę prywatności, w tym opisane powyżej udostępnianie danych dostawcom AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я принимаю Условия использования и Политику конфиденциальности, включая описанную выше передачу данных ИИ-провайдеру."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я приймаю Умови використання та Політику конфіденційності, зокрема описану вище передачу даних провайдеру ШІ."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přijímám Podmínky služby a Zásady ochrany soukromí, včetně výše popsaného sdílení dat s AI poskytovatelem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yukarıda açıklanan yapay zekâ sağlayıcılarıyla veri paylaşımı da dâhil olmak üzere Kullanım Koşulları’nı ve Gizlilik Politikası’nı kabul ediyorum."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق على شروط الخدمة وسياسة الخصوصية، بما في ذلك مشاركة البيانات مع مزود الذكاء الاصطناعي كما هو موضح أعلاه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yuxarıda təsvir olunan AI təminatçısı ilə məlumat paylaşımı daxil olmaqla Xidmət Şərtlərini və Məxfilik Siyasətini qəbul edirəm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich akzeptiere die Nutzungsbedingungen und die Datenschutzrichtlinie, einschließlich der oben beschriebenen Datenweitergabe an KI-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’accepte les Conditions d’utilisation et la Politique de confidentialité, y compris le partage de données avec le fournisseur d’IA décrit ci-dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं सेवा की शर्तें और गोपनीयता नीति स्वीकार करता/करती हूँ, जिसमें ऊपर बताए अनुसार AI प्रदाता के साथ डेटा साझा करना शामिल है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上記のAIプロバイダとのデータ共有を含め、利用規約とプライバシーポリシーに同意します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에 설명된 AI 제공자와의 데이터 공유를 포함하여 서비스 약관 및 개인정보 처리방침에 동의합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik accepteer de Servicevoorwaarden en het Privacybeleid, inclusief het hierboven beschreven delen van gegevens met de AI-provider."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceito os Termos de serviço e a Política de privacidade, incluindo o compartilhamento de dados com o provedor de IA descrito acima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept Termenii serviciului și Politica de confidențialitate, inclusiv partajarea datelor cu furnizorul AI descrisă mai sus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
