          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Sağlık'a bağlanılamadı. Daha sonra Ayarlar'dan tekrar deneyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підключитися до Apple Health. Спробуйте ще раз пізніше в налаштуваннях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Apple Health。你可以稍后在设置中重试。"
          }
        }
      }
    },
    "Imported %@.": {
      "comment": "Apple Health import summary. The argument is a list such as “120 meals and 45 weigh-ins”.",
