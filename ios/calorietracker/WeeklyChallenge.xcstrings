    },
    "Only weekly totals leave your device": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تغادر جهازك سوى الإجماليات الأسبوعية"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazınızdan yalnız həftəlik cəmlər çıxır"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Wochensummen verlassen dein Gerät"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only weekly totals leave your device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los totales semanales salen de tu dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les totaux hebdomadaires quittent votre appareil"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस से केवल साप्ताहिक कुल आँकड़े बाहर जाते हैं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i totali settimanali lasciano il tuo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスから送信されるのは週間合計だけです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 밖으로 나가는 것은 주간 합계뿐입니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen weektotalen verlaten je apparaat"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z urządzenia wychodzą tylko sumy tygodniowe"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só os totais semanais saem do seu dispositivo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar totalurile săptămânale părăsesc dispozitivul tău"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С устройства передаются только недельные итоги"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З пристрою передаються лише тижневі підсумки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有每周总数会离开你的设备"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca haftalık toplamlar cihazınızdan çıkar"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zařízení opouštějí jen týdenní souhrny"
          }
        }
      }
    },
