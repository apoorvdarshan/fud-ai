            "value": "Dołącz do cotygodniowego wyzwania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Participar do Desafio semanal"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Participă la Provocarea săptămânală"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Присоединиться к соревнованию"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднатися до щотижневого змагання"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入每周挑战"
          }
        },
        "tr": {
