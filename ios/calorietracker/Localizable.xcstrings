          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar este cambio. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer cette modification. Réessaie."
