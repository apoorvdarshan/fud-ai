          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hostovaná AI je dočasně nedostupná. Zkus to prosím za chvíli znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gehostete KI ist vorübergehend nicht verfügbar. Bitte versuche es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA alojada no está disponible temporalmente. Inténtalo de nuevo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA hébergée est temporairement indisponible. Réessaie dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्टेड AI अभी उपलब्ध नहीं है। कृपया थोड़ी देर बाद फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA ospitata è temporaneamente non disponibile. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト型AIは一時的に利用できません。しばらくしてからもう一度お試しください。"
