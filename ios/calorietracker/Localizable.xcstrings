          }
        }
      }
    },
    "Nothing to export": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que exportar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء للتصدير"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İxrac ediləcək heç nə yoxdur"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není co exportovat"
          }
        },
        "de": {
          "stringUnit": {
