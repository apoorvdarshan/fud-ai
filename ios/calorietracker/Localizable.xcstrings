          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**CR10 0–10:** 휴식부터 최대까지의 전반적인 운동 강도."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**CR10 0–10:** algemene inspanning van rust tot maximaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**CR10 0–10:** ogólny wysiłek od spoczynku do maksimum."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**CR10 0–10:** esforço geral, do repouso ao máximo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**CR10 0–10:** efort general, de la repaus la maximum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**CR10 0–10:** общая нагрузка от покоя до максимума."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**CR10 0–10:** загальне навантаження від спокою до максимуму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**CR10 0–10：** 从静息到最大的整体用力程度。"
          }
        }
      }
    },
    "**Strength 1–10:** Lifting effort based on how many reps you had left.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Fuerza 1–10:** esfuerzo al levantar peso según cuántas repeticiones te quedaban."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kuvvet 1–10:** Kaldırış eforu, kaç tekrar daha yapabileceğinize göre değerlendirilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**القوة 1–10:** جهد رفع الأثقال بناءً على عدد التكرارات المتبقية لديك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "**Güc 1–10:** Neçə təkrar ehtiyatınız qaldığına əsaslanan qaldırma səyi."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "**Síla 1–10:** Námaha při zvedání podle toho, kolik opakování ti zbývalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kraft 1–10:** Anstrengung beim Heben, gemessen daran, wie viele Wiederholungen noch drin gewesen wären."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Force 1–10 :** effort de levée selon le nombre de répétitions qu’il vous restait."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**स्ट्रेंथ 1–10:** आपके पास कितने रेप्स बचे थे, उसके आधार पर लिफ़्टिंग प्रयास।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Forza 1–10:** sforzo di sollevamento in base a quante ripetizioni ti restavano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**筋力 1–10：** あと何回できたかに基づく挙上の負荷。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**근력 1–10:** 남은 반복 횟수를 기준으로 한 리프팅 강도."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Kracht 1–10:** tilinspanning op basis van hoeveel herhalingen je nog over had."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Siła 1–10:** wysiłek przy podnoszeniu na podstawie liczby powtórzeń, które jeszcze mogłeś zrobić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Força 1–10:** esforço de levantamento com base em quantas repetições ainda restavam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "**Forță 1–10:** efortul la ridicare, în funcție de câte repetări mai puteai face."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Сила 1–10:** усилие при подъёме по тому, сколько повторений у вас оставалось в запасе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "**Сила 1–10:** зусилля під час підйому залежно від того, скільки повторень у вас залишалося в запасі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**力量 1–10：** 根据你还能再做几次来衡量举重用力程度。"
          }
        }
      }
    },
