        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Když je sledování vody zapnuté, voda se zobrazuje za vybranými živinami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasser wird nach deinen ausgewählten Nährstoffen angezeigt, solange die Wasseraufzeichnung aktiviert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’eau s’affiche après les nutriments sélectionnés tant que le suivi de l’eau est activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉटर ट्रैकिंग चालू रहने पर पानी आपके चुने हुए पोषक तत्वों के बाद दिखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’acqua viene mostrata dopo i nutrienti selezionati finché il monitoraggio dell’acqua è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水分の記録がオンの間は、選択した栄養素の後に水分が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물 기록이 켜져 있으면 선택한 영양소 뒤에 물이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Water wordt na je geselecteerde voedingsstoffen getoond zolang Water bijhouden is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy śledzenie wody jest włączone, woda jest pokazywana po wybranych składnikach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A água aparece depois dos nutrientes selecionados enquanto o registro de água estiver ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa apare după nutrienții selectați cât timp urmărirea apei este activată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При включённом учёте воды вода отображается после выбранных нутриентов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Su takibi etkinken su, seçili besinlerinizden sonra gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "При увімкненому відстеженні води вона відображається після обраних нутрієнтів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启饮水记录时，饮水会显示在你所选营养素之后。"
          }
        }
      }
    },
