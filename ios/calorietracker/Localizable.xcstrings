    "Buy credits, upgrade your plan, or switch to BYOK with your own API key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra créditos, mejora tu plan o cambia a BYOK con tu propia clave API."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredi satın alın, planınızı yükseltin veya kendi API anahtarınızla BYOK moduna geçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترِ أرصدة أو قم بترقية خطتك أو انتقل إلى BYOK باستخدام مفتاح API الخاص بك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kredit alın, planınızı yüksəldin və ya öz API açarınızla BYOK-a keçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kup si kredity, přejdi na vyšší plán nebo přepni na BYOK s vlastním API klíčem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaufe Credits, mach ein Upgrade deines Plans oder wechsle zu BYOK mit deinem eigenen API-Schlüssel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achète des crédits, passe à un forfait supérieur ou passe en BYOK avec ta propre clé API."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रेडिट खरीदें, अपना प्लान अपग्रेड करें, या अपनी API कुंजी के साथ BYOK पर स्विच करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquista crediti, potenzia il tuo piano o passa a BYOK con la tua chiave API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットを購入するか、プランをアップグレードするか、自分のAPIキーでBYOKに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크레딧을 구매하거나, 요금제를 업그레이드하거나, 내 API 키로 BYOK로 전환하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koop credits, upgrade je abonnement of schakel over naar BYOK met je eigen API-sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kup kredyty, przejdź na wyższy plan lub przełącz się na BYOK z własnym kluczem API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compre créditos, faça upgrade do seu plano ou mude para BYOK com sua própria chave de API."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cumpără credite, fă upgrade la plan sau treci la BYOK cu propria ta cheie API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Купи кредиты, повысь тариф или переключись на BYOK со своим ключом API."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Купи кредити, покращ тариф або перейди на BYOK із власним ключем API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买点数、升级方案，或使用你自己的 API 密钥切换到 BYOK。"
          }
        }
      }
    },
