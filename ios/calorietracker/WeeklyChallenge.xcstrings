    "Remote challenge data was not deleted. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحذف بيانات التحدي البعيدة. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzaq serverdəki çağırış məlumatları silinmədi. Bağlantınızı yoxlayıb yenidən cəhd edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Challenge-Daten wurden nicht gelöscht. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote challenge data was not deleted. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se borraron los datos remotos del reto. Revisa tu conexión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du défi en ligne n’ont pas été supprimées. Vérifiez votre connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट चुनौती डेटा नहीं हटाया गया। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati remoti della sfida non sono stati eliminati. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー上のチャレンジデータは削除されませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 챌린지 데이터가 삭제되지 않았습니다. 연결을 확인한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De externe uitdagingsgegevens zijn niet verwijderd. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdalne dane wyzwania nie zostały usunięte. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados remotos do desafio não foram apagados. Verifique sua conexão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele provocării de pe server nu au fost șterse. Verifică-ți conexiunea și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные соревнования на сервере не удалены. Проверьте подключение и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані змагання на сервері не видалено. Перевірте з’єднання та спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器上的挑战数据未被删除。请检查网络连接后重试。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzak yarışma verileri silinmedi. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vzdálená data výzvy nebyla smazána. Zkontroluj připojení a zkus to znovu."
          }
        }
      }
    },
