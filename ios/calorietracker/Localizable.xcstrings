    "Ingredient changes update the meal's calorie and macro totals automatically.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios en los ingredientes actualizan automáticamente las calorías y los macros totales de la comida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Malzeme değişiklikleri öğünün toplam kalori ve makro değerlerini otomatik olarak günceller."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تؤدي تغييرات المكوّنات إلى تحديث إجماليات السعرات والمغذيات الكبرى للوجبة تلقائيًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tərkib hissələrindəki dəyişikliklər yeməyin kalori və makro cəmlərini avtomatik yeniləyir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny ingrediencí automaticky aktualizují souhrny kalorií a makroživin jídla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen an Zutaten aktualisieren Kalorien- und Makrosummen der Mahlzeit automatisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications d’ingrédients mettent automatiquement à jour les totaux de calories et de macros du repas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सामग्री में बदलाव भोजन की कुल कैलोरी और मैक्रो को अपने-आप अपडेट करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche agli ingredienti aggiornano automaticamente calorie e macro totali del pasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料を変更すると、食事のカロリーとマクロの合計が自動的に更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재료를 변경하면 식사의 칼로리와 매크로 합계가 자동으로 업데이트됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen in ingrediënten werken de calorie- en macrototalen van de maaltijd automatisch bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany składników automatycznie aktualizują sumy kalorii i makroskładników posiłku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudanças nos ingredientes atualizam automaticamente os totais de calorias e macros da refeição."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările ingredientelor actualizează automat totalurile de calorii și macronutrienți ale mesei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения ингредиентов автоматически обновляют итоговые калории и макронутриенты блюда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни інгредієнтів автоматично оновлюють підсумки калорій і макронутрієнтів страви."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改配料会自动更新该餐的热量和宏量营养素总量。"
          }
        }
      }
    },
