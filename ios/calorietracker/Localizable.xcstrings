        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma rotina ainda"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu există rutine"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблонов пока нет"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz rutin yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблонів поки немає"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有训练模板"
          }
        }
      }
    },
    "Log a workout, then choose Save as routine from the + menu.": {
      "comment": "Empty routines list hint. Save as routine is the + menu item of the same name.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل تمرينًا، ثم اختر «حفظ كروتين» من قائمة +."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məşq qeyd edin, sonra + menyusundan «Rutin kimi saxla» seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište trénink a pak v nabídce + zvolte Uložit jako rutinu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage ein Training ein und wähle dann im +-Menü „Als Routine speichern“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a workout, then choose Save as routine from the + menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un entrenamiento y luego elige Guardar como rutina en el menú +."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un entraînement, puis choisissez Enregistrer comme routine dans le menu +."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई वर्कआउट लॉग करें, फिर + मेनू से “रूटीन के रूप में सहेजें” चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un allenamento, poi scegli Salva come routine dal menu +."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウトを記録してから、＋メニューの「ルーティンとして保存」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동을 기록한 다음 + 메뉴에서 ‘루틴으로 저장’을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log een training en kies daarna Opslaan als routine in het +-menu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz trening, a potem wybierz Zapisz jako rutynę w menu +."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre um treino e escolha Salvar como rotina no menu +."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează un antrenament, apoi alege Salvează ca rutină din meniul +."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите тренировку, затем выберите «Сохранить как шаблон» в меню +."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir antrenman kaydedin, ardından + menüsünden Rutin olarak kaydet’i seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть тренування, потім виберіть «Зберегти як шаблон» у меню +."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先记录一次训练，然后在 + 菜单中选择“保存为训练模板”。"
          }
        }
      }
    },
    "Adds the routine's exercises to the selected day. Sets you already logged stay as they are.": {
      "comment": "Explains how starting a day from a routine merges with what is already logged.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف تمارين الروتين إلى اليوم المحدد. تبقى المجموعات التي سجّلتها كما هي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutinin məşqlərini seçilmiş günə əlavə edir. Artıq qeyd etdiyiniz setlər olduğu kimi qalır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá cviky z rutiny do vybraného dne. Již zapsané série zůstanou beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt die Übungen der Routine zum ausgewählten Tag hinzu. Bereits eingetragene Sätze bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the routine's exercises to the selected day. Sets you already logged stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los ejercicios de la rutina al día seleccionado. Las series que ya registraste no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les exercices de la routine au jour sélectionné. Les séries déjà enregistrées restent inchangées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रूटीन के व्यायाम चुने गए दिन में जोड़ता है। आपके पहले से लॉग किए गए सेट वैसे ही रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge gli esercizi della routine al giorno selezionato. Le serie già registrate restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーティンの種目を選択した日に追加します。記録済みのセットはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "루틴의 운동을 선택한 날에 추가합니다. 이미 기록한 세트는 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt de oefeningen van de routine toe aan de geselecteerde dag. Sets die je al hebt gelogd blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje ćwiczenia z rutyny do wybranego dnia. Już zapisane serie pozostają bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona os exercícios da rotina ao dia selecionado. As séries que você já registrou continuam como estão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă exercițiile rutinei în ziua selectată. Seriile deja înregistrate rămân neschimbate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет упражнения из шаблона в выбранный день. Уже записанные подходы не изменятся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rutinin egzersizlerini seçili güne ekler. Daha önce kaydettiğiniz setler olduğu gibi kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає вправи із шаблону до вибраного дня. Уже записані підходи не зміняться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将模板中的动作添加到所选日期。已记录的组保持不变。"
          }
        }
      }
    },
