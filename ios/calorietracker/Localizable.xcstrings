        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연간 요금제를 **27% 할인**받았어요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je krijgt **27% korting** op je jaarabonnement!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz **27% zniżki** na plan roczny!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ganhou **27% de desconto** no plano anual!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai primit **27% reducere** la abonamentul anual!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы получили **скидку 27%** на годовой план!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви отримали **знижку 27%** на річний план!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的年度订阅享 **7.3 折**（**27% 折扣**）！"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máš **27% slevu** na roční plán!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yıllık planınızda **%27 indirim** kazandınız!"
          }
        }
      }
    },
