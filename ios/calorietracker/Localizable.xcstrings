            "value": "Key profile"
          }
        }
      }
    },
    "New key profile": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neues Schlüsselprofil"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New key profile"
          }
        }
      }
    },
    "Leave the key empty to keep the current one. The full key is never shown again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Schlüsselfeld leer, um den aktuellen Schlüssel zu behalten. Der vollständige Schlüssel wird nie wieder angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the key empty to keep the current one. The full key is never shown again."
          }
        }
      }
    },
    "Stored in this device's encrypted credential storage. Fud AI never shows the full key again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird im verschlüsselten Anmeldedatenspeicher dieses Geräts gespeichert. Fud AI zeigt den vollständigen Schlüssel nie wieder an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored in this device's encrypted credential storage. Fud AI never shows the full key again."
          }
        }
      }
    },
    "Edit API key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel bearbeiten"
          }
