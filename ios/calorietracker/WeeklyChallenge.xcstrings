    "Join an optional, privacy-first leaderboard based on healthy weekly habits—not body weight. You must be 18 or older.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انضم اختياريًا لمقارنة إنجازات النشاط والتغذية والاستمرارية والترطيب الأسبوعية. تظل شاشة التقدم الخاصة متاحة دون الانضمام."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həftəlik fəaliyyət, qidalanma, ardıcıllıq və su qəbulu nailiyyətlərini müqayisə etmək üçün istəyə bağlı qoşulun. Şəxsi İrəliləyiş ekranınız qoşulmadan da əlçatan qalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm freiwillig teil und vergleiche wöchentliche Meilensteine für Aktivität, Ernährung, Regelmäßigkeit und Flüssigkeitszufuhr. Dein privater Fortschritt bleibt auch ohne Teilnahme verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join an optional, privacy-first leaderboard based on healthy weekly habits—not body weight. You must be 18 or older."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Participa voluntariamente para comparar logros semanales de actividad, nutrición, constancia e hidratación. Tu pantalla privada de Progreso seguirá disponible sin participar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Participez volontairement pour comparer vos objectifs hebdomadaires d’activité, de nutrition, de régularité et d’hydratation. Votre écran Progression privé reste accessible sans participer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साप्ताहिक गतिविधि, पोषण, निरंतरता और जल सेवन के लक्ष्य की तुलना करने के लिए स्वेच्छा से जुड़ें। बिना जुड़े भी आपकी निजी प्रगति स्क्रीन उपलब्ध रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Partecipa facoltativamente per confrontare i traguardi settimanali di attività, alimentazione, costanza e idratazione. La schermata privata dei Progressi resta disponibile senza partecipare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意で参加し、運動、栄養、継続、水分補給の週間目標を比較できます。参加しなくても非公開の進捗画面は引き続き利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택적으로 참여하여 주간 활동, 영양, 꾸준함, 수분 섭취 목표를 비교하세요. 참여하지 않아도 비공개 진행 상황 화면은 계속 이용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe vrijwillig mee en vergelijk wekelijkse mijlpalen voor activiteit, voeding, regelmaat en hydratatie. Je persoonlijke Voortgang blijft beschikbaar zonder deelname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz do opcjonalnej tabeli liderów opartej na prywatności, opartej na zdrowych nawykach tygodniowych - a nie na wadze ciała. Musisz mieć ukończone 18 lat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Participe opcionalmente para comparar metas semanais de atividade, nutrição, consistência e hidratação. Sua tela privada de Progresso continua disponível sem participar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Participă opțional pentru a compara obiectivele săptămânale de activitate, nutriție, consecvență și hidratare. Ecranul privat Progres rămâne disponibil fără participare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По желанию присоединитесь, чтобы сравнивать еженедельные достижения в активности, питании, регулярности и питьевом режиме. Личный экран прогресса доступен и без участия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "По желанию присоединитесь, чтоби сравнивать еженедельние достижения в активности, питании, регулярности и питьевом режиме. Личний екран прогресса доступен и без участия."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可自愿加入，比较每周活动、营养、坚持和饮水目标。即使不加入，也可以继续使用私密的进度页面。"
          }
        }
      }
    },
