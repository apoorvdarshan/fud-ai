          "stringUnit": {
            "state": "translated",
            "value": "2～40文字：文字、数字、スペース、ピリオド、アンダースコア、アポストロフィ、ハイフン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2~40자: 문자, 숫자, 공백, 마침표, 밑줄, 아포스트로피 또는 하이픈"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 tekens: letters, cijfers, spaties, punt, laag streepje, apostrof of koppelteken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj 2–40 liter lub cyfr. Dozwolone są spacje, kropki, podkreślenia, apostrofy i łączniki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 2 a 40 caracteres: letras, números, espaços, ponto, sublinhado, apóstrofo ou hífen"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 de caractere: litere, cifre, spații, punct, linie de subliniere, apostrof sau cratimă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От 2 до 40 символов: буквы, цифры, пробелы, точка, подчёркивание, апостроф или дефис"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте 2–40 літер або цифр. Дозволено пробіли, крапки, підкреслення, апострофи та дефіси."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 个字符：字母、数字、空格、句点、下划线、撇号或连字符"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2-40 harf veya rakam kullanın. Boşluklar, noktalar, alt çizgiler, kesme işaretleri ve tireler kullanılabilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použij 2–40 písmen nebo číslic. Povoleny jsou mezery, tečky, podtržítka, apostrofy a pomlčky."
          }
        }
      }
    },
