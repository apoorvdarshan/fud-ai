    "e.g. \"This is a half portion\" or \"Cooked in olive oil\"": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., \"Es media porción\" o \"Cocinado en aceite de oliva\""
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. \"Questa è mezza porzione\" o \"Cotto con olio d'oliva\""
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. \"To jest połowa porcji\" lub \"Gotowane w oliwie\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "напр. «Это половина порции» или «Приготовлено на оливковом масле»"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "напр. «Це половина порції» або «Приготовано на оливковій олії»"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "např. „Tohle je poloviční porce“ nebo „Vařeno na olivovém oleji“"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "örn. \"Bu yarım porsiyon\" veya \"Zeytinyağında pişirildi\""
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثلًا \"هذه نصف حصة\" أو \"مطبوخ بزيت الزيتون\""
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "məs. \"Bu yarım porsiyadır\" və ya \"Zeytun yağında bişirilib\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. „Das ist eine halbe Portion“ oder „In Olivenöl gebraten“"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. « C’est une demi-portion » ou « Cuit à l’huile d’olive »"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे \"यह आधा हिस्सा है\" या \"जैतून के तेल में पकाया गया\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：「半人前です」「オリーブオイルで調理」"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: \"반 인분이에요\" 또는 \"올리브유로 조리했어요\""
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. \"Dit is een halve portie\" of \"Bereid in olijfolie\""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: \"Isto é meia porção\" ou \"Preparado no azeite\""
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
