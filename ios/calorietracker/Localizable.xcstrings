    "Subscribe to Plus or Pro to use Hosted AI, or switch to BYOK in Settings → AI Access.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete a Plus o Pro para usar la IA alojada, o cambia a BYOK en Ajustes → Acceso a IA."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك في Plus أو Pro لاستخدام الذكاء الاصطناعي المستضاف، أو انتقل إلى BYOK من الإعدادات ← الوصول إلى الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Host edilmiş AI-dan istifadə etmək üçün Plus və ya Pro-ya abunə olun, ya da Parametrlər → AI Girişi bölməsində BYOK-a keçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro používání hostované AI si předplať Plus nebo Pro, nebo přepni na BYOK v Nastavení → Přístup k AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonniere Plus oder Pro, um gehostete KI zu nutzen, oder wechsle unter Einstellungen → KI-Zugang zu BYOK."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonne-toi à Plus ou Pro pour utiliser l’IA hébergée, ou passe en BYOK dans Réglages → Accès à l’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्टेड AI इस्तेमाल करने के लिए Plus या Pro की सदस्यता लें, या सेटिंग्स → AI एक्सेस में BYOK पर स्विच करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati a Plus o Pro per usare l'IA ospitata, oppure passa a BYOK in Impostazioni → Accesso IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト型AIを使うにはPlusまたはProに登録するか、設定 → AIアクセスでBYOKに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스팅 AI를 사용하려면 Plus 또는 Pro를 구독하거나, 설정 → AI 액세스에서 BYOK로 전환하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer je op Plus of Pro om Gehoste AI te gebruiken, of schakel over naar BYOK in Instellingen → AI-toegang."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykup Plus lub Pro, aby korzystać z Hostowanego AI, albo przełącz się na BYOK w Ustawieniach → Dostęp do AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine o Plus ou o Pro para usar a IA hospedada ou mude para BYOK em Ajustes → Acesso à IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonează-te la Plus sau Pro pentru a folosi AI găzduit sau treci la BYOK din Setări → Acces AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформи Plus или Pro, чтобы пользоваться Хостингом ИИ, или переключись на BYOK в разделе Настройки → Доступ к ИИ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Barındırılan yapay zekâyı kullanmak için Plus veya Pro'ya abone olun ya da Ayarlar → Yapay Zekâ Erişimi'nden BYOK'a geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформи Plus або Pro, щоб користуватися Хостингом ШІ, або перейди на BYOK у розділі Налаштування → Доступ до ШІ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅 Plus 或 Pro 即可使用托管 AI，也可以在“设置 → AI 接入”中切换到 BYOK。"
          }
        }
      }
    },
