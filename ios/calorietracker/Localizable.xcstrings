    "What you ate, for example 100g chicken breast or two eggs and toast.": {
      "comment": "Prompt for the user to enter the ingredients of a recipe.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que comiste, por ejemplo 100 g de pechuga de pollo o dos huevos con pan tostado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa hai mangiato, ad esempio 100g di petto di pollo o due uova con pane tostato."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co zjadłeś/zjadłaś, np. 100 g piersi z kurczaka albo dwa jajka i tost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что вы съели, например 100 г куриной грудки или два яйца и тост."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що ви з’їли, наприклад 100 г курячої грудки або два яйця й тост."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co bylo k jídlu, například 100 g kuřecích prsou nebo dvě vejce a toast."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedikleriniz; örneğin 100 g tavuk göğsü veya iki yumurta ve tost."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما أكلته، مثلًا 100 غ صدر دجاج أو بيضتان وخبز محمص."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nə yediniz, məsələn, 100 q toyuq döşü və ya iki yumurta və tost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du gegessen hast, zum Beispiel 100 g Hähnchenbrust oder zwei Eier und Toast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez mangé, par exemple 100 g de blanc de poulet ou deux œufs et du pain grillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने क्या खाया, जैसे 100 ग्राम चिकन ब्रेस्ट या दो अंडे और टोस्ट।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食べたもの。例：鶏むね肉100g、卵2個とトースト。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹은 음식. 예: 닭가슴살 100g 또는 달걀 두 개와 토스트."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je hebt gegeten, bijvoorbeeld 100 g kipfilet of twee eieren en toast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você comeu, por exemplo 100 g de peito de frango ou dois ovos e torrada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce ai mâncat, de exemplu 100 g piept de pui sau două ouă și pâine prăjită."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你吃了什么，例如 100 克鸡胸肉，或两个鸡蛋和吐司。"
