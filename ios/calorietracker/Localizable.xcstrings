    },
    "The key is removed from this device. No active route uses it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel wird von diesem Gerät entfernt. Keine aktive Route nutzt ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is removed from this device. No active route uses it."
          }
        }
      }
    },
    "The key is removed from this device. It is used by %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel wird von diesem Gerät entfernt. Er wird genutzt von %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is removed from this device. It is used by %@."
          }
        }
      }
    },
    "Shows which provider, API key profile and model every AI route uses. Each route can use its own key, so you can keep a personal and a work key for the same provider. Rows marked Off are not active.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, welcher Anbieter, welches API-Schlüsselprofil und welches Modell jede KI-Route nutzt. Jede Route kann ihren eigenen Schlüssel verwenden, sodass du einen privaten und einen geschäftlichen Schlüssel für denselben Anbieter behalten kannst. Mit „Aus“ markierte Zeilen sind nicht aktiv."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows which provider, API key profile and model every AI route uses. Each route can use its own key, so you can keep a personal and a work key for the same provider. Rows marked Off are not active."
          }
        }
      }
    },
