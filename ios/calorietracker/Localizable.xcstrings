            "value": "Récupération de tes données…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा वापस लाया जा रहा है…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
