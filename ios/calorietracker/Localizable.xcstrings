    "Calories are estimates. Use Calculate in the diary after adding your workout.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las calorías son estimaciones. Usa Calcular en el diario después de añadir tu entrenamiento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalori değerleri tahminidir. Antrenmanınızı ekledikten sonra günlüğünüzdeki Hesapla'yı kullanın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السعرات تقديرية. استخدم «احسب» في اليوميات بعد إضافة تمرينك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorilər təxminidir. Məşqi əlavə etdikdən sonra gündəlikdə Hesabla düyməsindən istifadə edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorie jsou odhad. Po přidání tréninku použij v deníku Vypočítat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorien sind Schätzungen. Nutze nach dem Hinzufügen deines Trainings „Berechnen“ im Tagebuch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calories sont des estimations. Utilisez Calculer dans le journal après avoir ajouté votre entraînement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलोरी अनुमानित हैं। वर्कआउट जोड़ने के बाद डायरी में गणना करें का उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calorie sono stime. Usa Calcola nel diario dopo aver aggiunto l’allenamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カロリーは推定値です。ワークアウトを追加したら、日記で「計算」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칼로리는 추정치입니다. 운동을 추가한 후 일기에서 계산을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Calorieën zijn schattingen. Gebruik Berekenen in het dagboek nadat je je training hebt toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorie są szacunkowe. Po dodaniu treningu użyj opcji Oblicz w dzienniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As calorias são estimativas. Use Calcular no diário depois de adicionar o treino."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Caloriile sunt estimări. Folosește Calculează în jurnal după ce adaugi antrenamentul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Калории — это оценка. После добавления тренировки используйте «Рассчитать» в дневнике."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Калорії — це оцінка. Після додавання тренування скористайтеся «Розрахувати» в щоденнику."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热量为估算值。添加训练后，请在日记中使用“计算”。"
          }
        }
      }
    },
