    "Gentle and sustainable. Great for long-term habits.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suave y sostenible. Ideal para hábitos a largo plazo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Delicato e sostenibile. Ideale per abitudini a lungo termine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łagodne i trwałe. Dobre dla długoterminowych nawyków."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мягко и устойчиво. Отлично подходит для долгосрочных привычек."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавно й стабільно. Чудово підходить для довготривалих звичок."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šetrné a udržitelné. Skvělé pro dlouhodobé návyky."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazik ve sürdürülebilir. Uzun vadeli alışkanlıklar için harika."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لطيف ومستدام. رائع للعادات طويلة المدى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yumşaq və davamlı. Uzunmüddətli vərdişlər üçün əladır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sanft und nachhaltig. Ideal für langfristige Gewohnheiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doux et durable. Idéal pour des habitudes à long terme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सौम्य और टिकाऊ। दीर्घकालिक आदतों के लिए बढ़िया।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかで持続可能。長期的な習慣に最適。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드럽고 지속 가능합니다. 장기적인 습관에 적합해요."
          }
        },
        "nl": {
          "stringUnit": {
