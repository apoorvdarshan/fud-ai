    "Enter the selected social handle, or choose No social link.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسم المستخدم للشبكة الاجتماعية المحددة، أو اختر «بدون رابط اجتماعي»."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş sosial şəbəkə üçün istifadəçi adını daxil edin və ya \"Sosial keçid yoxdur\" seçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Handle für das ausgewählte Netzwerk ein oder wähle „Kein Social-Link“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the selected social handle, or choose No social link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el usuario de la red social seleccionada o elige Ninguno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’identifiant du réseau sélectionné ou choisissez Aucun lien social."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए सोशल नेटवर्क का यूज़रनेम दर्ज करें, या कोई सोशल लिंक नहीं चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il nome utente del social selezionato oppure scegli Nessun link social."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したSNSのユーザー名を入力するか、「SNSリンクなし」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 소셜 계정의 사용자 이름을 입력하거나 '소셜 링크 없음'을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de gebruikersnaam voor het gekozen netwerk in of kies Geen sociale link."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz nazwę użytkownika wybranego serwisu lub wybierz Brak linku społecznościowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o usuário da rede social selecionada ou escolha Sem link social."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu numele de utilizator pentru rețeaua selectată sau alege Fără link social."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите имя пользователя в выбранной соцсети или выберите «Без ссылки на соцсеть»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть ім’я користувача у вибраній соцмережі або виберіть «Без посилання на соцмережу»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入所选社交平台的用户名，或选择“不添加社交链接”。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen sosyal medya kullanıcı adını girin veya Sosyal bağlantı yok seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadej uživatelské jméno pro vybranou síť, nebo zvol Bez sociální sítě."
          }
        }
      }
    },
