    "I agree to the Community Rules": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوافق على قواعد المجتمع وسأستخدم ملفًا محترمًا لا ينتحل شخصية أحد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İcma Qaydalarını qəbul edirəm və heç kimi təqlid etməyən hörmətli profil istifadə edəcəyəm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich akzeptiere die Community-Regeln und verwende ein respektvolles Profil, das niemanden imitiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I agree to the Community Rules"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acepto las Normas de la comunidad y usaré un perfil respetuoso que no suplante a nadie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’accepte les Règles de la communauté et utiliserai un profil respectueux, sans usurpation d’identité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं कम्युनिटी नियम स्वीकार करता/करती हूँ और किसी की नकल न करने वाली सम्मानजनक प्रोफ़ाइल का उपयोग करूँगा/करूँगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetto le Regole della community e userò un profilo rispettoso che non imiti altre persone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティルールに同意し、他人になりすまさない礼儀正しいプロフィールを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커뮤니티 규칙에 동의하며 다른 사람을 사칭하지 않는 정중한 프로필을 사용하겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik accepteer de Communityregels en gebruik een respectvol profiel waarmee ik me niet als iemand anders voordoe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akceptuję Zasady społeczności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceito as Regras da comunidade e usarei um perfil respeitoso, sem fingir ser outra pessoa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept Regulile comunității și voi folosi un profil respectuos, fără uzurparea identității."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я принимаю Правила сообщества и буду использовать уважительный профиль, не выдавая себя за других."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитати Правила спільноти"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我接受社区规则，并会使用尊重他人且不冒充他人的个人资料。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Topluluk Kurallarını kabul ediyorum"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Souhlasím s Pravidly komunity"
          }
        }
      }
    },
