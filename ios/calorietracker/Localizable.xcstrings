    "Log today's weight to keep your progress chart accurate.": {
      "comment": "Body of the daily weigh-in reminder notification.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل وزن اليوم ليبقى مخطط تقدمك دقيقًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İrəliləyiş qrafikinizin dəqiq qalması üçün bugünkü çəkinizi qeyd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapiš dnešní váhu, aby graf pokroku zůstal přesný."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag dein heutiges Gewicht ein, damit dein Fortschrittsdiagramm genau bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu peso de hoy para que tu gráfico de progreso sea preciso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre ton poids du jour pour que ton graphique de progression reste précis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना प्रगति चार्ट सटीक रखने के लिए आज का वज़न लॉग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra il peso di oggi per mantenere preciso il grafico dei progressi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進捗グラフを正確に保つため、今日の体重を記録しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 차트를 정확하게 유지하려면 오늘의 체중을 기록하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log je gewicht van vandaag zodat je voortgangsgrafiek klopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dzisiejszą wagę, aby wykres postępów był dokładny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seu peso de hoje para manter seu gráfico de progresso preciso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează greutatea de azi ca graficul progresului să rămână corect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите сегодняшний вес, чтобы график прогресса оставался точным."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerleme grafiğinizin doğru kalması için bugünkü kilonuzu kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть сьогоднішню вагу, щоб графік прогресу залишався точним."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录今天的体重，让进度图表保持准确。"
          }
        }
      }
    },
