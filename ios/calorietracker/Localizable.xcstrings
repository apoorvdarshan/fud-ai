    "Classic endurance scale tied to breathing, fatigue, and heart rate.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala clásica de resistencia ligada a la respiración, la fatiga y la frecuencia cardíaca."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقياس تحمّل كلاسيكي مرتبط بالتنفس والتعب ومعدل ضربات القلب."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nəfəs, yorğunluq və ürək döyüntüsü ilə bağlı klassik dözümlülük şkalası."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasická vytrvalostní škála navázaná na dech, únavu a tepovou frekvenci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassische Ausdauerskala, gekoppelt an Atmung, Ermüdung und Herzfrequenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échelle d’endurance classique liée à la respiration, à la fatigue et à la fréquence cardiaque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साँस, थकान और हृदय गति से जुड़ा क्लासिक सहनशक्ति स्केल।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scala di resistenza classica legata a respirazione, fatica e frequenza cardiaca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呼吸、疲労、心拍数に基づく定番の持久系スケール。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호흡, 피로도, 심박수에 연관된 고전적인 지구력 척도입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klassieke duurschaal gekoppeld aan ademhaling, vermoeidheid en hartslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasyczna skala wytrzymałościowa powiązana z oddechem, zmęczeniem i tętnem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala clássica de resistência ligada à respiração, ao cansaço e à frequência cardíaca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scală clasică de anduranță legată de respirație, oboseală și ritmul cardiac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Классическая шкала выносливости, связанная с дыханием, усталостью и пульсом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nefes, yorgunluk ve kalp atış hızına bağlı klasik dayanıklılık ölçeği."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
