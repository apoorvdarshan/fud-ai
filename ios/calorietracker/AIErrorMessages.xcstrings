{
  "sourceLanguage": "en",
  "strings": {
    "ai.error.no_key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No API key configured. Add your key in Settings → AI Provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave API configurada. Añade tu clave en Ajustes → Proveedor de IA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ API не налаштовано. Додайте ключ у Налаштування → Провайдер ШІ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı yapılandırılmadı. Anahtarınızı Ayarlar → Yapay Zeka Sağlayıcısı'ndan ekleyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد مفتاح API. أضف مفتاحك في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "API açarı təyin edilməyib. Açarınızı Ayarlar → AI Təminatçısı bölməsində əlavə edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není nastavený žádný API klíč. Přidej svůj API klíč v Nastavení → Poskytovatel AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein API-Schlüssel eingerichtet. Füge deinen Schlüssel unter Einstellungen → KI-Anbieter hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé API configurée. Ajoute ta clé dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई API कुंजी सेट नहीं है। सेटिंग्स → AI प्रदाता में अपनी कुंजी जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiave API configurata. Aggiungi la tua chiave in Impostazioni → Fornitore IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーが設定されていません。設定 → AIプロバイダ でキーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키가 설정되지 않았습니다. 설정 → AI 제공자에서 키를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen API-sleutel ingesteld. Voeg je sleutel toe via Instellingen → AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie skonfigurowano klucza API. Dodaj klucz w Ustawienia → Dostawca AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma chave de API configurada. Adicione sua chave em Ajustes → Provedor de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu este configurată nicio cheie API. Adaugă cheia în Setări → Furnizor AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API-ключ не настроен. Добавьте ключ в разделе «Настройки» → «Поставщик ИИ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未配置 API 密钥。请在“设置 → AI 提供商”中添加密钥。"
          }
        }
      }
    },
    "ai.error.image_conversion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to process the image. Try another photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo procesar la imagen. Prueba con otra foto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося обробити зображення. Спробуйте інше фото."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel işlenemedi. Başka bir fotoğraf deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت معالجة الصورة. جرّب صورة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şəkli emal etmək mümkün olmadı. Başqa foto sınayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázek se nepodařilo zpracovat. Zkus jinou fotku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte nicht verarbeitet werden. Versuche ein anderes Foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de traiter l’image. Essayez une autre photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि प्रोसेस नहीं हो सकी। कोई दूसरी फ़ोटो आज़माएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile elaborare l’immagine. Prova un’altra foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を処理できませんでした。別の写真を試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 처리하지 못했습니다. 다른 사진을 사용해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De afbeelding kon niet worden verwerkt. Probeer een andere foto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się przetworzyć obrazu. Spróbuj innego zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível processar a imagem. Tente outra foto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginea nu a putut fi procesată. Încearcă altă fotografie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обработать изображение. Попробуйте другое фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法处理该图片。请换一张照片。"
          }
        }
      }
    },
    "ai.error.invalid_response": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not understand the AI response. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo entender la respuesta de la IA. Inténtalo de nuevo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося розібрати відповідь ШІ. Спробуйте ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka yanıtı anlaşılamadı. Lütfen tekrar deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فهم رد الذكاء الاصطناعي. يُرجى المحاولة مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "AI cavabını anlamaq mümkün olmadı. Yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi AI se nepodařilo porozumět. Zkus to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Antwort konnte nicht gelesen werden. Bitte versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de comprendre la réponse de l’IA. Réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI का जवाब समझ नहीं आया। कृपया फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile interpretare la risposta dell’IA. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIの応答を解析できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 응답을 이해할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AI-antwoord kon niet worden gelezen. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zrozumieć odpowiedzi AI. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível entender a resposta da IA. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsul AI nu a putut fi înțeles. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось разобрать ответ ИИ. Попробуйте ещё раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法理解 AI 的回复。请重试。"
          }
        }
      }
    },
    "ai.error.invalid_url": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid API URL. Check your provider settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "URL de la API no válida. Revisa los ajustes de tu proveedor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недійсна URL-адреса API. Перевірте налаштування провайдера."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz API URL'si. Sağlayıcı ayarlarınızı kontrol edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان URL لواجهة API غير صالح. تحقق من إعدادات المزود."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanlış API URL-i. Təminatçı ayarlarınızı yoxlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neplatná URL adresa API. Zkontroluj nastavení poskytovatele."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige API-URL. Prüfe deine Anbietereinstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL d’API non valide. Vérifiez les réglages de votre fournisseur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमान्य API URL। अपनी प्रदाता सेटिंग्स जाँचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "URL dell’API non valido. Controlla le impostazioni del fornitore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API URLが無効です。プロバイダの設定を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API URL이 올바르지 않습니다. 제공자 설정을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeldige API-URL. Controleer je providerinstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowy adres URL API. Sprawdź ustawienia dostawcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "URL da API inválida. Verifique as configurações do provedor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "URL API nevalid. Verifică setările furnizorului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный URL API. Проверьте настройки провайдера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API URL 无效。请检查提供商设置。"
          }
        }
      }
    },
    "ai.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que no tienes conexión. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, ви офлайн. Перевірте з'єднання та спробуйте ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı görünüyorsunuz. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أنك غير متصل بالإنترنت. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Deyəsən, oflayn rejimdəsiniz. Bağlantınızı yoxlayıb yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypadá to, že jsi offline. Zkontroluj připojení a zkus to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du scheinst offline zu sein. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous semblez hors ligne. Vérifiez votre connexion et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगता है आप ऑफ़लाइन हैं। अपना कनेक्शन जाँचें और फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che tu sia offline. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインのようです。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태인 것 같습니다. 연결을 확인한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je lijkt offline te zijn. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że jesteś offline. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que você está offline. Verifique sua conexão e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pare că ești offline. Verifică-ți conexiunea și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, вы не в сети. Проверьте подключение и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你似乎处于离线状态。请检查网络连接后重试。"
          }
        }
      }
    },
    "ai.error.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not connect to the AI provider. Check your connection and provider URL, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el proveedor de IA. Revisa tu conexión y la URL del proveedor, e inténtalo de nuevo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підключитися до провайдера ШІ. Перевірте з'єднання та URL провайдера, потім спробуйте ще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka sağlayıcısına bağlanılamadı. Bağlantınızı ve sağlayıcı URL'nizi kontrol edip tekrar deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال بمزود الذكاء الاصطناعي. تحقق من اتصالك ومن عنوان URL للمزود، ثم حاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "AI təminatçısına qoşulmaq mümkün olmadı. Bağlantınızı və təminatçı URL-ini yoxlayın, sonra yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nepodařilo se připojit k poskytovateli AI. Zkontroluj připojení a URL poskytovatele a zkus to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum KI-Anbieter fehlgeschlagen. Prüfe deine Verbindung und die Anbieter-URL und versuche es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter au fournisseur d’IA. Vérifiez votre connexion et l’URL du fournisseur, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI प्रदाता से कनेक्ट नहीं हो सका। अपना कनेक्शन और प्रदाता URL जाँचें, फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile connettersi al fornitore IA. Controlla la connessione e l’URL del fornitore, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIプロバイダに接続できませんでした。接続とプロバイダのURLを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 제공자에 연결할 수 없습니다. 연결과 제공자 URL을 확인한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon geen verbinding maken met de AI-provider. Controleer je verbinding en de provider-URL en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z dostawcą AI. Sprawdź połączenie i adres URL dostawcy, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível conectar ao provedor de IA. Verifique sua conexão e a URL do provedor e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut realiza conexiunea cu furnizorul AI. Verifică-ți conexiunea și URL-ul furnizorului, apoi încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к провайдеру ИИ. Проверьте подключение и URL провайдера, затем повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 AI 提供商。请检查网络连接和提供商 URL，然后重试。"
          }
        }
      }
    },
    "ai.error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI took too long to respond. Try again, or raise the request timeout in Settings → AI Provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA tardó demasiado en responder. Inténtalo de nuevo o aumenta el tiempo de espera de la solicitud en Ajustes → Proveedor de IA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ШІ занадто довго відповідав. Спробуйте ще раз або збільште тайм-аут запиту в Налаштування → Провайдер ШІ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka yanıt vermek için çok uzun sürdü. Tekrar deneyin veya Ayarlar → Yapay Zeka Sağlayıcısı'ndan istek zaman aşımını artırın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق الذكاء الاصطناعي وقتًا طويلًا للرد. حاول مرة أخرى، أو زِد مهلة الطلب في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "AI cavab vermək üçün çox vaxt sərf etdi. Yenidən cəhd edin və ya Parametrlər → AI Təminatçısı bölməsində sorğu vaxt limitini artırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI odpovídala příliš dlouho. Zkus to znovu, nebo zvyš časový limit požadavku v Nastavení → Poskytovatel AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI hat zu lange gebraucht. Versuche es erneut oder erhöhe das Anfrage-Timeout unter Einstellungen → KI-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA a mis trop de temps à répondre. Réessayez ou augmentez le délai de requête dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ने जवाब देने में बहुत समय लिया। फिर से कोशिश करें, या सेटिंग्स → AI प्रदाता में अनुरोध टाइमआउट बढ़ाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA ha impiegato troppo a rispondere. Riprova oppure aumenta il timeout della richiesta in Impostazioni → Fornitore IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIの応答に時間がかかりすぎました。もう一度試すか、設定 → AIプロバイダでリクエストのタイムアウトを延ばしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 응답 시간이 너무 오래 걸렸습니다. 다시 시도하거나 설정 → AI 제공자에서 요청 제한 시간을 늘리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI deed er te lang over om te antwoorden. Probeer het opnieuw of verhoog de time-out in Instellingen → AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI odpowiadało zbyt długo. Spróbuj ponownie lub zwiększ limit czasu żądania w Ustawienia → Dostawca AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA demorou demais para responder. Tente novamente ou aumente o tempo limite em Ajustes → Provedor de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-ul a răspuns prea greu. Încearcă din nou sau mărește limita de timp a solicitării în Setări → Furnizor AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ отвечал слишком долго. Повторите попытку или увеличьте тайм-аут запроса в «Настройки → Поставщик ИИ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 响应时间过长。请重试，或在“设置 → AI 提供商”中延长请求超时时间。"
          }
        }
      }
    },
    "ai.error.credits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your AI account is out of credits. Top up, or switch provider in Settings → AI Provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta de IA se quedó sin créditos. Recarga saldo o cambia de proveedor en Ajustes → Proveedor de IA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На вашому обліковому записі ШІ закінчилися кредити. Поповніть баланс або змініть провайдера в Налаштування → Провайдер ШІ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka hesabınızın kredisi bitti. Kredi yükleyin veya Ayarlar → Yapay Zeka Sağlayıcısı'ndan sağlayıcı değiştirin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفد رصيد حسابك لدى مزود الذكاء الاصطناعي. اشحن الرصيد، أو غيّر المزود في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "AI hesabınızda kredit qalmayıb. Balansı artırın və ya Parametrlər → AI Təminatçısı bölməsində təminatçını dəyişin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tvém AI účtu došly kredity. Dobij je, nebo změň poskytovatele v Nastavení → Poskytovatel AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein KI-Konto hat kein Guthaben mehr. Lade es auf oder wechsle den Anbieter unter Einstellungen → KI-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte d’IA n’a plus de crédits. Rechargez-le ou changez de fournisseur dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके AI खाते के क्रेडिट खत्म हो गए हैं। टॉप अप करें, या सेटिंग्स → AI प्रदाता में प्रदाता बदलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account IA ha esaurito i crediti. Ricarica oppure cambia fornitore in Impostazioni → Fornitore IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアカウントのクレジットが不足しています。チャージするか、設定 → AIプロバイダでプロバイダを切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 계정의 크레딧이 소진되었습니다. 충전하거나 설정 → AI 제공자에서 제공자를 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je AI-account heeft geen tegoed meer. Waardeer op of kies een andere provider in Instellingen → AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Twoim koncie AI skończyły się kredyty. Doładuj je lub zmień dostawcę w Ustawienia → Dostawca AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta de IA ficou sem créditos. Recarregue ou troque de provedor em Ajustes → Provedor de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Contul tău AI a rămas fără credite. Reîncarcă sau schimbă furnizorul în Setări → Furnizor AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На аккаунте ИИ закончились кредиты. Пополните баланс или смените провайдера в «Настройки → Поставщик ИИ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 AI 账户点数已用完。请充值，或在“设置 → AI 提供商”中切换提供商。"
          }
        }
      }
    },
    "ai.error.daily_quota": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your AI account’s daily quota is used up. Try again tomorrow, or switch provider in Settings → AI Provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó la cuota diaria de tu cuenta de IA. Inténtalo de nuevo mañana o cambia de proveedor en Ajustes → Proveedor de IA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоденну квоту вашого облікового запису ШІ вичерпано. Спробуйте завтра або змініть провайдера в Налаштування → Провайдер ШІ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka hesabınızın günlük kotası doldu. Yarın tekrar deneyin veya Ayarlar → Yapay Zeka Sağlayıcısı'ndan sağlayıcı değiştirin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استهلاك الحصة اليومية لحسابك لدى مزود الذكاء الاصطناعي. حاول غدًا، أو غيّر المزود في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "AI hesabınızın gündəlik limiti bitib. Sabah yenidən cəhd edin və ya Parametrlər → AI Təminatçısı bölməsində təminatçını dəyişin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Denní kvóta tvého AI účtu je vyčerpaná. Zkus to zítra, nebo změň poskytovatele v Nastavení → Poskytovatel AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tageskontingent deines KI-Kontos ist aufgebraucht. Versuche es morgen erneut oder wechsle den Anbieter unter Einstellungen → KI-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota quotidien de votre compte d’IA est épuisé. Réessayez demain ou changez de fournisseur dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके AI खाते का दैनिक कोटा खत्म हो गया है। कल फिर कोशिश करें, या सेटिंग्स → AI प्रदाता में प्रदाता बदलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota giornaliera del tuo account IA è esaurita. Riprova domani oppure cambia fornitore in Impostazioni → Fornitore IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアカウントの1日の割り当てを使い切りました。明日もう一度試すか、設定 → AIプロバイダでプロバイダを切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 계정의 일일 할당량을 모두 사용했습니다. 내일 다시 시도하거나 설정 → AI 제공자에서 제공자를 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het dagelijkse quotum van je AI-account is op. Probeer het morgen opnieuw of kies een andere provider in Instellingen → AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzienny limit Twojego konta AI został wykorzystany. Spróbuj jutro lub zmień dostawcę w Ustawienia → Dostawca AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota diária da sua conta de IA acabou. Tente amanhã ou troque de provedor em Ajustes → Provedor de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cota zilnică a contului tău AI s-a epuizat. Încearcă mâine sau schimbă furnizorul în Setări → Furnizor AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневная квота аккаунта ИИ исчерпана. Попробуйте завтра или смените провайдера в «Настройки → Поставщик ИИ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 AI 账户今日配额已用完。请明天再试，或在“设置 → AI 提供商”中切换提供商。"
          }
        }
      }
    },
    "ai.error.quota": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your AI account’s usage quota was exceeded. Check your provider’s limits, or switch provider in Settings → AI Provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se superó la cuota de uso de tu cuenta de IA. Revisa los límites de tu proveedor o cambia de proveedor en Ajustes → Proveedor de IA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевищено квоту використання вашого облікового запису ШІ. Перевірте ліміти провайдера або змініть провайдера в Налаштування → Провайдер ШІ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka hesabınızın kullanım kotası aşıldı. Sağlayıcınızın sınırlarını kontrol edin veya Ayarlar → Yapay Zeka Sağlayıcısı'ndan sağlayıcı değiştirin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تجاوز حصة الاستخدام لحسابك لدى مزود الذكاء الاصطناعي. تحقق من حدود المزود، أو غيّر المزود في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "AI hesabınızın istifadə limiti aşılıb. Təminatçının limitlərini yoxlayın və ya Parametrlər → AI Təminatçısı bölməsində təminatçını dəyişin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kvóta využití tvého AI účtu byla překročena. Zkontroluj limity poskytovatele, nebo ho změň v Nastavení → Poskytovatel AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Nutzungskontingent deines KI-Kontos wurde überschritten. Prüfe die Limits deines Anbieters oder wechsle den Anbieter unter Einstellungen → KI-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quota d’utilisation de votre compte d’IA a été dépassé. Vérifiez les limites de votre fournisseur ou changez-en dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके AI खाते का उपयोग कोटा पार हो गया है। अपने प्रदाता की सीमाएँ जाँचें, या सेटिंग्स → AI प्रदाता में प्रदाता बदलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La quota di utilizzo del tuo account IA è stata superata. Controlla i limiti del fornitore oppure cambialo in Impostazioni → Fornitore IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIアカウントの使用量の上限を超えました。プロバイダの制限を確認するか、設定 → AIプロバイダでプロバイダを切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 계정의 사용 할당량을 초과했습니다. 제공자의 한도를 확인하거나 설정 → AI 제공자에서 제공자를 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gebruiksquotum van je AI-account is overschreden. Controleer de limieten van je provider of kies een andere in Instellingen → AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekroczono limit użycia Twojego konta AI. Sprawdź limity dostawcy lub zmień go w Ustawienia → Dostawca AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cota de uso da sua conta de IA foi excedida. Verifique os limites do provedor ou troque de provedor em Ajustes → Provedor de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cota de utilizare a contului tău AI a fost depășită. Verifică limitele furnizorului sau schimbă-l în Setări → Furnizor AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Квота использования аккаунта ИИ превышена. Проверьте лимиты провайдера или смените его в «Настройки → Поставщик ИИ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 AI 账户已超出用量配额。请检查提供商的限制，或在“设置 → AI 提供商”中切换提供商。"
          }
        }
      }
    },
    "ai.error.model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected model or API endpoint is unavailable. Check the model and API URL in Settings → AI Provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo o el endpoint de la API seleccionado no está disponible. Revisa el modelo y la URL de la API en Ajustes → Proveedor de IA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрана модель або кінцева точка API недоступна. Перевірте модель і URL API в Налаштування → Провайдер ШІ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen model veya API uç noktası kullanılamıyor. Ayarlar → Yapay Zeka Sağlayıcısı'ndan modeli ve API URL'sini kontrol edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النموذج المحدد أو نقطة نهاية API غير متاحة. تحقق من النموذج وعنوان URL لواجهة API في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilmiş model və ya API son nöqtəsi əlçatan deyil. Parametrlər → AI Təminatçısı bölməsində modeli və API URL-ini yoxlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybraný model nebo koncový bod API není dostupný. Zkontroluj model a URL API v Nastavení → Poskytovatel AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Modell oder der API-Endpunkt ist nicht verfügbar. Prüfe Modell und API-URL unter Einstellungen → KI-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle sélectionné ou le point d’accès de l’API est indisponible. Vérifiez le modèle et l’URL de l’API dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुना गया मॉडल या API एंडपॉइंट उपलब्ध नहीं है। सेटिंग्स → AI प्रदाता में मॉडल और API URL जाँचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello selezionato o l’endpoint dell’API non è disponibile. Controlla modello e URL dell’API in Impostazioni → Fornitore IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したモデルまたはAPIエンドポイントを利用できません。設定 → AIプロバイダでモデルとAPI URLを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 모델 또는 API 엔드포인트를 사용할 수 없습니다. 설정 → AI 제공자에서 모델과 API URL을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geselecteerde model of API-eindpunt is niet beschikbaar. Controleer het model en de API-URL in Instellingen → AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany model lub punkt końcowy API jest niedostępny. Sprawdź model i adres URL API w Ustawienia → Dostawca AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo selecionado ou o endpoint da API não está disponível. Verifique o modelo e a URL da API em Ajustes → Provedor de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul selectat sau endpointul API nu este disponibil. Verifică modelul și URL-ul API în Setări → Furnizor AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная модель или конечная точка API недоступна. Проверьте модель и URL API в «Настройки → Поставщик ИИ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选模型或 API 端点不可用。请在“设置 → AI 提供商”中检查模型和 API URL。"
          }
        }
      }
    },
    "ai.error.rate_limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate limit hit on your API key. Wait a minute, or switch provider in Settings → AI Provider. If you use a free tier, check whether its daily quota is used up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el límite de solicitudes de tu clave API. Espera un minuto o cambia de proveedor en Ajustes → Proveedor de IA. Si usas un plan gratuito, comprueba si se agotó su cuota diaria."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Досягнуто ліміт запитів для вашого ключа API. Зачекайте хвилину або змініть провайдера в Налаштування → Провайдер ШІ. Якщо ви використовуєте безкоштовний тариф, перевірте, чи не вичерпано щоденну квоту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarınızda hız sınırına ulaşıldı. Bir dakika bekleyin veya Ayarlar → Yapay Zeka Sağlayıcısı'ndan sağlayıcı değiştirin. Ücretsiz katman kullanıyorsanız günlük kotasının dolup dolmadığını kontrol edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بلوغ حد المعدل لمفتاح API الخاص بك. انتظر دقيقة، أو غيّر المزود في الإعدادات ← مزود الذكاء الاصطناعي. إذا كنت تستخدم فئة مجانية، فتحقق مما إذا كانت حصتها اليومية قد استُهلكت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "API açarınız sorğu limitinə çatdı. Bir dəqiqə gözləyin və ya Parametrlər → AI Təminatçısı bölməsində təminatçını dəyişin. Pulsuz plandan istifadə edirsinizsə, gündəlik limitin bitib-bitmədiyini yoxlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj API klíč narazil na limit počtu požadavků. Počkej minutu, nebo změň poskytovatele v Nastavení → Poskytovatel AI. Pokud používáš bezplatnou úroveň, zkontroluj, zda není vyčerpaná její denní kvóta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anfragelimit für deinen API-Schlüssel wurde erreicht. Warte eine Minute oder wechsle den Anbieter unter Einstellungen → KI-Anbieter. Wenn du eine kostenlose Stufe nutzt, prüfe, ob das Tageskontingent aufgebraucht ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de requêtes atteinte pour votre clé API. Patientez une minute ou changez de fournisseur dans Réglages → Fournisseur d’IA. Si vous utilisez une offre gratuite, vérifiez si son quota quotidien est épuisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी API कुंजी की रेट लिमिट पूरी हो गई है। एक मिनट रुकें, या सेटिंग्स → AI प्रदाता में प्रदाता बदलें। अगर आप फ़्री टियर इस्तेमाल करते हैं, तो जाँचें कि उसका दैनिक कोटा खत्म तो नहीं हुआ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite di richieste raggiunto per la tua chiave API. Attendi un minuto oppure cambia fornitore in Impostazioni → Fornitore IA. Se usi un piano gratuito, verifica se la quota giornaliera è esaurita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーのレート制限に達しました。1分待つか、設定 → AIプロバイダでプロバイダを切り替えてください。無料枠を利用している場合は、1日の割り当てを使い切っていないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키의 요청 한도에 도달했습니다. 1분 기다리거나 설정 → AI 제공자에서 제공자를 변경하세요. 무료 등급을 사용 중이라면 일일 할당량을 모두 썼는지 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je API-sleutel heeft de limiet bereikt. Wacht een minuut of kies een andere provider in Instellingen → AI-provider. Gebruik je een gratis abonnement, controleer dan of het dagelijkse quotum op is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto limit żądań dla Twojego klucza API. Odczekaj minutę lub zmień dostawcę w Ustawienia → Dostawca AI. Jeśli korzystasz z darmowego planu, sprawdź, czy dzienny limit nie został wykorzystany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave de API atingiu o limite de solicitações. Aguarde um minuto ou troque de provedor em Ajustes → Provedor de IA. Se você usa um plano gratuito, verifique se a cota diária acabou."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia ta API a atins limita de solicitări. Așteaptă un minut sau schimbă furnizorul în Setări → Furnizor AI. Dacă folosești un nivel gratuit, verifică dacă i s-a epuizat cota zilnică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вашего ключа API достигнут лимит запросов. Подождите минуту или смените провайдера в «Настройки → Поставщик ИИ». Если вы используете бесплатный тариф, проверьте, не исчерпана ли дневная квота."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 API 密钥已达到速率限制。请等待一分钟，或在“设置 → AI 提供商”中切换提供商。如果你使用的是免费套餐，请检查每日配额是否已用完。"
          }
        }
      }
    },
    "ai.error.key_rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your API key was rejected. Open Settings → AI Provider and re-paste a valid key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave API fue rechazada. Abre Ajustes → Proveedor de IA y vuelve a pegar una clave válida."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ API відхилено. Відкрийте Налаштування → Провайдер ШІ і вставте дійсний ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarınız reddedildi. Ayarlar → Yapay Zeka Sağlayıcısı'nı açın ve geçerli bir anahtarı yeniden yapıştırın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض مفتاح API الخاص بك. افتح الإعدادات ← مزود الذكاء الاصطناعي والصق مفتاحًا صالحًا مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "API açarınız rədd edildi. Parametrlər → AI Təminatçısı bölməsini açın və etibarlı açarı yenidən yapışdırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvůj API klíč byl odmítnut. Otevři Nastavení → Poskytovatel AI a znovu vlož platný klíč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein API-Schlüssel wurde abgelehnt. Öffne Einstellungen → KI-Anbieter und füge einen gültigen Schlüssel erneut ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé API a été refusée. Ouvrez Réglages → Fournisseur d’IA et collez à nouveau une clé valide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी API कुंजी अस्वीकार कर दी गई। सेटिंग्स → AI प्रदाता खोलें और एक मान्य कुंजी फिर से पेस्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave API è stata rifiutata. Apri Impostazioni → Fornitore IA e incolla di nuovo una chiave valida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーが拒否されました。設定 → AIプロバイダを開き、有効なキーを貼り付け直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키가 거부되었습니다. 설정 → AI 제공자를 열고 유효한 키를 다시 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je API-sleutel is geweigerd. Open Instellingen → AI-provider en plak opnieuw een geldige sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój klucz API został odrzucony. Otwórz Ustawienia → Dostawca AI i wklej ponownie prawidłowy klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave de API foi rejeitada. Abra Ajustes → Provedor de IA e cole novamente uma chave válida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheia ta API a fost respinsă. Deschide Setări → Furnizor AI și lipește din nou o cheie validă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ API отклонён. Откройте «Настройки → Поставщик ИИ» и снова вставьте действительный ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 API 密钥被拒绝。请打开“设置 → AI 提供商”，重新粘贴有效的密钥。"
          }
        }
      }
    },
    "ai.error.overloaded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI provider is overloaded right now. We retried a few times — try again in a minute, or switch provider/model in Settings → AI Provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor de IA está saturado en este momento. Lo reintentamos varias veces; inténtalo de nuevo en un minuto o cambia de proveedor o modelo en Ajustes → Proveedor de IA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер ШІ зараз перевантажений. Ми повторили кілька разів — спробуйте через хвилину або змініть провайдера/модель у Налаштування → Провайдер ШІ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka sağlayıcısı şu anda aşırı yüklü. Birkaç kez yeniden denedik — bir dakika sonra tekrar deneyin veya Ayarlar → Yapay Zeka Sağlayıcısı'ndan sağlayıcı/model değiştirin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزود الذكاء الاصطناعي مثقل الآن. أعدنا المحاولة عدة مرات — حاول بعد دقيقة، أو غيّر المزود/النموذج في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "AI təminatçısı hazırda həddən artıq yüklənib. Bir neçə dəfə yenidən cəhd etdik — bir dəqiqədən sonra yenidən cəhd edin və ya Parametrlər → AI Təminatçısı bölməsində təminatçını/modeli dəyişin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poskytovatel AI je teď přetížený. Několikrát jsme to zkusili znovu — zkus to za minutu, nebo změň poskytovatele či model v Nastavení → Poskytovatel AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der KI-Anbieter ist gerade überlastet. Wir haben es mehrmals versucht – probiere es in einer Minute erneut oder wechsle Anbieter/Modell unter Einstellungen → KI-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur d’IA est surchargé pour le moment. Nous avons réessayé plusieurs fois — réessayez dans une minute ou changez de fournisseur/modèle dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI प्रदाता अभी ओवरलोड है। हमने कुछ बार दोबारा कोशिश की — एक मिनट बाद फिर कोशिश करें, या सेटिंग्स → AI प्रदाता में प्रदाता/मॉडल बदलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il fornitore IA è sovraccarico in questo momento. Abbiamo riprovato alcune volte: riprova tra un minuto oppure cambia fornitore/modello in Impostazioni → Fornitore IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIプロバイダが現在混み合っています。数回再試行しました。1分後にもう一度試すか、設定 → AIプロバイダでプロバイダやモデルを切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 AI 제공자가 과부하 상태입니다. 몇 번 다시 시도했습니다. 1분 후 다시 시도하거나 설정 → AI 제공자에서 제공자/모델을 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI-provider is momenteel overbelast. We hebben het een paar keer opnieuw geprobeerd — probeer het over een minuut opnieuw of kies een andere provider/ander model in Instellingen → AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostawca AI jest teraz przeciążony. Ponowiliśmy próbę kilka razy — spróbuj za minutę lub zmień dostawcę/model w Ustawienia → Dostawca AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor de IA está sobrecarregado agora. Tentamos algumas vezes — tente de novo em um minuto ou troque de provedor/modelo em Ajustes → Provedor de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Furnizorul AI este suprasolicitat acum. Am reîncercat de câteva ori — încearcă din nou peste un minut sau schimbă furnizorul/modelul în Setări → Furnizor AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Провайдер ИИ сейчас перегружен. Мы повторили попытку несколько раз — попробуйте через минуту или смените провайдера/модель в «Настройки → Поставщик ИИ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 提供商当前负载过高。我们已重试数次——请一分钟后再试，或在“设置 → AI 提供商”中切换提供商/模型。"
          }
        }
      }
    },
    "ai.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI request failed. Try again, or switch provider in Settings → AI Provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud a la IA falló. Inténtalo de nuevo o cambia de proveedor en Ajustes → Proveedor de IA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит до ШІ не вдався. Спробуйте ще раз або змініть провайдера в Налаштування → Провайдер ШІ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka isteği başarısız oldu. Tekrar deneyin veya Ayarlar → Yapay Zeka Sağlayıcısı'ndan sağlayıcı değiştirin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل طلب الذكاء الاصطناعي. حاول مرة أخرى، أو غيّر المزود في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "AI sorğusu uğursuz oldu. Yenidən cəhd edin və ya Parametrlər → AI Təminatçısı bölməsində təminatçını dəyişin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požadavek na AI selhal. Zkus to znovu, nebo změň poskytovatele v Nastavení → Poskytovatel AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Anfrage ist fehlgeschlagen. Versuche es erneut oder wechsle den Anbieter unter Einstellungen → KI-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête à l’IA a échoué. Réessayez ou changez de fournisseur dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI अनुरोध विफल हुआ। फिर से कोशिश करें, या सेटिंग्स → AI प्रदाता में प्रदाता बदलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta all’IA non è riuscita. Riprova oppure cambia fornitore in Impostazioni → Fornitore IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIリクエストに失敗しました。もう一度試すか、設定 → AIプロバイダでプロバイダを切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 요청에 실패했습니다. 다시 시도하거나 설정 → AI 제공자에서 제공자를 변경하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AI-verzoek is mislukt. Probeer het opnieuw of kies een andere provider in Instellingen → AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie do AI nie powiodło się. Spróbuj ponownie lub zmień dostawcę w Ustawienia → Dostawca AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação à IA falhou. Tente novamente ou troque de provedor em Ajustes → Provedor de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitarea AI a eșuat. Încearcă din nou sau schimbă furnizorul în Setări → Furnizor AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос к ИИ не выполнен. Повторите попытку или смените провайдера в «Настройки → Поставщик ИИ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 请求失败。请重试，或在“设置 → AI 提供商”中切换提供商。"
          }
        }
      }
    },
    "ai.error.local_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device AI runtime is unavailable. Check the downloaded model in Settings → AI Provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de IA en el dispositivo no está disponible. Revisa el modelo descargado en Ajustes → Proveedor de IA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальне середовище ШІ недоступне. Перевірте завантажену модель у Налаштування → Провайдер ШІ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz üzerindeki yapay zeka çalışma zamanı kullanılamıyor. Ayarlar → Yapay Zeka Sağlayıcısı'ndan indirilen modeli kontrol edin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيئة تشغيل الذكاء الاصطناعي على الجهاز غير متاحة. تحقق من النموذج الذي تم تنزيله في الإعدادات ← مزود الذكاء الاصطناعي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazdaxili AI mühiti əlçatan deyil. Parametrlər → AI Təminatçısı bölməsində endirilmiş modeli yoxlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostředí AI v zařízení není dostupné. Zkontroluj stažený model v Nastavení → Poskytovatel AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Laufzeit auf dem Gerät ist nicht verfügbar. Prüfe das heruntergeladene Modell unter Einstellungen → KI-Anbieter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur d’IA sur l’appareil est indisponible. Vérifiez le modèle téléchargé dans Réglages → Fournisseur d’IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑन-डिवाइस AI रनटाइम उपलब्ध नहीं है। सेटिंग्स → AI प्रदाता में डाउनलोड किया गया मॉडल जाँचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il runtime IA sul dispositivo non è disponibile. Controlla il modello scaricato in Impostazioni → Fornitore IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスAIのランタイムを利用できません。設定 → AIプロバイダでダウンロード済みのモデルを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온디바이스 AI 런타임을 사용할 수 없습니다. 설정 → AI 제공자에서 다운로드한 모델을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De AI-runtime op het apparaat is niet beschikbaar. Controleer het gedownloade model in Instellingen → AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Środowisko AI na urządzeniu jest niedostępne. Sprawdź pobrany model w Ustawienia → Dostawca AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente de IA no dispositivo não está disponível. Verifique o modelo baixado em Ajustes → Provedor de IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediul AI de pe dispozitiv nu este disponibil. Verifică modelul descărcat în Setări → Furnizor AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среда ИИ на устройстве недоступна. Проверьте загруженную модель в «Настройки → Поставщик ИИ»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端 AI 运行环境不可用。请在“设置 → AI 提供商”中检查已下载的模型。"
          }
        }
      }
    },
    "ai.error.unsupported_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence requires iOS 26 or later on a supported iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence requiere iOS 26 o posterior en un iPhone compatible."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence потребує iOS 26 або новішої версії на підтримуваному iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence, desteklenen bir iPhone'da iOS 26 veya üzerini gerektirir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب Apple Intelligence نظام iOS 26 أو أحدث على iPhone مدعوم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dəstəklənən iPhone-da iOS 26 və ya daha yenisini tələb edir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence vyžaduje iOS 26 nebo novější na podporovaném iPhonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence erfordert iOS 26 oder neuer auf einem unterstützten iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence nécessite iOS 26 ou version ultérieure sur un iPhone compatible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence के लिए समर्थित iPhone पर iOS 26 या उसके बाद का संस्करण चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence richiede iOS 26 o versioni successive su un iPhone supportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceには、対応するiPhoneでiOS 26以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence를 사용하려면 지원되는 iPhone에서 iOS 26 이상이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence vereist iOS 26 of nieuwer op een ondersteunde iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wymaga iOS 26 lub nowszego na obsługiwanym iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple Intelligence requer iOS 26 ou posterior em um iPhone compatível."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence necesită iOS 26 sau o versiune ulterioară pe un iPhone compatibil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Apple Intelligence требуется iOS 26 или новее на поддерживаемом iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能需要在受支持的 iPhone 上运行 iOS 26 或更高版本。"
          }
        }
      }
    },
    "ai.error.truncated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI response was truncated twice. Try a shorter input or another model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta de la IA se cortó dos veces. Prueba con un texto más corto o con otro modelo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь ШІ двічі обрізано. Спробуйте коротший ввід або іншу модель."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zeka yanıtı iki kez kesildi. Daha kısa bir girdi veya başka bir model deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اقتطاع رد الذكاء الاصطناعي مرتين. جرّب إدخالًا أقصر أو نموذجًا آخر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "AI cavabı iki dəfə kəsildi. Daha qısa məlumat və ya başqa model sınayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpověď AI byla dvakrát useknuta. Zkus kratší vstup nebo jiný model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Antwort wurde zweimal abgeschnitten. Versuche eine kürzere Eingabe oder ein anderes Modell."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de l’IA a été tronquée deux fois. Essayez une saisie plus courte ou un autre modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI का जवाब दो बार अधूरा कट गया। छोटा इनपुट या कोई दूसरा मॉडल आज़माएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta dell’IA è stata troncata due volte. Prova un input più breve o un altro modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIの応答が2回途中で切れました。入力を短くするか、別のモデルを試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 응답이 두 번 잘렸습니다. 더 짧게 입력하거나 다른 모델을 사용해 보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het AI-antwoord is twee keer afgekapt. Probeer een kortere invoer of een ander model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedź AI została dwukrotnie ucięta. Spróbuj krótszego tekstu lub innego modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta da IA foi cortada duas vezes. Tente uma entrada mais curta ou outro modelo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsul AI a fost trunchiat de două ori. Încearcă un text mai scurt sau alt model."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ ИИ дважды оборвался. Попробуйте более короткий ввод или другую модель."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 响应两次被截断。请尝试更短的输入或换一个模型。"
          }
        }
      }
    },
    "ai.error.text_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
