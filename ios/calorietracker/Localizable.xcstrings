    "Only workout burns calculated in Fud AI are shown. Workouts without a burn estimate are not included.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم عرض حرق السعرات الذي حسبه Fud AI فقط. لا تُدرج التمارين التي لا يتوفر لها تقدير للحرق."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnız Fud AI-da hesablanmış məşq sərfiyyatları göstərilir. Sərfiyyat təxmini olmayan məşqlər daxil edilmir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur der in Fud AI berechnete Trainingsverbrauch angezeigt. Trainings ohne Verbrauchsschätzung werden nicht berücksichtigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only workout burns calculated in Fud AI are shown. Workouts without a burn estimate are not included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran las calorías de entrenamiento calculadas en Fud AI. No se incluyen los entrenamientos sin una estimación de gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les dépenses d’entraînement calculées dans Fud AI sont affichées. Les entraînements sans estimation ne sont pas inclus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल Fud AI में गणना की गई वर्कआउट कैलोरी दिखाई जाती हैं। जिन वर्कआउट के लिए बर्न का अनुमान नहीं है, वे शामिल नहीं होते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene mostrato solo il consumo degli allenamenti calcolato in Fud AI. Gli allenamenti senza una stima non sono inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AIで計算されたワークアウトの消費量のみ表示されます。消費量の推定がないワークアウトは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI에서 계산한 운동 소모량만 표시됩니다. 소모량 추정치가 없는 운동은 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het trainingsverbruik dat in Fud AI is berekend, wordt getoond. Trainingen zonder schatting worden niet meegenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlane jest tylko spalanie treningowe obliczone w Fud AI. Treningi bez oszacowanego spalania nie są uwzględniane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o gasto dos treinos calculado no Fud AI é exibido. Treinos sem estimativa de gasto não são incluídos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt afișate doar consumurile antrenamentelor calculate în Fud AI. Antrenamentele fără estimare nu sunt incluse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается только расход на тренировках, рассчитанный в Fud AI. Тренировки без оценки расхода не учитываются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображается только расход на тренировках, рассчитанний в Fud AI. Тренировки без оценки расхода не учитиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示 Fud AI 计算出的锻炼消耗。没有消耗估算的锻炼不会包含在内。"
          }
        }
      }
    },
