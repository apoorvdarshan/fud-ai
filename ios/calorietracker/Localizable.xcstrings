    "Remove %@ from your sensitivities?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %@ de tus sensibilidades?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة %@ من حالات الحساسية لديك؟"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ həssaslıqlarınızdan silinsin?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat %@ z tvých citlivostí?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aus deinen Empfindlichkeiten entfernen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %@ de vos sensibilités ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को अपनी संवेदनशीलताओं से हटाएं?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %@ dalle tue sensibilità?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を過敏症から削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감도 목록에서 %@을(를) 삭제할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uit je gevoeligheden verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć %@ z Twoich wrażliwości?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %@ das suas sensibilidades?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimini %@ din sensibilitățile tale?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %@ из списка чувствительности?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hassasiyetlerinizden kaldırılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити %@ зі списку чутливості?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从你的敏感项中移除%@吗？"
          }
        }
      }
    },
