    "Saves this day's exercises with their planned sets, reps and weights.": {
      "comment": "Explains what Save Routine stores.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ تمارين هذا اليوم مع المجموعات والتكرارات والأوزان المخطط لها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günün məşqlərini planlaşdırılmış setləri, təkrarları və çəkiləri ilə saxlayır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží cviky tohoto dne s plánovanými sériemi, opakováními a váhami."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert die Übungen dieses Tages mit ihren geplanten Sätzen, Wiederholungen und Gewichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves this day's exercises with their planned sets, reps and weights."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los ejercicios de este día con sus series, repeticiones y pesos planificados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les exercices de ce jour avec leurs séries, répétitions et charges prévues."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दिन के व्यायाम उनके नियोजित सेट, रेप्स और वज़न के साथ सहेजता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva gli esercizi di questo giorno con serie, ripetizioni e carichi pianificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日の種目を、予定のセット・回数・重量とともに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날의 운동을 계획한 세트, 반복 횟수, 무게와 함께 저장합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slaat de oefeningen van deze dag op met hun geplande sets, herhalingen en gewichten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje ćwiczenia z tego dnia wraz z zaplanowanymi seriami, powtórzeniami i ciężarami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva os exercícios deste dia com as séries, repetições e cargas planejadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvează exercițiile din această zi cu seriile, repetările și greutățile planificate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет упражнения этого дня с запланированными подходами, повторами и весами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günün egzersizlerini planlanan set, tekrar ve ağırlıklarıyla kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає вправи цього дня із запланованими підходами, повтореннями та вагою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存这一天的动作及其计划组数、次数和重量。"
          }
        }
      }
    },
