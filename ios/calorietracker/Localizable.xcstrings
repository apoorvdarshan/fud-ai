    "These methods appear directly under +, outside any group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هذه الطرق مباشرةً تحت +، خارج أي مجموعة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu üsullar heç bir qrupa daxil olmadan birbaşa + altında görünür."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyto metody se zobrazují přímo pod +, mimo skupiny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Methoden erscheinen direkt unter +, außerhalb von Gruppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos métodos aparecen directamente bajo +, fuera de cualquier grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces méthodes apparaissent directement sous +, hors de tout groupe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये तरीके किसी समूह के बाहर, सीधे + के नीचे दिखते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi metodi appaiono direttamente sotto +, fuori da qualsiasi gruppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの方法はグループに入らず、+ の直下に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 방법들은 그룹 없이 + 바로 아래에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze methoden staan direct onder +, buiten een groep."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te metody pojawiają się bezpośrednio pod +, poza grupami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes métodos aparecem diretamente no +, fora de qualquer grupo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceste metode apar direct sub +, în afara oricărui grup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти способы отображаются прямо в меню «+», вне групп."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yöntemler herhangi bir grubun dışında, doğrudan + altında görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці способи з’являються безпосередньо в меню «+», поза групами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些方式直接显示在 + 下，不属于任何分组。"
          }
        }
      }
    },
