    "Pick exactly four nutrients for the Home summary row.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أربعة عناصر غذائية بالضبط لصف الملخص في الشاشة الرئيسية."
          }
        },
        "az": {
          "stringUnit": {
