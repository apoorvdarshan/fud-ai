            "state": "translated",
            "value": "Не удалось разобрать ответ ИИ. Попробуйте ещё раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay zekâ yanıtı anlaşılamadı. Lütfen tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
