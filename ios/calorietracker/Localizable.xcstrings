          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene zeitbasierte Aktivität · Kalorienschätzung nutzt eine allgemeine Aktivitätsrate"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activité chronométrée personnalisée · l’estimation des calories utilise un taux d’activité général"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम समयबद्ध गतिविधि · कैलोरी अनुमान सामान्य गतिविधि दर का उपयोग करता है"
          }
        },
        "it": {
