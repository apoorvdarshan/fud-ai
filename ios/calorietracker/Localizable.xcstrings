    "Automatic answers in the language you speak.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الوضع التلقائي يرد المساعد باللغة التي تتحدث بها."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Avtomatik rejimdə köməkçi danışdığınız dildə cavab verir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky odpovídá v jazyce, kterým mluvíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch antwortet in der Sprache, die du sprichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático responde en el idioma en que hablas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique répond dans la langue que vous parlez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित मोड उसी भाषा में जवाब देता है जिसमें आप बोलते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico risponde nella lingua in cui parli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」では、話した言語で応答します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 사용자가 말하는 언어로 답합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch antwoordt in de taal die je spreekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb automatyczny odpowiada w języku, którym mówisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático responde no idioma em que você fala."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Automat răspunde în limba în care vorbești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В автоматическом режиме ассистент отвечает на языке, на котором вы говорите."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik, konuştuğunuz dilde yanıt verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "В автоматичному режимі асистент відповідає мовою, якою ви говорите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会用你说话的语言回复。"
          }
        }
      }
    },
    "Auto-capture Photos": {
