        "cs" : {"stringUnit": {"state": "translated", "value": "Budujte návyky, ne vyšší čísla"}},
        "de" : {"stringUnit": {"state": "translated", "value": "Gewohnheiten statt Rekorde aufbauen"}},
        "es" : {"stringUnit": {"state": "translated", "value": "Crea hábitos, no persigas cifras"}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Privilégiez les habitudes, pas les chiffres"}},
        "hi" : {"stringUnit": {"state": "translated", "value": "बड़े आँकड़े नहीं, अच्छी आदतें बनाएँ"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Coltiva le abitudini, non i numeri"}},
        "ja" : {"stringUnit": {"state": "translated", "value": "数字より習慣を育てよう"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "기록보다 습관을 쌓으세요"}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Bouw gewoonten op, geen hogere cijfers"}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Buduj nawyki, nie śrubuj wyników"}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Crie hábitos, não persiga números"}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Construiește obiceiuri, nu urmări cifre mai mari"}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Формируйте привычки, а не гонитесь за цифрами"}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Rakamları değil, alışkanlıkları geliştirin"}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Розвивайте звички, а не ганяйтеся за цифрами"}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "培养习惯，而不是追求更高数字"}}
      }
    },
    "Join Weekly to create your challenge profile first." : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "انضم إلى التحدي الأسبوعي لإنشاء ملفك أولًا."}},
        "az" : {"stringUnit": {"state": "translated", "value": "Əvvəlcə profil yaratmaq üçün həftəlik çağırışa qoşulun."}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Nejprve se připojte k týdenní výzvě a vytvořte si profil."}},
        "de" : {"stringUnit": {"state": "translated", "value": "Tritt zuerst der Wochenchallenge bei, um dein Profil zu erstellen."}},
        "es" : {"stringUnit": {"state": "translated", "value": "Únete primero al reto semanal para crear tu perfil."}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Participez d’abord au défi hebdomadaire pour créer votre profil."}},
        "hi" : {"stringUnit": {"state": "translated", "value": "प्रोफ़ाइल बनाने के लिए पहले साप्ताहिक चुनौती में शामिल हों।"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Partecipa prima alla sfida settimanale per creare il tuo profilo."}},
        "ja" : {"stringUnit": {"state": "translated", "value": "まず週間チャレンジに参加してプロフィールを作成してください。"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "먼저 주간 챌린지에 참여해 프로필을 만드세요."}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Doe eerst mee aan de weekuitdaging om een profiel te maken."}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Najpierw dołącz do wyzwania tygodniowego, aby utworzyć profil."}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Entre primeiro no desafio semanal para criar seu perfil."}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Participă întâi la provocarea săptămânală pentru a crea un profil."}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Сначала вступите в недельный челлендж, чтобы создать профиль."}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Profil oluşturmak için önce haftalık mücadeleye katılın."}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Спочатку долучіться до щотижневого виклику, щоб створити профіль."}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "请先加入每周挑战以创建挑战资料。"}}
      }
    },
    "This board needs an updated challenge service." : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "تتطلب هذه اللوحة تحديث خدمة التحديات."}},
        "az" : {"stringUnit": {"state": "translated", "value": "Bu cədvəl üçün çağırış xidməti yenilənməlidir."}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Tento žebříček vyžaduje aktualizovanou službu výzev."}},
        "de" : {"stringUnit": {"state": "translated", "value": "Diese Rangliste benötigt einen aktualisierten Challenge-Dienst."}},
        "es" : {"stringUnit": {"state": "translated", "value": "Esta clasificación requiere que se actualice el servicio de retos."}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Ce classement nécessite une mise à jour du service des défis."}},
        "hi" : {"stringUnit": {"state": "translated", "value": "इस लीडरबोर्ड के लिए चुनौती सेवा का अपडेट ज़रूरी है।"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Questa classifica richiede un aggiornamento del servizio."}},
        "ja" : {"stringUnit": {"state": "translated", "value": "このランキングにはチャレンジサービスの更新が必要です。"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "이 순위표를 사용하려면 챌린지 서비스 업데이트가 필요합니다."}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Voor dit klassement moet de uitdagingsdienst worden bijgewerkt."}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Ten ranking wymaga aktualizacji usługi wyzwań."}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Este ranking precisa de uma atualização do serviço de desafios."}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Acest clasament necesită actualizarea serviciului."}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Для этого рейтинга нужно обновление сервиса челленджей."}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Bu sıralama için mücadele hizmetinin güncellenmesi gerekiyor."}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Цей рейтинг потребує оновлення сервісу викликів."}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "此排行榜需要更新挑战服务。"}}
      }
    },
    "Joining shares your name and habit totals for this period with other participants. No diary entries, weight, or calorie amounts are shared." : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "عند الانضمام، يرى المشاركون اسمك ومجموع عاداتك لهذه الفترة. لا تُشارك سجلاتك أو وزنك أو كميات السعرات."}},
        "az" : {"stringUnit": {"state": "translated", "value": "Qoşulduqda adınız və bu dövrün vərdiş xalları digər iştirakçılara görünür. Gündəlik qeydləri, çəki və kalori miqdarları paylaşılmır."}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Po připojení ostatní vidí vaše jméno a souhrny návyků za dané období. Záznamy z deníku, váha ani množství kalorií se nesdílejí."}},
        "de" : {"stringUnit": {"state": "translated", "value": "Bei der Teilnahme sehen andere deinen Namen und die Gewohnheitssummen für diesen Zeitraum. Tagebucheinträge, Gewicht und Kalorienmengen bleiben privat."}},
        "es" : {"stringUnit": {"state": "translated", "value": "Al unirte, otros participantes ven tu nombre y los totales de hábitos del periodo. No se comparten tu diario, tu peso ni tus cantidades de calorías."}},
        "fr" : {"stringUnit": {"state": "translated", "value": "En participant, vous partagez votre nom et vos totaux d’habitudes pour cette période avec les autres participants. Ni le journal, ni le poids, ni les quantités de calories ne sont partagés."}},
        "hi" : {"stringUnit": {"state": "translated", "value": "शामिल होने पर आपका नाम और इस अवधि की आदतों के कुल अंक अन्य प्रतिभागियों को दिखेंगे। डायरी, वज़न या कैलोरी की मात्रा साझा नहीं होगी।"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Partecipando condividi il tuo nome e i totali delle abitudini di questo periodo. Le voci del diario, il peso e le calorie non vengono condivisi."}},
        "ja" : {"stringUnit": {"state": "translated", "value": "参加すると、この期間の名前と習慣の集計がほかの参加者に表示されます。日記、体重、カロリー量は共有されません。"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "참여하면 다른 참가자에게 이름과 이 기간의 습관 집계가 공개됩니다. 일지, 체중, 칼로리 양은 공유되지 않습니다."}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Als je meedoet, zien andere deelnemers je naam en gewoontetotalen voor deze periode. Dagboekgegevens, gewicht en caloriehoeveelheden blijven privé."}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Po dołączeniu inni uczestnicy zobaczą Twoją nazwę i sumy nawyków z tego okresu. Wpisy dziennika, waga i ilości kalorii nie są udostępniane."}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Ao participar, seu nome e seus totais de hábitos do período ficam visíveis para outros participantes. Diário, peso e quantidades de calorias não são compartilhados."}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Participarea partajează numele și totalurile obiceiurilor tale din această perioadă. Jurnalul, greutatea și cantitățile de calorii nu sunt partajate."}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Участники увидят ваше имя и суммарные результаты за период. Записи дневника, вес и количество калорий не передаются."}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Katılınca adınız ve bu dönemin alışkanlık toplamları diğer katılımcılara görünür. Günlük kayıtları, kilo ve kalori miktarları paylaşılmaz."}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Інші учасники побачать ваше ім’я та підсумки звичок за цей період. Записи щоденника, вага й кількість калорій не передаються."}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "加入后，其他参与者将看到你的名称及本时段的习惯汇总。不会共享日记条目、体重或热量数值。"}}
      }
    },
    "Earn one point per habit each day: movement, food logging, nutrition goal, and water goal." : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "احصل على نقطة لكل عادة يوميًا: الحركة وتسجيل الطعام وهدف التغذية وهدف الماء."}},
        "az" : {"stringUnit": {"state": "translated", "value": "Hər gün hər vərdişə bir xal: hərəkət, yemək qeydi, qidalanma və su hədəfləri."}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Každý den získáte bod za každý návyk: pohyb, záznam jídla, splnění cíle výživy a pitného režimu."}},
        "de" : {"stringUnit": {"state": "translated", "value": "Pro Tag gibt es je einen Punkt für Bewegung, Essensprotokoll, Ernährungsziel und Trinkziel."}},
        "es" : {"stringUnit": {"state": "translated", "value": "Gana un punto diario por cada hábito: moverte, registrar comida y cumplir tus metas de nutrición y agua."}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Gagnez un point par habitude chaque jour : bouger, noter les repas, atteindre l’objectif nutritionnel et l’objectif d’hydratation."}},
        "hi" : {"stringUnit": {"state": "translated", "value": "हर दिन हर आदत पर एक अंक पाएँ: सक्रिय रहना, खाना दर्ज करना, पोषण लक्ष्य और पानी का लक्ष्य पूरा करना।"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Ottieni un punto al giorno per abitudine: movimento, registrazione del cibo, obiettivo nutrizionale e obiettivo dell’acqua."}},
        "ja" : {"stringUnit": {"state": "translated", "value": "運動、食事記録、栄養目標、水分目標の各習慣で、1 日に 1 ポイント獲得できます。"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "움직임, 식단 기록, 영양 목표, 물 목표에 대해 매일 습관당 1점을 얻습니다."}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Verdien dagelijks één punt per gewoonte: bewegen, eten registreren en je voedings- en waterdoelen halen."}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Zdobywaj punkt dziennie za każdy nawyk: ruch, zapis posiłku, cel żywieniowy i cel picia wody."}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Ganhe um ponto por hábito a cada dia: movimento, registro de alimentação, meta de nutrição e meta de água."}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Primești zilnic câte un punct pentru mișcare, înregistrarea meselor și atingerea obiectivelor de nutriție și apă."}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Каждый день получайте балл за каждую привычку: активность, запись еды и выполнение целей питания и воды."}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Hareket, yemek kaydı, beslenme hedefi ve su hedefi için her gün birer puan kazanın."}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Щодня отримуйте по балу за звичку: рух, запис їжі, досягнення цілі харчування й води."}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "每天每项习惯获得一分：运动、记录饮食、达到营养目标和饮水目标。"}}
      }
    },
    "Earn a bonus point on days with three or more habits." : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "احصل على نقطة إضافية في الأيام التي تحقق فيها ثلاث عادات أو أكثر."}},
        "az" : {"stringUnit": {"state": "translated", "value": "Üç və ya daha çox vərdiş olan günlərə əlavə bir xal."}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Za den se třemi nebo více návyky získáte bod navíc."}},
        "de" : {"stringUnit": {"state": "translated", "value": "An Tagen mit mindestens drei Gewohnheiten gibt es einen Bonuspunkt."}},
        "es" : {"stringUnit": {"state": "translated", "value": "Gana un punto extra los días en que completes tres hábitos o más."}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Gagnez un point bonus les jours où vous remplissez au moins trois habitudes."}},
        "hi" : {"stringUnit": {"state": "translated", "value": "तीन या अधिक आदतें पूरी करने वाले दिन एक बोनस अंक पाएँ।"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Ottieni un punto bonus nei giorni in cui completi almeno tre abitudini."}},
        "ja" : {"stringUnit": {"state": "translated", "value": "3 つ以上の習慣を達成した日は、ボーナスを 1 ポイント獲得できます。"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "습관을 세 가지 이상 실천한 날엔 보너스 1점을 얻습니다."}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Verdien een bonuspunt op dagen met minstens drie gewoonten."}},
        "pl" : {"stringUnit": {"state": "translated", "value": "W dni z co najmniej trzema nawykami zdobywasz punkt bonusowy."}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Ganhe um ponto extra nos dias em que completar pelo menos três hábitos."}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Primești un punct bonus în zilele cu cel puțin trei obiceiuri."}},
        "ru" : {"stringUnit": {"state": "translated", "value": "За день с тремя или более привычками начисляется бонусный балл."}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Üç veya daha fazla alışkanlığı tamamladığınız günlerde bir bonus puan kazanın."}},
        "uk" : {"stringUnit": {"state": "translated", "value": "У дні з трьома або більше звичками нараховується бонусний бал."}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "完成三项或以上习惯的当天可获得一分奖励。"}}
      }
    },
    "Your longest run of days with two or more habits earns one point for each day after the first." : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "أطول سلسلة تحقق فيها عادتين أو أكثر تكسبك نقطة عن كل يوم بعد اليوم الأول."}},
        "az" : {"stringUnit": {"state": "translated", "value": "Ən azı iki vərdiş etdiyiniz ən uzun ardıcıl dövrdə ilk gündən sonrakı hər gün bir xal qazandırır."}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Za každý den po prvním v nejdelší sérii s alespoň dvěma návyky dostanete bod."}},
        "de" : {"stringUnit": {"state": "translated", "value": "Deine längste Serie mit mindestens zwei Gewohnheiten bringt ab dem zweiten Tag jeweils einen Punkt."}},
        "es" : {"stringUnit": {"state": "translated", "value": "En tu racha más larga de al menos dos hábitos diarios, cada día a partir del segundo vale un punto."}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Dans votre plus longue série de jours avec au moins deux habitudes, chaque jour après le premier rapporte un point."}},
        "hi" : {"stringUnit": {"state": "translated", "value": "लगातार दो या अधिक आदतों वाले दिनों की सबसे लंबी शृंखला में पहले दिन के बाद हर दिन एक अंक देता है।"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Nella serie più lunga di giorni con almeno due abitudini, ogni giorno dopo il primo vale un punto."}},
        "ja" : {"stringUnit": {"state": "translated", "value": "2 つ以上の習慣を達成した最長の連続期間では、2 日目以降に毎日 1 ポイント得られます。"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "습관을 두 가지 이상 실천한 가장 긴 연속 기간에는 첫날 이후 매일 1점을 얻습니다."}},
        "nl" : {"stringUnit": {"state": "translated", "value": "In je langste reeks met minstens twee gewoonten krijg je vanaf de tweede dag elke dag één punt."}},
        "pl" : {"stringUnit": {"state": "translated", "value": "W najdłuższej serii dni z co najmniej dwoma nawykami każdy dzień po pierwszym daje punkt."}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Na sua sequência mais longa de dias com pelo menos dois hábitos, cada dia após o primeiro vale um ponto."}},
        "ro" : {"stringUnit": {"state": "translated", "value": "În cea mai lungă serie de zile cu cel puțin două obiceiuri, fiecare zi după prima valorează un punct."}},
        "ru" : {"stringUnit": {"state": "translated", "value": "В самой длинной серии дней с двумя или более привычками каждый день после первого приносит балл."}},
        "tr" : {"stringUnit": {"state": "translated", "value": "İki veya daha fazla alışkanlık içeren en uzun serinizde, ilk günden sonraki her gün bir puan getirir."}},
        "uk" : {"stringUnit": {"state": "translated", "value": "У найдовшій серії днів із двома або більше звичками кожен день після першого приносить бал."}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "在每天至少完成两项习惯的最长连续记录中，从第二天开始每天得一分。"}}
      }
    },
    "Leave this challenge?" : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "هل تريد مغادرة هذا التحدي؟"}},
        "az" : {"stringUnit": {"state": "translated", "value": "Bu çağırışdan çıxmaq istəyirsiniz?"}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Opustit tuto výzvu?"}},
        "de" : {"stringUnit": {"state": "translated", "value": "Diese Challenge verlassen?"}},
        "es" : {"stringUnit": {"state": "translated", "value": "¿Salir de este reto?"}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Quitter ce défi ?"}},
        "hi" : {"stringUnit": {"state": "translated", "value": "यह चुनौती छोड़ें?"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Uscire da questa sfida?"}},
        "ja" : {"stringUnit": {"state": "translated", "value": "このチャレンジから退出しますか？"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "이 챌린지에서 나갈까요?"}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Deze uitdaging verlaten?"}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Opuścić to wyzwanie?"}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Sair deste desafio?"}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Părăsești această provocare?"}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Выйти из этого челленджа?"}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Bu mücadeleden ayrılmak istiyor musunuz?"}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Вийти з цього виклику?"}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "退出此挑战？"}}
      }
    },
    "This removes your scores for this time period only. Your other challenges and diary stay unchanged." : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "يُحذف رصيد هذه الفترة فقط. تبقى تحدياتك الأخرى وسجلك كما هما."}},
        "az" : {"stringUnit": {"state": "translated", "value": "Yalnız bu müddətin xalları silinir. Digər çağırışlar və gündəlik dəyişmir."}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Smažou se jen výsledky za toto období. Ostatní výzvy a deník zůstanou beze změny."}},
        "de" : {"stringUnit": {"state": "translated", "value": "Nur deine Ergebnisse für diesen Zeitraum werden gelöscht. Die anderen Challenges und dein Tagebuch bleiben unverändert."}},
        "es" : {"stringUnit": {"state": "translated", "value": "Solo se eliminan tus resultados de este periodo. Tus otros retos y tu diario no cambian."}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Seuls vos scores pour cette période seront supprimés. Vos autres défis et votre journal restent inchangés."}},
        "hi" : {"stringUnit": {"state": "translated", "value": "केवल इस अवधि के स्कोर हटेंगे। दूसरी चुनौतियाँ और डायरी जैसी हैं वैसी रहेंगी।"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Vengono rimossi solo i punteggi di questo periodo. Le altre sfide e il diario non cambiano."}},
        "ja" : {"stringUnit": {"state": "translated", "value": "この期間のスコアのみ削除されます。他のチャレンジや日記には変更がありません。"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "이 기간의 점수만 삭제됩니다. 다른 챌린지와 일지는 그대로 유지됩니다."}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Alleen je scores voor deze periode worden verwijderd. Je andere uitdagingen en je dagboek veranderen niet."}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Zostaną usunięte tylko wyniki z tego okresu. Inne wyzwania i dziennik pozostaną bez zmian."}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Só suas pontuações deste período serão removidas. Os outros desafios e o diário não mudam."}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Se elimină doar scorurile acestei perioade. Celelalte provocări și jurnalul rămân neschimbate."}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Удалятся только результаты за этот период. Другие челленджи и дневник не изменятся."}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Yalnızca bu dönemin puanları kaldırılır. Diğer mücadeleler ve günlüğünüz değişmez."}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Видаляються лише результати за цей період. Інші виклики та щоденник не змінюються."}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "只会删除本时段的成绩。其他挑战和日记不受影响。"}}
      }
    },
    "Leave all challenges?" : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "هل تريد مغادرة جميع التحديات؟"}},
        "az" : {"stringUnit": {"state": "translated", "value": "Bütün çağırışlardan çıxmaq istəyirsiniz?"}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Opustit všechny výzvy?"}},
        "de" : {"stringUnit": {"state": "translated", "value": "Alle Challenges verlassen?"}},
        "es" : {"stringUnit": {"state": "translated", "value": "¿Salir de todos los retos?"}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Quitter tous les défis ?"}},
        "hi" : {"stringUnit": {"state": "translated", "value": "सभी चुनौतियाँ छोड़ें?"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Uscire da tutte le sfide?"}},
        "ja" : {"stringUnit": {"state": "translated", "value": "すべてのチャレンジから退出しますか？"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "모든 챌린지에서 나갈까요?"}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Alle uitdagingen verlaten?"}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Opuścić wszystkie wyzwania?"}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Sair de todos os desafios?"}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Părăsești toate provocările?"}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Выйти из всех челленджей?"}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Tüm mücadelelerden ayrılmak istiyor musunuz?"}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Вийти з усіх викликів?"}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "退出所有挑战？"}}
      }
    },
    "Your public profile, all scores, and challenge reports will be deleted. Your private diary stays on this device." : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "سيُحذف ملفك العام وجميع نقاطك وبلاغات التحديات. يبقى سجلك الخاص على هذا الجهاز."}},
        "az" : {"stringUnit": {"state": "translated", "value": "Açıq profiliniz, bütün xallar və çağırış şikayətləri silinəcək. Şəxsi gündəliyiniz cihazda qalacaq."}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Veřejný profil, všechny výsledky a hlášení budou smazány. Soukromý deník zůstane v zařízení."}},
        "de" : {"stringUnit": {"state": "translated", "value": "Dein öffentliches Profil, alle Ergebnisse und Challenge-Meldungen werden gelöscht. Dein privates Tagebuch bleibt auf diesem Gerät."}},
        "es" : {"stringUnit": {"state": "translated", "value": "Se eliminarán tu perfil público, todos tus resultados y los reportes de retos. Tu diario privado se queda en este dispositivo."}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Votre profil public, tous vos scores et les signalements seront supprimés. Votre journal privé reste sur cet appareil."}},
        "hi" : {"stringUnit": {"state": "translated", "value": "सार्वजनिक प्रोफ़ाइल, सभी स्कोर और चुनौती रिपोर्ट हट जाएँगी। निजी डायरी इस डिवाइस पर रहेगी।"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Il profilo pubblico, tutti i punteggi e le segnalazioni verranno eliminati. Il diario privato resta su questo dispositivo."}},
        "ja" : {"stringUnit": {"state": "translated", "value": "公開プロフィール、すべてのスコア、報告が削除されます。非公開の日記はこの端末に残ります。"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "공개 프로필, 모든 점수와 신고가 삭제됩니다. 비공개 일지는 기기에 남습니다."}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Je openbare profiel, alle scores en meldingen worden verwijderd. Je privédagboek blijft op dit apparaat."}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Profil publiczny, wszystkie wyniki i zgłoszenia zostaną usunięte. Prywatny dziennik pozostanie na urządzeniu."}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Seu perfil público, todas as pontuações e os relatos de desafios serão excluídos. Seu diário privado fica neste dispositivo."}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Profilul public, toate scorurile și rapoartele vor fi șterse. Jurnalul privat rămâne pe dispozitiv."}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Публичный профиль, все результаты и жалобы будут удалены. Личный дневник останется на устройстве."}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Herkese açık profiliniz, tüm puanlarınız ve şikayetleriniz silinir. Özel günlüğünüz cihazda kalır."}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Публічний профіль, усі результати й скарги буде видалено. Приватний щоденник залишиться на пристрої."}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "公开资料、所有成绩和挑战举报将被删除。私人日记仍保存在此设备上。"}}
      }
    },
    "Jump to my rank" : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "انتقل إلى ترتيبي"}},
        "az" : {"stringUnit": {"state": "translated", "value": "Sıramı göstər"}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Přejít na mé umístění"}},
        "de" : {"stringUnit": {"state": "translated", "value": "Zu meinem Platz"}},
        "es" : {"stringUnit": {"state": "translated", "value": "Ir a mi posición"}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Aller à mon classement"}},
        "hi" : {"stringUnit": {"state": "translated", "value": "मेरी रैंक पर जाएँ"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Vai alla mia posizione"}},
        "ja" : {"stringUnit": {"state": "translated", "value": "自分の順位へ"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "내 순위로 이동"}},
        "nl" : {"stringUnit": {"state": "translated", "value": "Naar mijn positie"}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Przejdź do mojego miejsca"}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "Ir para minha posição"}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Mergi la poziția mea"}},
        "ru" : {"stringUnit": {"state": "translated", "value": "К моему месту"}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Sıralamama git"}},
        "uk" : {"stringUnit": {"state": "translated", "value": "До мого місця"}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "跳到我的排名"}}
      }
    },
    "The selected score comes first. Ties favor more different habits, steadier results across habits, and the other day counts. If those match, the person who reached them first ranks higher. Workout calories do not break ties." : {
      "localizations" : {
        "ar" : {"stringUnit": {"state": "translated", "value": "تأتي نتيجة الفئة المختارة أولًا. عند التعادل، تُفضَّل العادات الأكثر تنوعًا والنتائج الأكثر ثباتًا عبر العادات، ثم بقية أعداد الأيام. عند استمرار التعادل، يتقدم من حققها أولًا. سعرات التمرين لا تفصل في التعادل."}},
        "az" : {"stringUnit": {"state": "translated", "value": "Seçilən xal birinci gəlir. Bərabərlikdə daha müxtəlif vərdişlər, vərdişlər üzrə sabit nəticələr və digər gün sayları üstünlük qazanır. Onlar da eynidirsə, ilk əldə edən irəlidədir. Məşq kaloriləri bərabərliyi pozmur."}},
        "cs" : {"stringUnit": {"state": "translated", "value": "Nejdříve se hodnotí vybrané skóre. Při shodě rozhoduje pestrost návyků, vyrovnanější výsledky a další počty dnů. Pokud je i to stejné, vede ten, kdo výsledku dosáhl dříve. Kalorie z pohybu shodu nerozhodují."}},
        "de" : {"stringUnit": {"state": "translated", "value": "Die gewählte Punktzahl zählt zuerst. Bei Gleichstand zählen vielfältigere Gewohnheiten, ausgeglichenere Ergebnisse und die übrigen Tageszahlen. Sind auch diese gleich, liegt vorne, wer sie zuerst erreicht hat. Trainingskalorien entscheiden nicht."}},
        "es" : {"stringUnit": {"state": "translated", "value": "La puntuación elegida va primero. En caso de empate, cuentan la variedad y la constancia de los hábitos y los demás recuentos de días. Si siguen iguales, gana quien alcanzó antes esos resultados. Las calorías de ejercicio no desempatan."}},
        "fr" : {"stringUnit": {"state": "translated", "value": "Le score sélectionné prime. En cas d’égalité, la diversité et la régularité des habitudes puis les autres nombres de jours départagent. Si l’égalité persiste, la première personne à atteindre ces résultats est devant. Les calories d’exercice ne départagent pas."}},
        "hi" : {"stringUnit": {"state": "translated", "value": "चुना गया स्कोर पहले आता है। बराबरी में ज़्यादा अलग आदतें, आदतों में संतुलन और बाकी दिनों की गिनती देखी जाती है। फिर भी बराबरी हो तो जो पहले वहाँ पहुँचा उसकी रैंक ऊपर होगी। वर्कआउट की कैलोरी से बराबरी नहीं टूटती।"}},
        "it" : {"stringUnit": {"state": "translated", "value": "Il punteggio selezionato ha la precedenza. A parità contano la varietà e l’equilibrio delle abitudini, poi i giorni delle altre categorie. Se sono uguali, precede chi ha raggiunto prima quei risultati. Le calorie dell’allenamento non decidono la parità."}},
        "ja" : {"stringUnit": {"state": "translated", "value": "選択したスコアが最優先です。同点の場合は、習慣の多様さ、各習慣の安定度、他の項目の日数の順で比較します。それでも同じなら、先に達成した人が上位です。運動の消費カロリーでは順位を決めません。"}},
        "ko" : {"stringUnit": {"state": "translated", "value": "선택한 점수가 우선입니다. 동점이면 습관의 다양성, 습관별 꾸준함, 다른 항목의 일수를 비교합니다. 여전히 같으면 먼저 달성한 사람이 앞섭니다. 운동 칼로리는 동점을 가르지 않습니다."}},
        "nl" : {"stringUnit": {"state": "translated", "value": "De gekozen score telt eerst. Bij een gelijke stand tellen gevarieerdere gewoonten, evenwichtigere resultaten en de overige aantallen dagen. Zijn die ook gelijk, dan staat degene die ze het eerst bereikte hoger. Trainingscalorieën geven niet de doorslag."}},
        "pl" : {"stringUnit": {"state": "translated", "value": "Najpierw liczy się wybrany wynik. Przy remisie decydują różnorodność i równomierność nawyków oraz pozostałe liczby dni. Jeśli nadal jest remis, wyżej jest osoba, która osiągnęła wynik wcześniej. Kalorie z ćwiczeń nie rozstrzygają remisu."}},
        "pt-BR" : {"stringUnit": {"state": "translated", "value": "A pontuação selecionada vem primeiro. Empates favorecem variedade de hábitos, resultados mais equilibrados e as outras contagens de dias. Persistindo o empate, fica na frente quem chegou primeiro. Calorias de exercícios não desempatarão."}},
        "ro" : {"stringUnit": {"state": "translated", "value": "Scorul selectat contează primul. La egalitate, sunt avantajate obiceiurile mai variate, rezultatele echilibrate și celelalte totaluri de zile. Dacă sunt egale, ocupă locul mai bun persoana care le-a atins prima. Caloriile antrenamentului nu departajează."}},
        "ru" : {"stringUnit": {"state": "translated", "value": "Сначала учитывается выбранный результат. При равенстве важны разнообразие привычек, равномерность результатов и другие счётчики дней. Если и они равны, выше тот, кто достиг их раньше. Калории тренировки не влияют на ничью."}},
        "tr" : {"stringUnit": {"state": "translated", "value": "Önce seçili puan değerlendirilir. Eşitlikte daha çeşitli alışkanlıklar, daha dengeli sonuçlar ve diğer gün sayıları öne çıkar. Bunlar da eşitse önce ulaşan öndedir. Antrenman kalorileri eşitliği bozmaz."}},
        "uk" : {"stringUnit": {"state": "translated", "value": "Спочатку враховується вибраний результат. За рівності перевагу дають різноманітні звички, рівномірніші результати й решта лічильників днів. Якщо вони теж рівні, вище той, хто досяг результату раніше. Калорії тренувань не розв’язують нічию."}},
        "zh-Hans" : {"stringUnit": {"state": "translated", "value": "优先比较所选积分。同分时，依次比较习惯的多样性、各项习惯的均衡程度及其他天数。如果仍相同，先达到这些成绩的人排名更高。运动消耗的热量不用于打破平局。"}}
      }
    }
  },
  "version" : "1.0"
}
