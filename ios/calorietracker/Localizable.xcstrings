    "Pick one to four nutrients for the Home summary row.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de uno a cuatro nutrientes para la fila de resumen de Inicio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana Ekran özet satırı için bir ila dört besin öğesi seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من عنصر إلى أربعة عناصر غذائية لصف الملخص في الرئيسية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana səhifənin xülasə sətri üçün birdən dördə qədər qida maddəsi seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber přesně čtyři živiny pro souhrnný řádek na Domů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
