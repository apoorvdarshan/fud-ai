          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтверждать перед сохранением"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmeden önce onayla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтверджувати перед збереженням"
          }
        },
