        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedavá: 1,2  ·  Lehká: 1,375  ·  Střední: 1,465  ·  Aktivní: 1,55  ·  Velmi aktivní: 1,725  ·  Extrémně aktivní: 1,9"
          }
        }
      }
    },
    "Maintenance & goal adjustment": {
      "localizations": {
        "ar": {
          "stringUnit": {
