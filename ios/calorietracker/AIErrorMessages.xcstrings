            "value": "O Apple Intelligence está disponível apenas para solicitações somente de texto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence este disponibil doar pentru solicitările doar cu text."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence доступен только для текстовых запросов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能仅适用于纯文本请求。"
          }
        }
      }
    },
    "ai.error.both_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ and fallback %2$@ both failed. %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallaron %1$@ y el respaldo %2$@. %3$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ і резервний %2$@ не спрацювали. %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ve yedek %2$@ ikisi de başarısız oldu. %3$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل كل من %1$@ والبديل %2$@. %3$@"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ və ehtiyat %2$@ uğursuz oldu. %3$@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Selhal %1$@ i záložní %2$@. %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ und Fallback %2$@ sind beide fehlgeschlagen. %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ et le secours %2$@ ont tous deux échoué. %3$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ और फ़ॉलबैक %2$@ दोनों विफल रहे। %3$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sia %1$@ sia il fallback %2$@ non sono riusciti. %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@とフォールバックの%2$@の両方が失敗しました。%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@와 대체 %2$@ 모두 실패했습니다. %3$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zowel %1$@ als terugval %2$@ zijn mislukt. %3$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarówno %1$@, jak i zapasowy %2$@ zawiodły. %3$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ e a alternativa %2$@ falharam. %3$@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atât %1$@, cât și rezerva %2$@ au eșuat. %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сработали ни %1$@, ни резервный %2$@. %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 和备用 %2$@ 均失败。%3$@"
