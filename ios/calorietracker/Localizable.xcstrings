    "Fast overlaps another session": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتداخل الصيام مع جلسة أخرى"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruc başqa sessiya ilə üst-üstə düşür"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasten überschneidet sich mit einer anderen Sitzung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ayuno se superpone con otra sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeûne chevauche une autre session"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपवास किसी अन्य सत्र से ओवरलैप हो रहा है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il digiuno si sovrappone a un’altra sessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の断食セッションと重複しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 단식 세션과 겹칩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vasten overlapt met een andere sessie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Post nakłada się na inną sesję"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jejum se sobrepõe a outra sessão"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Postul se suprapune cu o altă sesiune"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодание пересекается с другой сессией"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голодування перетинається з іншою сесією"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁食与另一段记录重叠"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruç, başka bir oturumla çakışıyor"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Půst se překrývá s jiným"
          }
        }
      }
    },
    "Adjust the start or end time so fasting sessions do not overlap.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدّل وقت البدء أو الانتهاء حتى لا تتداخل جلسات الصيام."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruc sessiyalarının üst-üstə düşməməsi üçün başlama və ya bitmə vaxtını dəyişin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe Start- oder Endzeit an, damit sich Fastenzeiten nicht überschneiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la hora de inicio o fin para que las sesiones de ayuno no se superpongan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie l’heure de début ou de fin afin que les sessions de jeûne ne se chevauchent pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शुरू या समाप्ति का समय बदलें ताकि उपवास सत्र ओवरलैप न हों।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica l’ora di inizio o fine in modo che le sessioni di digiuno non si sovrappongano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "断食セッションが重複しないよう、開始時刻または終了時刻を調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단식 세션이 겹치지 않도록 시작 또는 종료 시간을 조정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de begin- of eindtijd aan zodat vastensessies niet overlappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień czas rozpoczęcia lub zakończenia, aby sesje postu się nie nakładały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o horário de início ou fim para que as sessões de jejum não se sobreponham."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustează ora de început sau de sfârșit pentru ca sesiunile de post să nu se suprapună."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените время начала или окончания, чтобы сессии голодания не пересекались."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть час початку або завершення, щоб сесії голодування не перетиналися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请调整开始或结束时间，避免禁食记录重叠。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oruç oturumlarının çakışmaması için başlangıç veya bitiş saatini ayarlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprav začátek nebo konec, aby se půsty nepřekrývaly."
          }
        }
      }
    },
