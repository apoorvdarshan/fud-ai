    "You reached your %@ fasting goal. End the fast when you're ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد بلغت هدف الصيام لمدة %@. أنهِ الصيام عندما تكون مستعدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oruc hədəfinə çatdınız. Hazır olduqda orucu bitirin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Fastenziel von %@ erreicht. Beende das Fasten, wenn du bereit bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado tu objetivo de ayuno de %@. Termina el ayuno cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as atteint ton objectif de jeûne de %@. Termine le jeûne quand tu es prêt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने %@ का उपवास लक्ष्य पूरा कर लिया है। तैयार होने पर उपवास समाप्त करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto l’obiettivo di digiuno di %@. Termina il digiuno quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の断食目標を達成しました。準備ができたら断食を終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 단식 목표를 달성했습니다. 준비되면 단식을 종료하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt je vastendoel van %@ bereikt. Beëindig het vasten wanneer je klaar bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cel postu %@ został osiągnięty. Zakończ post, gdy będziesz gotowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu sua meta de jejum de %@. Encerre o jejum quando estiver pronto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai atins obiectivul de post de %@. Încheie postul când ești pregătit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы достигли цели голодания %@. Завершите голодание, когда будете готовы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви достигли цели голодания %@. Завершите голодание, когда будете готови."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已达到%@的禁食目标。准备好后即可结束禁食。"
          }
        }
      }
    },
