    "Choose based on your average week, including work and exercise.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige según tu semana promedio, incluyendo trabajo y ejercicio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş ve egzersiz dahil, ortalama haftanızı göz önünde bulundurarak seçim yapın."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بناءً على متوسط أسبوعك، بما في ذلك العمل والتمارين."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İş və məşq daxil olmaqla orta həftənizə əsasən seçin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber podle svého běžného týdne včetně práce a cvičení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle nach deiner durchschnittlichen Woche, einschließlich Arbeit und Training."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez selon votre semaine moyenne, travail et exercice compris."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम और व्यायाम सहित अपने औसत सप्ताह के आधार पर चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli in base alla tua settimana media, includendo lavoro ed esercizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仕事と運動を含む平均的な1週間を基準に選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일과 운동을 포함한 평균적인 일주일을 기준으로 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies op basis van je gemiddelde week, inclusief werk en training."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz na podstawie przeciętnego tygodnia, w tym pracy i treningu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha com base na sua semana média, incluindo trabalho e exercício."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege după săptămâna medie, incluzând munca și exercițiul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте по средней неделе, учитывая работу и тренировки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть на основі свого типового тижня, включно з роботою та вправами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请根据包含工作和锻炼在内的平均一周来选择。"
          }
        }
      }
    },
