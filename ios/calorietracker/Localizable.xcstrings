    "Double tap to add to this day": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca dos veces para añadir a este día"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط مرتين للإضافة إلى هذا اليوم"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu günə əlavə etmək üçün iki dəfə toxunun"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvojitým klepnutím přidáš k tomuto dni"
          }
        },
        "de": {
