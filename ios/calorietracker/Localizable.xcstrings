    "Fud AI voice needs a Plus or Pro plan": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب صوت Fud AI خطة Plus أو Pro"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI səsi üçün Plus və ya Pro planı lazımdır"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlas Fud AI vyžaduje plán Plus nebo Pro"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprachfunktion von Fud AI braucht ein Plus- oder Pro-Abo"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz de Fud AI necesita un plan Plus o Pro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La voix Fud AI nécessite un forfait Plus ou Pro"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI वॉइस के लिए Plus या Pro प्लान चाहिए"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La voce di Fud AI richiede un piano Plus o Pro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AIの音声機能にはPlusまたはProプランが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI 음성은 Plus 또는 Pro 요금제가 필요합니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI-spraak vereist een Plus- of Pro-abonnement"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głos Fud AI wymaga planu Plus lub Pro"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz do Fud AI exige um plano Plus ou Pro"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocea Fud AI necesită un plan Plus sau Pro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосового режима Fud AI нужен план Plus или Pro"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI sesi için Plus veya Pro planı gerekir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосового режиму Fud AI потрібен план Plus або Pro"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI 语音需要 Plus 或 Pro 订阅"
          }
        }
      }
    },
    "Subscribe to Plus or Pro, or add a Gemini, OpenAI, xAI or Qwen API key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك في Plus أو Pro، أو أضف مفتاح API من Gemini أو OpenAI أو xAI أو Qwen"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus və ya Pro-ya abunə olun, ya da Gemini, OpenAI, xAI və ya Qwen API açarı əlavə edin"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplať si Plus nebo Pro, nebo přidej klíč API od Gemini, OpenAI, xAI či Qwen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe Plus oder Pro ab oder füge einen API-Schlüssel von Gemini, OpenAI, xAI oder Qwen hinzu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete a Plus o Pro, o añade una clave API de Gemini, OpenAI, xAI o Qwen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnez-vous à Plus ou Pro, ou ajoutez une clé API Gemini, OpenAI, xAI ou Qwen"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus या Pro की सदस्यता लें, या Gemini, OpenAI, xAI या Qwen API कुंजी जोड़ें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati a Plus o Pro, oppure aggiungi una chiave API di Gemini, OpenAI, xAI o Qwen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PlusかProに登録するか、Gemini・OpenAI・xAI・QwenのAPIキーを追加してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus나 Pro를 구독하거나 Gemini, OpenAI, xAI, Qwen API 키를 추가하세요"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem Plus of Pro, of voeg een API-sleutel van Gemini, OpenAI, xAI of Qwen toe"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykup Plus lub Pro albo dodaj klucz API Gemini, OpenAI, xAI lub Qwen"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine o Plus ou o Pro, ou adicione uma chave de API do Gemini, OpenAI, xAI ou Qwen"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonează-te la Plus sau Pro ori adaugă o cheie API Gemini, OpenAI, xAI sau Qwen"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформите Plus или Pro либо добавьте API-ключ Gemini, OpenAI, xAI или Qwen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus veya Pro’ya abone olun ya da bir Gemini, OpenAI, xAI veya Qwen API anahtarı ekleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформіть Plus або Pro чи додайте API-ключ Gemini, OpenAI, xAI або Qwen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅 Plus 或 Pro，或添加 Gemini、OpenAI、xAI 或 Qwen API 密钥"
          }
        }
      }
    },
    "Add an API Key in AI Providers": {
      "localizations": {
