          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir öğünü, doğrudan Fud AI’da açılan bir bağlantı olarak paylaşın."
          }
        }
      }
    },
    "An optional Tip Jar in Settings → About lets you support development.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح لك صندوق البقشيش الاختياري في الإعدادات ← حول دعم التطوير."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Tənzimləmələr ← Haqqında bölməsindəki isteğe bağlı Bəxşiş Qutusu inkişafı dəstəkləməyə imkan verir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über eine optionale Tip-Jar unter Einstellungen ← Info kannst du die Entwicklung unterstützen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Tip Jar opcional en Ajustes → Acerca de te permite apoyar el desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Tip Jar facultatif dans Réglages ← À propos te permet de soutenir le développement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स ← अबाउट में वैकल्पिक टिप जार से आप डेवलपमेंट का समर्थन कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Tip Jar facoltativo in Impostazioni ← Info ti permette di supportare lo sviluppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 ← 情報にある任意のチップジャーで開発を応援できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 ← 정보의 선택형 팁 자에서 개발을 후원할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een optionele Tip Jar in Instellingen ← Over kun je de ontwikkeling steunen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalny Tip Jar w Ustawienia ← Informacje pozwala wesprzeć rozwój."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma Tip Jar opcional em Ajustes ← Sobre permite apoiar o desenvolvimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Tip Jar opțional în Setări ← Despre îți permite să susții dezvoltarea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательная «Копилка» в Настройках ← О приложении позволяет поддержать разработку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язкова «Скарбничка» в Налаштуваннях → Про застосунок дає змогу підтримати розробку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 ← 关于中的可选打赏罐让你支持开发。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelná kasička na spropitné v Nastavení → O aplikaci umožňuje podpořit vývoj."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirmeyi desteklemek için Ayarlar → Hakkında bölümünde isteğe bağlı bir Bahşiş Kavanozu bulunur."
          }
        }
      }
    },
