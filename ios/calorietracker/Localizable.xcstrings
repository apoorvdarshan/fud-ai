    "Split work by pushing and pulling patterns across the body.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide el trabajo según los patrones de empuje y tirón de todo el cuerpo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قسّم العمل حسب أنماط الدفع والسحب في الجسم كله."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşi bütün bədən üzrə itələmə və dartma hərəkətlərinə görə bölün."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozděl práci podle tlakových a tahových pohybů napříč celým tělem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile das Training nach Druck- und Zugbewegungen am ganzen Körper auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartissez le travail selon les mouvements de poussée et de tirage sur tout le corps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे शरीर में पुश और पुल पैटर्न के आधार पर काम बाँटें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suddividi il lavoro per schemi di spinta e trazione su tutto il corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全身のプッシュとプルの動作パターンで分けて行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전신의 밀기와 당기기 패턴으로 운동을 나눕니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdeel het werk over duw- en trekbewegingen voor het hele lichaam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziel pracę według ruchów pchających i ciągnących dla całego ciała."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divida o treino por padrões de empurrar e puxar em todo o corpo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Împarte lucrul pe tipare de împingere și tragere pentru tot corpul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делите нагрузку по жимовым и тяговым движениям для всего тела."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışmayı tüm vücutta itme ve çekme hareketlerine göre bölün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розподіляйте навантаження за жимовими й тяговими рухами для всього тіла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按全身的推、拉动作模式来划分训练。"
          }
        }
      }
    },
