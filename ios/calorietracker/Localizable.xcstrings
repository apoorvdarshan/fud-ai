    "Choose a JSON file previously exported by Fud AI. The file is validated before any diary entry is changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo JSON exportado previamente por Fud AI. El archivo se valida antes de cambiar cualquier registro del diario."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha önce Fud AI'dan dışa aktarılmış bir JSON dosyası seçin. Günlükte herhangi bir kayıt değiştirilmeden önce dosyanın geçerliliği kontrol edilir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ملف JSON صدّرته Fud AI سابقًا. يتم التحقق من الملف قبل تغيير أي إدخال في اليوميات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəllər Fud AI tərəfindən ixrac edilmiş JSON faylı seçin. Gündəlikdəki hər hansı qeyd dəyişdirilməzdən əvvəl fayl yoxlanılır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber soubor JSON, který Fud AI dříve exportovala. Soubor se ověří dřív, než se změní jakýkoli záznam v deníku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine JSON-Datei, die zuvor von Fud AI exportiert wurde. Die Datei wird geprüft, bevor ein Tagebucheintrag geändert wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier JSON précédemment exporté par Fud AI. Le fichier est validé avant toute modification du journal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI द्वारा पहले एक्सपोर्ट की गई JSON फ़ाइल चुनें। किसी भी डायरी प्रविष्टि को बदलने से पहले फ़ाइल की जाँच की जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un file JSON esportato in precedenza da Fud AI. Il file viene convalidato prima di modificare qualsiasi voce del diario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前にFud AIで書き出したJSONファイルを選択してください。日記の記録を変更する前にファイルを検証します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 Fud AI에서 내보낸 JSON 파일을 선택하세요. 일기 항목을 변경하기 전에 파일을 검증합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een JSON-bestand dat eerder door Fud AI is geëxporteerd. Het bestand wordt gecontroleerd voordat er een dagboekitem wordt gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plik JSON wcześniej wyeksportowany przez Fud AI. Plik jest sprawdzany przed zmianą jakiegokolwiek wpisu w dzienniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um arquivo JSON exportado antes pelo Fud AI. O arquivo é validado antes de qualquer registro do diário ser alterado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un fișier JSON exportat anterior de Fud AI. Fișierul este validat înainte de a modifica orice intrare din jurnal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите файл JSON, ранее экспортированный Fud AI. Файл проверяется до изменения каких-либо записей дневника."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть файл JSON, раніше експортований Fud AI. Файл перевіряється до зміни будь-яких записів щоденника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择之前由 Fud AI 导出的 JSON 文件。在更改任何日记记录之前会先验证该文件。"
          }
        }
      }
    },
