    },
    "This key no longer exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel existiert nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key no longer exists."
          }
        }
      }
    },
    "Save more than one key for the same provider, give each a name, and choose which profile every AI route uses. Keys stay in encrypted storage and are shown only as a short fingerprint.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere mehrere Schlüssel für denselben Anbieter, gib jedem einen Namen und wähle, welches Profil jede KI-Route nutzt. Schlüssel bleiben verschlüsselt und werden nur als kurzer Fingerabdruck angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save more than one key for the same provider, give each a name, and choose which profile every AI route uses. Keys stay in encrypted storage and are shown only as a short fingerprint."
          }
        }
      }
    },
    "No key saved for this provider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Anbieter ist kein Schlüssel gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key saved for this provider."
          }
