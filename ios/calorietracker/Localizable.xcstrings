    "Send this meal to a friend — they can add it to their Fud AI in one tap.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسِل هذه الوجبة إلى صديق — يمكنه إضافتها إلى Fud AI الخاص به بنقرة واحدة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yeməyi bir dosta göndərin — o, bir toxunuşla öz Fud AI-yə əlavə edə bilər."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende diese Mahlzeit an eine Freundin oder einen Freund – sie lässt sich mit einem Tippen zu Fud AI hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this meal to a friend — they can add it to their Fud AI in one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía esta comida a un amigo: puede añadirla a su Fud AI con un solo toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez ce repas à un ami — il peut l'ajouter à son Fud AI en un seul geste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह भोजन किसी मित्र को भेजें — वे इसे एक टैप में अपने Fud AI में जोड़ सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia questo pasto a un amico: può aggiungerlo al suo Fud AI con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この食事を友だちに送信 — 相手はワンタップで自分のFud AIに追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 식사를 친구에게 보내세요 — 친구는 한 번의 탭으로 자신의 Fud AI에 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur deze maaltijd naar een vriend — met één tik voegt hij deze toe aan zijn Fud AI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij ten posiłek znajomemu — może dodać go do swojego Fud AI jednym dotknięciem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie esta refeição para um amigo — ele pode adicioná-la ao Fud AI dele com um toque."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite această masă unui prieten — o poate adăuga în Fud AI-ul lui dintr-o atingere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте этот приём пищи другу — он добавит его в свой Fud AI одним касанием."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надішліть цю страву другові — він зможе додати її до свого Fud AI одним дотиком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将这份餐食发送给好友——只需轻点一下即可添加到他的 Fud AI 中。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošli tohle jídlo kamarádovi — jedním klepnutím si ho přidá do svého Fud AI."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğünü bir arkadaşınıza gönderin — tek dokunuşla Fud AI uygulamasına ekleyebilir."
          }
        }
      }
    },
