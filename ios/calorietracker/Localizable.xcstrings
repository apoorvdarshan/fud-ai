    "Pick what to bring back. You can choose both.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما تريد استعادته. يمكنك اختيار الاثنين."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Nəyi geri qaytarmaq istədiyinizi seçin. Hər ikisini seçə bilərsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber, co chceš vrátit. Můžeš zvolit obojí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, was du zurückholen möchtest. Du kannst beides wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué quieres recuperar. Puedes elegir ambos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis ce que tu veux récupérer. Tu peux choisir les deux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि क्या वापस लाना है। आप दोनों चुन सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli cosa recuperare. Puoi sceglierli entrambi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻すデータを選んでください。両方選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌릴 항목을 고르세요. 둘 다 선택할 수 있어요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies wat je terug wilt halen. Je kunt beide kiezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, co chcesz przywrócić. Możesz wybrać oba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que trazer de volta. Você pode escolher os dois."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege ce vrei să recuperezi. Poți alege ambele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, что вернуть. Можно выбрать оба варианта."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neyi geri getireceğinizi seçin. İkisini birden seçebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, що повернути. Можна вибрати обидва варіанти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要恢复的内容，可以两项都选。"
          }
        }
      }
    },
    "Diary, photos, workouts, and settings from your last backup.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اليوميات والصور والتمارين والإعدادات من آخر نسخة احتياطية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Son ehtiyat nüsxənizdən gündəlik, fotolar, məşqlər və ayarlar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Deník, fotky, tréninky a nastavení z poslední zálohy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tagebuch, Fotos, Trainings und Einstellungen aus deinem letzten Backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diario, fotos, entrenamientos y ajustes de tu última copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal, photos, entraînements et réglages de ta dernière sauvegarde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पिछले बैकअप से डायरी, फ़ोटो, वर्कआउट और सेटिंग्स।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diario, foto, allenamenti e impostazioni dal tuo ultimo backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のバックアップにある記録、写真、ワークアウト、設定。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 백업의 기록, 사진, 운동, 설정."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagboek, foto’s, trainingen en instellingen uit je laatste back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziennik, zdjęcia, treningi i ustawienia z ostatniej kopii zapasowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diário, fotos, treinos e ajustes do seu último backup."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnal, fotografii, antrenamente și setări din ultimul tău backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дневник, фото, тренировки и настройки из последней резервной копии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son yedeğinizdeki günlük, fotoğraflar, antrenmanlar ve ayarlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоденник, фото, тренування й налаштування з останньої резервної копії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次备份中的饮食日记、照片、训练和设置。"
          }
        }
      }
    },
    "Meals, weight, body fat, and workout calories Fud AI saved to Health.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوجبات والوزن ونسبة الدهون وسعرات التمارين التي حفظها Fud AI في Apple Health."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI-nin Apple Health-ə yazdığı yeməklər, çəki, bədən yağı və məşq kaloriləri."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jídla, váha, tělesný tuk a kalorie z tréninků, které Fud AI ukládá do Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahlzeiten, Gewicht, Körperfett und Trainingskalorien, die Fud AI in Apple Health gespeichert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comidas, peso, grasa corporal y calorías de entrenamiento que Fud AI guardó en Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repas, poids, masse grasse et calories d’entraînement enregistrés par Fud AI dans Apple Health."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI द्वारा Apple Health में सेव किए गए भोजन, वज़न, बॉडी फ़ैट और वर्कआउट कैलोरी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasti, peso, grasso corporeo e calorie degli allenamenti che Fud AI ha salvato in Apple Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AIがApple Healthに保存した食事、体重、体脂肪、ワークアウトの消費カロリー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI가 Apple Health에 저장한 식사, 체중, 체지방, 운동 칼로리."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maaltijden, gewicht, vetpercentage en trainingscalorieën die Fud AI in Apple Health heeft opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Posiłki, waga, tkanka tłuszczowa i kalorie z treningów zapisane przez Fud AI w Apple Health."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Refeições, peso, gordura corporal e calorias de treino que o Fud AI salvou no Apple Health."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesele, greutatea, grăsimea corporală și caloriile din antrenamente salvate de Fud AI în Apple Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приёмы пищи, вес, процент жира и калории тренировок, которые Fud AI сохранил в Apple Health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI'ın Apple Sağlık'a kaydettiği öğünler, kilo, vücut yağı ve antrenman kalorileri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прийоми їжі, вага, відсоток жиру й калорії тренувань, які Fud AI зберіг в Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI 保存到 Apple Health 的饮食、体重、体脂和训练消耗。"
          }
        }
      }
    },
