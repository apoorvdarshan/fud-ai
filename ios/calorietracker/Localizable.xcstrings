          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz od jednego do czterech składników odżywczych do wiersza podsumowania na ekranie głównym."
          }
        },
        "pt-BR": {
          "stringUnit": {
