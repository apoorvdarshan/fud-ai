    "whisper.deleteMessage": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة النموذج الذي تم تنزيله من هذا الـ iPhone. يمكنك تنزيله مرة أخرى لاحقًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Endirilmiş model bu iPhone-dan silinəcək. Onu daha sonra yenidən endirə bilərsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heruntergeladene Modell wird von diesem iPhone entfernt. Du kannst es später erneut herunterladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded model will be removed from this iPhone. You can download it again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo descargado se eliminará de este iPhone. Puedes volver a descargarlo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle téléchargé sera supprimé de cet iPhone. Vous pourrez le télécharger à nouveau plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड किया गया मॉडल इस iPhone से हटा दिया जाएगा। आप इसे बाद में फिर से डाउनलोड कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello scaricato verrà rimosso da questo iPhone. Potrai scaricarlo di nuovo in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたモデルがこの iPhone から削除されます。後でもう一度ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 모델이 이 iPhone에서 삭제됩니다. 나중에 다시 다운로드할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gedownloade model wordt van deze iPhone verwijderd. Je kunt het later opnieuw downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrany model zostanie usunięty z tego iPhone’a. Możesz pobrać go ponownie później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo baixado será removido deste iPhone. Você poderá baixá-lo novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelul descărcat va fi eliminat de pe acest iPhone. Îl puteți descărca din nou mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загруженная модель будет удалена с этого iPhone. Позже её можно будет загрузить снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаженная модель будет удалена з цього iPhone. Позже её можно будет загрузить снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的模型将从此 iPhone 中移除。您稍后可以重新下载。"
          }
        }
      }
    },
    "whisper.about": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوالي 147 ميغابايت. يعمل بالكامل على الجهاز بعد التنزيل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Təxminən 147 MB. Endirildikdən sonra tamamilə cihazda işləyir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa 147 MB. Läuft nach dem Download vollständig auf dem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About 147 MB. Runs fully on-device after download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos 147 MB. Se ejecuta íntegramente en el dispositivo después de descargarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ 147 Mo. S’exécute entièrement sur l’appareil après le téléchargement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लगभग 147 MB। डाउनलोड होने के बाद पूरी तरह डिवाइस पर चलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa 147 MB. Dopo il download viene eseguito interamente sul dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約 147 MB。ダウンロード後はすべてデバイス上で動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 147MB. 다운로드 후 기기에서 완전히 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeveer 147 MB. Draait na het downloaden volledig op het apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około 147 MB. Po pobraniu działa w całości na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de 147 MB. É executado inteiramente no dispositivo após o download."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproximativ 147 MB. După descărcare, rulează integral pe dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Около 147 МБ. После загрузки полностью работает на устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Около 147 МБ. После загрузки полностью работает на устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 147 MB。下载后完全在设备端运行。"
          }
        }
      }
    },
    "whisper.storedWithSize": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزّن محليًا (%@). لا تغادر أي تسجيلات صوتية هذا الـ iPhone."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerli olaraq saxlanılıb (%@). Heç bir audio bu iPhone-dan kənara çıxmır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal gespeichert (%@). Keine Audiodaten verlassen dieses iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored locally (%@). No audio leaves this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenado localmente (%@). Ningún audio sale de este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké localement (%@). Aucun contenu audio ne quitte cet iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय रूप से स्टोर किया गया (%@)। कोई भी ऑडियो इस iPhone से बाहर नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviato localmente (%@). Nessun audio lascia questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルに保存されています（%@）。音声がこの iPhone の外部に送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬에 저장됨(%@). 오디오가 이 iPhone 외부로 전송되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaal opgeslagen (%@). Geen audio verlaat deze iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano lokalnie (%@). Żadne nagranie nie opuszcza tego iPhone’a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenado localmente (%@). Nenhum áudio sai deste iPhone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocat local (%@). Nicio înregistrare audio nu părăsește acest iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено локально (%@). Аудио не покидает этот iPhone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранено локально (%@). Аудио не покидает етот iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存储在本地（%@）。任何音频都不会离开此 iPhone。"
          }
        }
      }
    },
