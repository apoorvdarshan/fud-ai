    "Ask Coach by voice with the new inline recorder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل المدرب صوتيًا عبر المسجّل المدمج الجديد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni daxili yazıcı ilə Koça səslə sual verin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag den Coach per Sprache mit dem neuen Inline-Rekorder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta al Coach por voz con la nueva grabadora integrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrogez le Coach à la voix avec le nouvel enregistreur intégré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए इनलाइन रिकॉर्डर से कोच से आवाज़ में पूछें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi al Coach a voce con il nuovo registratore integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいインラインレコーダーで、コーチに音声で質問できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 인라인 녹음기로 코치에게 음성으로 질문하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de Coach een vraag met je stem via de nieuwe ingebouwde recorder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj Trenera głosowo dzięki nowemu wbudowanemu rejestratorowi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte ao Coach por voz com o novo gravador integrado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Întreabă Coach-ul cu vocea, cu noul recorder integrat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задавайте вопросы Коучу голосом с новым встроенным рекордером."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитуйте Тренера голосом за допомогою нового вбудованого диктофона."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用新的内置录音条向教练语音提问。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ptej se kouče hlasem přes nový vestavěný rekordér."
          }
        }
      }
    },
