    "Add a note to refine this entry — e.g. “large bowl, extra olive oil” — then tap Reprocess.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una nota para afinar este registro (p. ej., “tazón grande, aceite de oliva extra”) y luego toca Reprocesar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف ملاحظة لتحسين هذا الإدخال — مثل «وعاء كبير، زيت زيتون إضافي» — ثم اضغط «إعادة المعالجة»."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qeydi dəqiqləşdirmək üçün qeyd əlavə edin — məs. \"böyük kasa, əlavə zeytun yağı\" — sonra Yenidən emal et düyməsinə toxunun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej poznámku pro upřesnění tohoto záznamu — např. „velká miska, olivový olej navíc“ — a klepni na Zpracovat znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Notiz hinzu, um diesen Eintrag zu verfeinern – z. B. „große Schüssel, extra Olivenöl“ – und tippe dann auf „Neu verarbeiten“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une note pour affiner cette entrée — p. ex. « grand bol, huile d’olive en plus » — puis touchez Retraiter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रविष्टि को बेहतर बनाने के लिए नोट जोड़ें — जैसे “बड़ा कटोरा, ज़्यादा जैतून का तेल” — फिर फिर से प्रोसेस करें पर टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una nota per perfezionare questa voce, ad es. “ciotola grande, olio d’oliva in più”, poi tocca Rielabora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモを追加してこの記録を調整し（例：「大盛り、オリーブオイル多め」）、「再処理」をタップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모를 추가해 이 항목을 다듬은 다음(예: \"큰 그릇, 올리브유 추가\") 다시 처리를 탭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een notitie toe om dit item te verfijnen — bijv. “grote kom, extra olijfolie” — en tik dan op Opnieuw verwerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj notatkę, aby doprecyzować ten wpis — np. „duża miska, dodatkowa oliwa” — a potem stuknij Przetwórz ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma nota para refinar este registro — ex.: “tigela grande, azeite extra” — e toque em Reprocessar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă o notă pentru a rafina această intrare — de ex. „castron mare, ulei de măsline în plus” — apoi atinge Reprocesează."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте заметку, чтобы уточнить запись, — например, «большая миска, больше оливкового масла», — затем нажмите «Переанализировать»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kaydı iyileştirmek için not ekleyin — örn. “büyük kâse, ekstra zeytinyağı” — ardından Yeniden İşle'ye dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте нотатку, щоб уточнити цей запис, — наприклад, «велика миска, більше оливкової олії», — а потім торкніться «Повторно обробити»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加备注来完善这条记录——例如“一大碗，多加橄榄油”——然后轻点“重新处理”。"
          }
        }
      }
    },
