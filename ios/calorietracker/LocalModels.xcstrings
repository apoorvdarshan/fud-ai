    "gemma.error.storageCapacityUnavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من مساحة التخزين المتاحة، لذلك لم يبدأ تنزيل النموذج الكبير."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mövcud yaddaşı yoxlamaq mümkün olmadığından böyük modelin endirilməsi başlamadı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verfügbare Speicher konnte nicht geprüft werden. Daher wurde der Download des großen Modells nicht gestartet."
          }
        },
        "en": {
          "stringUnit": {
