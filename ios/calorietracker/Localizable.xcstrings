    "20 minutes of rope skipping, then 3 sets of 10 bench presses at 40 kg": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "20 minutos de saltar la cuerda y luego 3 series de 10 press de banca con 40 kg"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "20 دقيقة من نط الحبل، ثم 3 مجموعات من 10 تكرارات ضغط بنش بوزن 40 كغ"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "20 dəqiqə ip atlama, sonra 40 kq ilə 10 təkrarlı 3 set bench press"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "20 minut skákání přes švihadlo, pak 3 série po 10 opakováních bench pressu se 40 kg"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "20 Minuten Seilspringen, dann 3 Sätze mit 10 Bankdrücken bei 40 kg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "20 minutes de corde à sauter, puis 3 séries de 10 développés couchés à 40 kg"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "20 मिनट रस्सी कूदना, फिर 40 kg पर 10 बेंच प्रेस के 3 सेट"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "20 minuti di salto della corda, poi 3 serie da 10 di panca piana con 40 kg"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縄跳び20分、その後40kgでベンチプレス10回×3セット"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄넘기 20분, 그다음 40kg 벤치프레스 10회 3세트"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "20 minuten touwtjespringen, daarna 3 sets van 10 bankdrukken met 40 kg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "20 minut skakania na skakance, potem 3 serie po 10 wyciskań na ławce z 40 kg"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "20 minutos de pular corda e depois 3 séries de 10 supinos com 40 kg"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "20 de minute de sărit coarda, apoi 3 serii a câte 10 împinsături la piept cu 40 kg"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "20 минут прыжков со скакалкой, затем 3 подхода по 10 жимов лёжа с 40 кг"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "20 dakika ip atlama, ardından 40 kg ile 3 set 10 tekrar bench press"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "20 хвилин стрибків зі скакалкою, потім 3 підходи по 10 жимів лежачи з 40 кг"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳绳 20 分钟，然后以 40 公斤做卧推 3 组，每组 10 次"
          }
        }
      }
    },
