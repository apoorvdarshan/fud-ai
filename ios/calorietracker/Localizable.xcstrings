    "Alternate upper-body, lower-body, and core-focused days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna días de tren superior, tren inferior y core."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدّل بين أيام الجزء العلوي والجزء السفلي والجذع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst bədən, alt bədən və kor əzələlərinə yönəlmiş günləri növbələşdirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Střídej dny zaměřené na horní polovinu těla, dolní polovinu těla a střed těla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle zwischen Tagen für Oberkörper, Unterkörper und Rumpf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternez les jours haut du corps, bas du corps et gainage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऊपरी शरीर, निचले शरीर और कोर पर केंद्रित दिनों को बारी-बारी से करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna giorni dedicati a parte superiore, parte inferiore e core."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上半身、下半身、体幹の日を交互に行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상체, 하체, 코어 중심의 날을 번갈아 진행합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel dagen af voor bovenlichaam, onderlichaam en core."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprzemiennie dni na górę ciała, dół ciała i mięśnie core."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne dias de membros superiores, inferiores e core."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternează zilele pentru partea superioară, partea inferioară și trunchi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чередуйте дни для верха тела, низа тела и кора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üst vücut, alt vücut ve core odaklı günleri dönüşümlü yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чергуйте дні для верхньої частини тіла, нижньої частини тіла та кору."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交替安排上肢、下肢和核心训练日。"
          }
        }
      }
    },
