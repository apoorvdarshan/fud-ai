    "Fud AI chooses the model for Plus and Pro voice. Changes apply to the next conversation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختار Fud AI النموذج لصوت Plus وPro. تُطبَّق التغييرات على المحادثة التالية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus və Pro səsi üçün modeli Fud AI seçir. Dəyişikliklər növbəti söhbətdə tətbiq olunur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Model pro hlas Plus a Pro vybírá Fud AI. Změny se projeví v příští konverzaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Plus- und Pro-Sprache wählt Fud AI das Modell. Änderungen gelten ab dem nächsten Gespräch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI elige el modelo para la voz de Plus y Pro. Los cambios se aplican en la próxima conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI choisit le modèle de la voix Plus et Pro. Les changements s’appliquent à la prochaine conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus और Pro वॉइस के लिए मॉडल Fud AI चुनता है। बदलाव अगली बातचीत से लागू होंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la voce di Plus e Pro il modello lo sceglie Fud AI. Le modifiche valgono dalla prossima conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PlusとProの音声ではFud AIがモデルを選びます。変更は次の会話から反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 및 Pro 음성의 모델은 Fud AI가 선택합니다. 변경 사항은 다음 대화부터 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor Plus- en Pro-spraak kiest Fud AI het model. Wijzigingen gelden vanaf het volgende gesprek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model dla głosu Plus i Pro wybiera Fud AI. Zmiany obowiązują od następnej rozmowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fud AI escolhe o modelo da voz Plus e Pro. As mudanças valem na próxima conversa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru vocea Plus și Pro, modelul îl alege Fud AI. Modificările se aplică la următoarea conversație."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель для голосового режима Plus и Pro выбирает Fud AI. Изменения вступят в силу в следующем разговоре."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ve Pro sesi için modeli Fud AI seçer. Değişiklikler sonraki konuşmada geçerli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель для голосового режиму Plus і Pro обирає Fud AI. Зміни набудуть чинності в наступній розмові."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 和 Pro 语音的模型由 Fud AI 选择。更改将在下一次对话生效。"
          }
        }
      }
    },
