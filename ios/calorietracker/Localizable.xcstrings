    "Talk to Fud AI to log meals, scan barcodes and check your progress.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدّث إلى Fud AI لتسجيل الوجبات ومسح الباركود ومتابعة تقدّمك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeməkləri qeyd etmək, barkodları skan etmək və irəliləyişinizi yoxlamaq üçün Fud AI ilə danışın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mluv s Fud AI a zapisuj jídla, skenuj čárové kódy a sleduj svůj pokrok."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprich mit Fud AI, um Mahlzeiten zu erfassen, Barcodes zu scannen und deinen Fortschritt zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to Fud AI to log meals, scan barcodes and check your progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habla con Fud AI para registrar comidas, escanear códigos de barras y ver tu progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parlez à Fud AI pour enregistrer vos repas, scanner des codes-barres et suivre vos progrès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भोजन लॉग करने, बारकोड स्कैन करने और अपनी प्रगति देखने के लिए Fud AI से बात करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parla con Fud AI per registrare i pasti, scansionare codici a barre e controllare i tuoi progressi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AIに話しかけるだけで、食事の記録、バーコードのスキャン、進捗の確認ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI에게 말해서 식사를 기록하고, 바코드를 스캔하고, 진행 상황을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praat met Fud AI om maaltijden te loggen, barcodes te scannen en je voortgang te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmawiaj z Fud AI, aby zapisywać posiłki, skanować kody kreskowe i sprawdzać postępy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fale com o Fud AI para registrar refeições, escanear códigos de barras e acompanhar seu progresso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorbește cu Fud AI ca să înregistrezi mese, să scanezi coduri de bare și să-ți verifici progresul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорите с Fud AI, чтобы записывать приёмы пищи, сканировать штрихкоды и следить за прогрессом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğün kaydetmek, barkod taramak ve ilerlemenizi görmek için Fud AI ile konuşun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Говоріть із Fud AI, щоб записувати прийоми їжі, сканувати штрихкоди й стежити за прогресом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和 Fud AI 说话，即可记录饮食、扫描条形码并查看进度。"
          }
        }
      }
    },
    "Tap the orb on Home to start.": {
      "localizations": {
        "ar": {
