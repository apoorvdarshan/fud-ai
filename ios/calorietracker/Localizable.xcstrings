    "End or cancel your active fast before logging food.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنه صيامك النشط أو ألغِه قبل تسجيل الطعام."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qida əlavə etməzdən əvvəl aktiv orucu bitirin və ya ləğv edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende oder brich dein aktives Fasten ab, bevor du Essen einträgst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina o cancela el ayuno activo antes de registrar alimentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine ou annule ton jeûne actif avant d’ajouter un aliment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भोजन लॉग करने से पहले सक्रिय उपवास समाप्त या रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina o annulla il digiuno attivo prima di registrare alimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事を記録する前に、進行中の断食を終了またはキャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식을 기록하기 전에 진행 중인 단식을 종료하거나 취소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beëindig of annuleer je actieve vasten voordat je voeding logt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ lub anuluj aktywny post przed dodaniem jedzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerre ou cancele o jejum ativo antes de registrar alimentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încheie sau anulează postul activ înainte de a înregistra alimente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите или отмените активное голодание перед добавлением еды."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть або скасуйте активне голодування перед додаванням їжі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先结束或取消当前禁食，再记录食物。"
