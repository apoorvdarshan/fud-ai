    },
    "Offline Voice notices": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "إشعارات الصوت بلا إنترنت"}},
        "az": {"stringUnit": {"state": "translated", "value": "Oflayn səs bildirişləri"}},
        "cs": {"stringUnit": {"state": "translated", "value": "Oznámení k hlasu offline"}},
        "de": {"stringUnit": {"state": "translated", "value": "Lizenzhinweise zur Offline-Stimme"}},
        "es": {"stringUnit": {"state": "translated", "value": "Avisos de Voz sin conexión"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Mentions de Voix hors ligne"}},
        "hi": {"stringUnit": {"state": "translated", "value": "ऑफ़लाइन आवाज़ के लाइसेंस"}},
        "it": {"stringUnit": {"state": "translated", "value": "Avvisi di Voce offline"}},
        "ja": {"stringUnit": {"state": "translated", "value": "オフライン音声のライセンス"}},
        "ko": {"stringUnit": {"state": "translated", "value": "오프라인 음성 고지"}},
        "nl": {"stringUnit": {"state": "translated", "value": "Licentiemeldingen voor Offline stem"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Informacje o licencjach funkcji Głos offline"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Avisos da Voz offline"}},
        "ro": {"stringUnit": {"state": "translated", "value": "Notificări de licență pentru Voce offline"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Лицензии офлайн-голоса"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Çevrimdışı ses lisans bildirimleri"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Ліцензії офлайн-голосу"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "离线语音许可声明"}}
      }
    },
    "Preparing reply on this device…": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "جارٍ إعداد الرد على هذا الجهاز…"}},
        "az": {"stringUnit": {"state": "translated", "value": "Cavab bu cihazda hazırlanır…"}},
        "cs": {"stringUnit": {"state": "translated", "value": "Příprava odpovědi v tomto zařízení…"}},
        "de": {"stringUnit": {"state": "translated", "value": "Antwort wird auf diesem Gerät erstellt…"}},
        "es": {"stringUnit": {"state": "translated", "value": "Preparando la respuesta en este dispositivo…"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Préparation de la réponse sur cet appareil…"}},
        "hi": {"stringUnit": {"state": "translated", "value": "इस डिवाइस पर जवाब तैयार हो रहा है…"}},
        "it": {"stringUnit": {"state": "translated", "value": "Preparazione della risposta su questo dispositivo…"}},
        "ja": {"stringUnit": {"state": "translated", "value": "このデバイスで返答を準備しています…"}},
        "ko": {"stringUnit": {"state": "translated", "value": "이 기기에서 답변 준비 중…"}},
        "nl": {"stringUnit": {"state": "translated", "value": "Antwoord wordt op dit apparaat voorbereid…"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Przygotowywanie odpowiedzi na tym urządzeniu…"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Preparando a resposta neste dispositivo…"}},
        "ro": {"stringUnit": {"state": "translated", "value": "Se pregătește răspunsul pe acest dispozitiv…"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ответ готовится на этом устройстве…"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Yanıt bu cihazda hazırlanıyor…"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Відповідь готується на цьому пристрої…"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "正在此设备上准备回复…"}}
      }
    },
    "Send recording": {
      "localizations": {
