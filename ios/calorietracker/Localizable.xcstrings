            "value": "Verificarea grăsimii corporale"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка процента жира"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut Yağı Kontrolü"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка відсотка жиру"
          }
