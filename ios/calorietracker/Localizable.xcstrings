    "Train the whole body each workout with broad coverage.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrena todo el cuerpo en cada sesión con una cobertura amplia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "درّب الجسم كله في كل تمرين بتغطية شاملة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər məşqdə bütün bədəni geniş əhatə ilə çalışdırın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při každém tréninku procvič celé tělo se širokým záběrem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainiere bei jeder Einheit den ganzen Körper mit breiter Abdeckung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travaillez tout le corps à chaque séance, avec une couverture large."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर वर्कआउट में व्यापक कवरेज के साथ पूरे शरीर को ट्रेन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allena tutto il corpo a ogni allenamento con una copertura ampia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎回のワークアウトで全身を幅広く鍛えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매 운동마다 전신을 폭넓게 단련합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Train bij elke training het hele lichaam, breed afgedekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenuj całe ciało na każdym treningu, obejmując wszystkie partie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Treine o corpo inteiro em cada treino, com ampla cobertura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenează tot corpul la fiecare antrenament, cu o acoperire largă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прорабатывайте всё тело на каждой тренировке с широким охватом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her antrenmanda tüm vücudu geniş kapsamlı çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Опрацьовуйте все тіло на кожному тренуванні з широким охопленням."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次训练全面覆盖全身。"
          }
        }
      }
    },
