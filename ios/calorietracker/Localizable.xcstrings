          "stringUnit": {
            "state": "translated",
            "value": "वॉइस सेवा ने कनेक्शन अस्वीकार कर दिया (%lld)। फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio vocale ha rifiutato la connessione (%lld). Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声サービスが接続を拒否しました（%lld）。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 서비스가 연결을 거부했습니다(%lld). 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De spraakdienst heeft de verbinding geweigerd (%lld). Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa głosowa odrzuciła połączenie (%lld). Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de voz recusou a conexão (%lld). Tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciul vocal a refuzat conexiunea (%lld). Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голосовой сервис отклонил подключение (%lld). Повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses hizmeti bağlantıyı reddetti (%lld). Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
