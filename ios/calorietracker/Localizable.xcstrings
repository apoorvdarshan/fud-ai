          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per sempre — illimitato sulla tua chiave. Gemini, OpenAI, Groq e altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永久無料 — 自分のキーで無制限。Gemini、OpenAI、Groqなど。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영원히 무료 — 내 키로 무제한. Gemini, OpenAI, Groq 등."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor altijd gratis — onbeperkt op jouw sleutel. Gemini, OpenAI, Groq & meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
