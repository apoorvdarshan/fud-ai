    "Mix compound strength days with accessory hypertrophy work.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina días de fuerza con ejercicios compuestos y trabajo accesorio de hipertrofia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امزج أيام القوة بالتمارين المركبة مع تمارين الضخامة المساعدة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Mürəkkəb güc günlərini köməkçi hipertrofiya işi ilə birləşdirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombinuj silové dny s komplexními cviky s doplňkovou prací na hypertrofii."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kombiniere Krafttage mit Grundübungen und ergänzendem Hypertrophietraining."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez des jours de force sur exercices polyarticulaires à un travail d’hypertrophie complémentaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंपाउंड स्ट्रेंथ वाले दिनों को सहायक हाइपरट्रॉफ़ी वर्क के साथ मिलाएं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Combina giorni di forza sui multiarticolari con lavoro complementare di ipertrofia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多関節種目の筋力デーと補助的な筋肥大トレーニングを組み合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복합 근력 운동 날과 보조 근비대 운동을 섞습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Combineer krachtdagen met samengestelde oefeningen met aanvullend hypertrofiewerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łącz dni siłowe z ćwiczeniami wielostawowymi z dodatkową pracą na hipertrofię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Misture dias de força com exercícios compostos e trabalho acessório de hipertrofia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Combină zilele de forță cu exerciții compuse cu lucru accesoriu pentru hipertrofie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетайте силовые дни с базовыми упражнениями и вспомогательную работу на гипертрофию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bileşik kuvvet günlerini yardımcı hipertrofi çalışmalarıyla birleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поєднуйте силові дні з базовими вправами та допоміжну роботу на гіпертрофію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将复合动作力量日与辅助增肌训练结合。"
          }
        }
      }
    },
