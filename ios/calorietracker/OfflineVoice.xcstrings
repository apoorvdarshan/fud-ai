    "Speech stays on this device. Requested tools can send text, photos or barcodes to your configured services.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "يبقى الصوت على الجهاز. قد ترسل الأدوات المطلوبة نصوصًا أو صورًا أو رموزًا شريطية إلى الخدمات التي اخترتها."}},
        "az": {"stringUnit": {"state": "translated", "value": "Səs bu cihazda qalır. İstənən alətlər mətni, fotoları və ya barkodları seçdiyiniz xidmətlərə göndərə bilər."}},
        "cs": {"stringUnit": {"state": "translated", "value": "Hlas zůstává v zařízení. Vyžádané nástroje mohou odeslat text, fotky nebo čárové kódy do nastavených služeb."}},
        "de": {"stringUnit": {"state": "translated", "value": "Sprache bleibt auf diesem Gerät. Angeforderte Werkzeuge können Text, Fotos oder Barcodes an deine eingerichteten Dienste senden."}},
        "es": {"stringUnit": {"state": "translated", "value": "La voz se queda en el dispositivo. Las herramientas utilizadas pueden enviar texto, fotos o códigos de barras a los servicios configurados."}},
        "fr": {"stringUnit": {"state": "translated", "value": "La voix reste sur cet appareil. Les outils demandés peuvent envoyer du texte, des photos ou des codes-barres aux services configurés."}},
        "hi": {"stringUnit": {"state": "translated", "value": "आवाज़ इसी डिवाइस पर रहती है। आपके कहने पर टूल चुनी हुई सेवाओं को टेक्स्ट, फ़ोटो या बारकोड भेज सकते हैं।"}},
        "it": {"stringUnit": {"state": "translated", "value": "La voce resta sul dispositivo. Gli strumenti richiesti possono inviare testo, foto o codici a barre ai servizi configurati."}},
        "ja": {"stringUnit": {"state": "translated", "value": "音声は端末内に留まります。使用するツールによっては、テキスト、写真、バーコードが設定済みのサービスに送信されます。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "음성은 이 기기에 남습니다. 요청한 도구가 설정된 서비스에 텍스트, 사진 또는 바코드를 보낼 수 있습니다."}},
        "nl": {"stringUnit": {"state": "translated", "value": "Spraak blijft op dit apparaat. Gevraagde tools kunnen tekst, foto’s of barcodes naar de ingestelde diensten sturen."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Głos pozostaje na urządzeniu. Wybrane narzędzia mogą przesłać tekst, zdjęcia lub kody kreskowe do skonfigurowanych usług."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "A voz fica no dispositivo. As ferramentas usadas podem enviar texto, fotos ou códigos de barras aos serviços configurados."}},
        "ro": {"stringUnit": {"state": "translated", "value": "Vocea rămâne pe dispozitiv. Instrumentele folosite pot trimite text, fotografii sau coduri de bare către serviciile configurate."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Голос остаётся на устройстве. Запрошенные инструменты могут отправлять текст, фото или штрихкоды в настроенные сервисы."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Ses bu cihazda kalır. İstenen araçlar yapılandırdığınız servislere metin, fotoğraf veya barkod gönderebilir."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Голос залишається на пристрої. Запитані інструменти можуть надсилати текст, фото чи штрихкоди до налаштованих сервісів."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "语音留在设备上。你要求使用的工具可能会将文本、照片或条形码发送给已配置的服务。"}}
      }
    },
    "Start a new cloud voice session": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "بدء جلسة صوت سحابية جديدة"}},
        "az": {"stringUnit": {"state": "translated", "value": "Yeni bulud səs seansı başlat"}},
        "cs": {"stringUnit": {"state": "translated", "value": "Zahájit novou cloudovou hlasovou relaci"}},
        "de": {"stringUnit": {"state": "translated", "value": "Neue Cloud-Sprachsitzung starten"}},
        "es": {"stringUnit": {"state": "translated", "value": "Iniciar una nueva sesión de voz en la nube"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Démarrer une nouvelle session vocale dans le cloud"}},
        "hi": {"stringUnit": {"state": "translated", "value": "नया क्लाउड आवाज़ सत्र शुरू करें"}},
        "it": {"stringUnit": {"state": "translated", "value": "Avvia una nuova sessione vocale cloud"}},
        "ja": {"stringUnit": {"state": "translated", "value": "新しいクラウド音声セッションを開始"}},
        "ko": {"stringUnit": {"state": "translated", "value": "새 클라우드 음성 세션 시작"}},
        "nl": {"stringUnit": {"state": "translated", "value": "Nieuwe cloudspraaksessie starten"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Rozpocznij nową sesję głosową w chmurze"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Iniciar uma nova sessão de voz na nuvem"}},
        "ro": {"stringUnit": {"state": "translated", "value": "Pornește o sesiune vocală nouă în cloud"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Начать новый голосовой сеанс в облаке"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Yeni bir bulut ses oturumu başlat"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Почати новий голосовий сеанс у хмарі"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "开始新的云端语音会话"}}
      }
    },
    "Stop audio": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "إيقاف الصوت"}},
        "az": {"stringUnit": {"state": "translated", "value": "Səsi dayandır"}},
        "cs": {"stringUnit": {"state": "translated", "value": "Zastavit zvuk"}},
        "de": {"stringUnit": {"state": "translated", "value": "Audio stoppen"}},
        "es": {"stringUnit": {"state": "translated", "value": "Detener audio"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Arrêter le son"}},
        "hi": {"stringUnit": {"state": "translated", "value": "ऑडियो रोकें"}},
        "it": {"stringUnit": {"state": "translated", "value": "Interrompi audio"}},
        "ja": {"stringUnit": {"state": "translated", "value": "音声を停止"}},
        "ko": {"stringUnit": {"state": "translated", "value": "오디오 정지"}},
        "nl": {"stringUnit": {"state": "translated", "value": "Audio stoppen"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zatrzymaj dźwięk"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Parar áudio"}},
        "ro": {"stringUnit": {"state": "translated", "value": "Oprește sunetul"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Остановить звук"}},
        "tr": {"stringUnit": {"state": "translated", "value": "Sesi durdur"}},
        "uk": {"stringUnit": {"state": "translated", "value": "Зупинити звук"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "停止播放"}}
      }
    },
    "You must tap to start a new cloud session. Previous recordings are never sent.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "اضغط لبدء جلسة سحابية جديدة. لا تُرسل التسجيلات السابقة مطلقًا."}},
        "az": {"stringUnit": {"state": "translated", "value": "Yeni bulud seansını başlatmaq üçün toxunun. Əvvəlki yazılar heç vaxt göndərilmir."}},
        "cs": {"stringUnit": {"state": "translated", "value": "Klepnutím zahájíte novou cloudovou relaci. Předchozí nahrávky se nikdy neodesílají."}},
        "de": {"stringUnit": {"state": "translated", "value": "Tippe, um eine neue Cloud-Sitzung zu starten. Frühere Aufnahmen werden nie gesendet."}},
        "es": {"stringUnit": {"state": "translated", "value": "Toca para iniciar una nueva sesión en la nube. Nunca se envían las grabaciones anteriores."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Touchez pour démarrer une nouvelle session dans le cloud. Aucun enregistrement précédent n’est envoyé."}},
        "hi": {"stringUnit": {"state": "translated", "value": "नया क्लाउड सत्र शुरू करने के लिए टैप करें। पिछली रिकॉर्डिंग कभी नहीं भेजी जातीं।"}},
        "it": {"stringUnit": {"state": "translated", "value": "Tocca per avviare una nuova sessione cloud. Le registrazioni precedenti non vengono mai inviate."}},
        "ja": {"stringUnit": {"state": "translated", "value": "タップすると新しいクラウドセッションを開始します。以前の録音は送信されません。"}},
        "ko": {"stringUnit": {"state": "translated", "value": "탭하여 새 클라우드 세션을 시작하세요. 이전 녹음은 보내지 않습니다."}},
        "nl": {"stringUnit": {"state": "translated", "value": "Tik om een nieuwe cloudsessie te beginnen. Eerdere opnamen worden nooit verstuurd."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Stuknij, aby zacząć nową sesję w chmurze. Poprzednie nagrania nigdy nie są wysyłane."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Toque para iniciar uma nova sessão na nuvem. As gravações anteriores nunca são enviadas."}},
        "ro": {"stringUnit": {"state": "translated", "value": "Atinge pentru a porni o sesiune nouă în cloud. Înregistrările anterioare nu sunt trimise niciodată."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Нажмите, чтобы начать новый облачный сеанс. Предыдущие записи никогда не отправляются."}},
        "tr": {"stringUnit": {"state": "translated", "value": "Yeni bir bulut oturumu başlatmak için dokunun. Önceki kayıtlar asla gönderilmez."}},
        "uk": {"stringUnit": {"state": "translated", "value": "Торкніться, щоб почати новий хмарний сеанс. Попередні записи ніколи не надсилаються."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "点按以开始新的云端会话。之前的录音绝不会被发送。"}}
      }
    }
  },
  "version": "1.0"
}
