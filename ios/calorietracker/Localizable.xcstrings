    "Custom timed activity · calorie estimate uses a general activity rate": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad cronometrada personalizada · la estimación de calorías usa una tasa de actividad general"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel süreli etkinlik · kalori tahmini genel bir etkinlik yakım oranını kullanır"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نشاط مخصص محدد بالوقت · يستخدم تقدير السعرات معدل نشاط عامًا"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fərdi vaxtlı fəaliyyət · kalori təxmini ümumi fəaliyyət dərəcəsindən istifadə edir"
          }
        },
        "cs": {
