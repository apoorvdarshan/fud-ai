    "Hide breakfast, lunch, and dinner reminders while this Focus is active.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los recordatorios de desayuno, almuerzo y cena mientras este modo de concentración esté activo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi i promemoria di colazione, pranzo e cena mentre questa Full immersion è attiva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukryj przypomnienia o śniadaniu, obiedzie i kolacji, gdy ten Tryb skupienia jest aktywny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать напоминания о завтраке, обеде и ужине, пока активен этот фокус."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приховувати нагадування про сніданок, обід і вечерю, поки активний цей режим зосередження."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrýt připomenutí snídaně, oběda a večeře, dokud je tento režim soustředění aktivní."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Odak modu etkinken kahvaltı, öğle ve akşam yemeği hatırlatmalarını gizle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخفاء تذكيرات الإفطار والغداء والعشاء أثناء تفعيل وضع التركيز هذا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Fokus aktiv olduqda səhər yeməyi, nahar və şam yeməyi xatırlatmalarını gizlət."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frühstücks-, Mittags- und Abendessen-Erinnerungen ausblenden, solange dieser Fokus aktiv ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les rappels du petit-déjeuner, du déjeuner et du dîner tant que ce mode de concentration est actif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोकस सक्रिय रहने तक नाश्ते, लंच और रात के भोजन के रिमाइंडर छिपाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この集中モードがオンの間、朝食・昼食・夕食のリマインダーを非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 집중 모드가 켜져 있는 동안 아침, 점심, 저녁 알림을 숨깁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontbijt-, lunch- en dinerherinneringen verbergen zolang deze focus actief is."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar lembretes de café da manhã, almoço e jantar enquanto este Foco estiver ativo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascunde mementourile pentru micul dejun, prânz și cină cât timp acest mod Concentrare este activ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此专注模式开启时隐藏早餐、午餐和晚餐提醒。"
          }
        }
      }
    },
