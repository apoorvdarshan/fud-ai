            "state": "translated",
            "value": "कैलोरी, प्रोटीन, कार्ब्स और वसा के लक्ष्यों से अलग।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Separato dagli obiettivi di calorie, proteine, carboidrati e grassi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カロリー・タンパク質・炭水化物・脂質の目標とは別です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칼로리, 단백질, 탄수화물, 지방 목표와 별개입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Los van de doelen voor calorieën, eiwitten, koolhydraten en vet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddzielnie od celów kalorii, białka, węglowodanów i tłuszczu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
