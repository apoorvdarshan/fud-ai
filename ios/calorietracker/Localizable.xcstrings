        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rediseño de Inicio: velocímetro de calorías, barras verticales de macros, cuatro tarjetas de nutrientes y un botón flotante para añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
