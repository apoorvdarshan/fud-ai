    "Reports contain only the participant ID, selected reason, and optional details you type. No health or food data is included.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتضمن البلاغ سوى معرّف المشارك والسبب المحدد والتفاصيل الاختيارية، ولا يتضمن بياناتك الصحية أبدًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Şikayətinizə yalnız iştirakçı ID-si, seçilmiş səbəb və istəyə bağlı təfərrüatlar daxildir, sağlamlıq məlumatlarınız isə heç vaxt daxil edilmir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Meldung enthält nur die Teilnehmer-ID, den ausgewählten Grund und optionale Details – niemals deine Gesundheitsdaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports contain only the participant ID, selected reason, and optional details you type. No health or food data is included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu denuncia solo incluye el ID del participante, el motivo elegido y los detalles opcionales; nunca tus datos de salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre signalement contient uniquement l’identifiant du participant, le motif choisi et les détails facultatifs, jamais vos données de santé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रिपोर्ट में केवल प्रतिभागी ID, चुना गया कारण और वैकल्पिक विवरण शामिल होते हैं—आपका स्वास्थ्य डेटा कभी नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La segnalazione include solo l’ID del partecipante, il motivo scelto e i dettagli facoltativi, mai i tuoi dati sanitari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告に含まれるのは参加者ID、選択した理由、任意の詳細だけで、あなたの健康データは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고에는 참가자 ID, 선택한 이유, 선택적 세부 정보만 포함되며 건강 데이터는 포함되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je melding bevat alleen de deelnemers-ID, gekozen reden en optionele details, nooit je gezondheidsgegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raporty zawierają tylko identyfikator uczestnika, wybrany powód i opcjonalne dane, które wpisujesz. Nie uwzględniono danych dotyczących zdrowia ani żywności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua denúncia inclui somente o ID do participante, o motivo selecionado e os detalhes opcionais, nunca seus dados de saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Raportul include doar ID-ul participantului, motivul selectat și detaliile opționale, niciodată datele tale de sănătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалоба содержит только ID участника, выбранную причину и необязательные сведения — ваши данные о здоровье не включаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалоба содержит только ID участника, вибранную причину и необязательние сведения — ваши данние о здоровье не включаются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报仅包含参与者 ID、所选原因和可选详情，绝不包含您的健康数据。"
          }
        }
      }
    },
