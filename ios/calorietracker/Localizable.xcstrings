          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを戻しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 되돌리는 중…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens worden teruggehaald…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywracanie danych…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazendo seus dados de volta…"
          }
        },
        "ro": {
