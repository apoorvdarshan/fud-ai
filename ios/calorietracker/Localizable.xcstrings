    },
    "Keep the name under 60 characters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name darf höchstens 60 Zeichen lang sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the name under 60 characters."
          }
