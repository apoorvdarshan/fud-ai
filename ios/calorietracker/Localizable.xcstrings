    "Just snap, track, and thrive.\nYour nutrition, simplified.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo toma una foto, registra y progresa.\nTu nutrición, simplificada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scatta, registra e raggiungi i tuoi obiettivi.\nLa tua nutrizione, semplificata."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po prostu zrób zdjęcie, śledź i rozwijaj się.\nTwoje odżywianie, uproszczone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фотографируй, записывай и будь здоров.\nПитание стало проще."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просто фотографуй, записуй і процвітай.\nХарчування — простіше."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyfoť, zapisuj a měj se líp.\nTvoje výživa, jednoduše."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafını çek, takip et ve iyi yaşa.\nBeslenmeni kolayca yönet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط التقط، تتبّع، وازدهر.\nتغذيتك، مبسطة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadəcə şəkil çək, izlə və inkişaf et.\nQidalanmanız sadələşdirildi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfach fotografieren, tracken und durchstarten.\nDeine Ernährung, vereinfacht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une photo, suivez et progressez.\nVotre nutrition, simplifiée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बस स्नैप करें, ट्रैक करें और फलें-फूलें।\nआपका पोषण, सरल बनाया गया।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮って、記録して、健康に。\nあなたの栄養管理を、シンプルに。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 찍고, 기록하고, 활기차게.\n간편해진 영양 관리."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap, registreer en bloei op.\nJouw voeding, vereenvoudigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta tirar foto, registrar e prosperar.\nSua nutrição, simplificada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar fă o poză, urmărește și prosperă.\nNutriția ta, simplificată."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只需拍照、记录、享受。\n让你的营养更简单。"
          }
        }
      }
    },
