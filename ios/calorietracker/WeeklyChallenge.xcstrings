        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं कम्युनिटी नियम स्वीकार करता/करती हूँ और किसी की नकल न करने वाली सम्मानजनक प्रोफ़ाइल का उपयोग करूँगा/करूँगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accetto le Regole della community e userò un profilo rispettoso che non imiti altre persone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティルールに同意し、他人になりすまさない礼儀正しいプロフィールを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커뮤니티 규칙에 동의하며 다른 사람을 사칭하지 않는 정중한 프로필을 사용하겠습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik accepteer de Communityregels en gebruik een respectvol profiel waarmee ik me niet als iemand anders voordoe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Akceptuję Zasady społeczności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceito as Regras da comunidade e usarei um perfil respeitoso, sem fingir ser outra pessoa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Accept Regulile comunității și voi folosi un profil respectuos, fără uzurparea identității."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я принимаю Правила сообщества и буду использовать уважительный профиль, не выдавая себя за других."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитати Правила спільноти"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我接受社区规则，并会使用尊重他人且不冒充他人的个人资料。"
          }
        }
      }
    },
    "I am 18 or older": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أؤكد أن عمري 18 عامًا أو أكثر. لا يصل Fud AI إلى تاريخ ميلادي ولا يرفعه."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "18 və ya daha böyük yaşda olduğumu təsdiq edirəm. Fud AI doğum tariximə daxil olmur və onu göndərmir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bestätige, dass ich mindestens 18 Jahre alt bin. Fud AI greift nicht auf mein Geburtsdatum zu und lädt es nicht hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I am 18 or older"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmo que tengo 18 años o más. Fud AI no accede a mi fecha de nacimiento ni la sube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je confirme avoir au moins 18 ans. Fud AI n’accède pas à ma date de naissance et ne l’envoie pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं पुष्टि करता/करती हूँ कि मेरी उम्र 18 वर्ष या अधिक है। Fud AI मेरी जन्मतिथि को ऐक्सेस या अपलोड नहीं करता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermo di avere almeno 18 anni. Fud AI non accede né carica la mia data di nascita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "18歳以上であることを確認します。Fud AI は生年月日にアクセスしたりアップロードしたりしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만 18세 이상임을 확인합니다. Fud AI는 생년월일에 접근하거나 업로드하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik bevestig dat ik 18 jaar of ouder ben. Fud AI opent of uploadt mijn geboortedatum niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mam ukończone 18 lat"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmo que tenho 18 anos ou mais. O Fud AI não acessa nem envia minha data de nascimento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm că am cel puțin 18 ani. Fud AI nu accesează și nu încarcă data mea de naștere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я подтверждаю, что мне не менее 18 лет. Fud AI не получает и не отправляет мою дату рождения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я подтверждаю, что мне не менее 18 лет. Fud AI не получает и не отправляет мою дату рождения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我确认已年满 18 岁。Fud AI 不会访问或上传我的出生日期。"
          }
        }
      }
    },
