            "value": "Restaurezi backupul?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановить резервную копию?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复备份？"
          }
        }
      }
    },
    "Restore it, or keep this phone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restáurala o conserva los datos de este teléfono."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити її чи залишити цей телефон?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedeği geri yükleyin veya bu telefondaki verileri koruyun."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعدها، أو احتفظ ببيانات هذا الهاتف."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Onu bərpa edin və ya bu telefondakı məlumatları saxlayın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnov ji, nebo si ponech data v tomto telefonu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle es wieder her oder behalte die Daten dieses Telefons."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurez-la ou conservez les données de ce téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे पुनर्स्थापित करें, या इस फ़ोन का डेटा रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristinalo oppure mantieni i dati di questo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元するか、この電話のデータをそのまま使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원하거나 이 휴대폰의 데이터를 유지하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet hem terug of behoud de gegevens op deze telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć ją lub zachowaj dane z tego telefonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure-o ou mantenha os dados deste telefone."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurează-l sau păstrează datele de pe acest telefon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановите её или оставьте данные этого телефона."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复备份，或保留此手机上的数据。"
          }
        }
      }
    },
