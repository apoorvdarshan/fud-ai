    "Free forever — unlimited on your key. Gemini, OpenAI, Groq & more.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجاني للأبد — غير محدود على مفتاحك. Gemini وOpenAI وGroq والمزيد."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Həmişəlik pulsuz — açarınızda limitsiz. Gemini, OpenAI, Groq və s."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für immer kostenlos — unbegrenzt mit deinem Schlüssel. Gemini, OpenAI, Groq & mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis para siempre — ilimitado con tu clave. Gemini, OpenAI, Groq y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pour toujours — illimité sur ta clé. Gemini, OpenAI, Groq et plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
