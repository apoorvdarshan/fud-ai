    "Plus includes 20 minutes and Pro 100 minutes a month (UTC). After that, voice uses credits: 1 credit per 15 seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشمل Plus ‏20 دقيقة وPro ‏100 دقيقة شهريًا (بتوقيت UTC). بعد ذلك يستخدم الصوت الأرصدة: رصيد واحد لكل 15 ثانية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ayda 20 dəqiqə, Pro isə 100 dəqiqə daxil edir (UTC). Bundan sonra səs kredit istifadə edir: hər 15 saniyəyə 1 kredit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus obsahuje 20 minut a Pro 100 minut měsíčně (UTC). Potom hlas čerpá kredity: 1 kredit za 15 sekund."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus enthält 20 Minuten und Pro 100 Minuten pro Monat (UTC). Danach nutzt die Sprachfunktion Credits: 1 Credit pro 15 Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus incluye 20 minutos y Pro 100 minutos al mes (UTC). Después, la voz usa créditos: 1 crédito cada 15 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus inclut 20 minutes et Pro 100 minutes par mois (UTC). Ensuite, la voix utilise des crédits : 1 crédit par tranche de 15 secondes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus में हर महीने 20 मिनट और Pro में 100 मिनट शामिल हैं (UTC)। उसके बाद वॉइस क्रेडिट इस्तेमाल करता है: हर 15 सेकंड पर 1 क्रेडिट।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus include 20 minuti e Pro 100 minuti al mese (UTC). Dopo, la voce usa i crediti: 1 credito ogni 15 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusには月20分、Proには月100分が含まれます（UTC）。それを超えると音声はクレジットを使用します（15秒ごとに1クレジット）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus는 매월 20분, Pro는 매월 100분이 포함됩니다(UTC 기준). 이후에는 음성에 크레딧이 사용됩니다(15초당 1크레딧)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus bevat 20 minuten en Pro 100 minuten per maand (UTC). Daarna gebruikt spraak credits: 1 credit per 15 seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus obejmuje 20 minut, a Pro 100 minut miesięcznie (UTC). Potem głos zużywa kredyty: 1 kredyt za 15 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Plus inclui 20 minutos e o Pro 100 minutos por mês (UTC). Depois disso, a voz usa créditos: 1 crédito a cada 15 segundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus include 20 de minute, iar Pro 100 de minute pe lună (UTC). După aceea, vocea folosește credite: 1 credit la fiecare 15 secunde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Plus входит 20 минут, в Pro — 100 минут в месяц (UTC). Дальше голосовой режим расходует кредиты: 1 кредит за 15 секунд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus ayda 20 dakika, Pro ise 100 dakika içerir (UTC). Sonrasında ses kredi kullanır: her 15 saniye için 1 kredi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У Plus входить 20 хвилин, у Pro — 100 хвилин на місяць (UTC). Далі голосовий режим витрачає кредити: 1 кредит за 15 секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus 每月包含 20 分钟，Pro 每月包含 100 分钟（UTC）。超出后，语音将使用点数：每 15 秒 1 点。"
          }
        }
      }
    },
