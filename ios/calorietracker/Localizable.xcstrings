    "Food photos, voice transcripts, and typed meals are sent directly to your selected AI provider.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل صور الطعام والنصوص الصوتية والوجبات المكتوبة مباشرة إلى مزوّد الذكاء الاصطناعي الذي اخترته."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yemək şəkilləri, səs transkriptləri və yazılmış yeməklər birbaşa seçdiyiniz Sİ provayderinə göndərilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Essensfotos, Sprachtranskripte und getippte Mahlzeiten werden direkt an deinen gewählten KI-Anbieter gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos de comida, transcripciones de voz y comidas escritas se envían directamente a tu proveedor de IA seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos de repas, transcriptions vocales et repas saisis sont envoyés directement à votre fournisseur d'IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाने की फ़ोटो, वॉइस ट्रांसक्रिप्ट और टाइप किए गए मील सीधे आपके चुने हुए AI प्रोवाइडर को भेजे जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto dei pasti, trascrizioni vocali e pasti digitati vengono inviati direttamente al provider IA selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食事の写真、音声の書き起こし、入力した食事は選択したAIプロバイダーに直接送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식 사진, 음성 전사, 입력한 식사는 선택한 AI 제공업체로 직접 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voedselfoto's, spraaktranscripties en getypte maaltijden gaan rechtstreeks naar je gekozen AI-provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia jedzenia, transkrypcje głosowe i wpisane posiłki trafiają bezpośrednio do wybranego dostawcy AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos de comida, transcrições de voz e refeições digitadas são enviadas diretamente ao provedor de IA selecionado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozele cu mâncare, transcrierile vocale și mesele tastate sunt trimise direct furnizorului IA ales."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото еды, голосовые расшифровки и введённые блюда отправляются напрямую выбранному ИИ-провайдеру."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото їжі, голосові розшифровки та введені страви надсилаються безпосередньо вибраному провайдеру ШІ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食物照片、语音转写和输入的餐食会直接发送给你选择的 AI 服务商。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotky jídla, hlasové přepisy a napsaná jídla se posílají přímo tvému vybranému AI poskytovateli."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yiyecek fotoğrafları, ses kayıtlarının metin dökümleri ve yazdığınız öğünler doğrudan seçtiğiniz yapay zeka sağlayıcısına gönderilir."
          }
        }
      }
    },
    "Foods will be copied to %@. The original entries stay unchanged.": {
      "comment": "A footer that explains that the foods copied from a previous day will be added to the current day, but the original entries will remain unchanged. The argument is the string “today”.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los alimentos se copiarán a %@. Los registros originales no cambian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli alimenti verranno copiati in %@. Le voci originali rimarranno invariate."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkty zostaną skopiowane do %@. Oryginalne wpisy pozostaną bez zmian."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продукты будут скопированы в %@. Исходные записи останутся без изменений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продукти буде скопійовано в %@. Початкові записи залишаться без змін."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jídla se zkopírují do: %@. Původní záznamy zůstanou beze změny."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yiyecekler %@ konumuna kopyalanacak. Orijinal kayıtlar değişmeden kalacak."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم نسخ الأطعمة إلى %@. تبقى الإدخالات الأصلية دون تغيير."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qidalar %@ tarixinə kopyalanacaq. Orijinal qeydlər dəyişməz qalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lebensmittel werden nach %@ kopiert. Die ursprünglichen Einträge bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aliments seront copiés vers %@. Les entrées d’origine restent inchangées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाद्य पदार्थ %@ में कॉपी किए जाएंगे। मूल प्रविष्टियाँ अपरिवर्तित रहेंगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食品は%@にコピーされます。元の記録は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식이 %@(으)로 복사됩니다. 원래 항목은 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voedingsmiddelen worden gekopieerd naar %@. De oorspronkelijke items blijven ongewijzigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alimentos serão copiados para %@. Os registros originais não mudam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alimentele vor fi copiate în %@. Intrările originale rămân neschimbate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食物将复制到%@。原始记录保持不变。"
          }
        }
      }
    },
