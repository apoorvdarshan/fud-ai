          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege între unul și patru nutrienți pentru rândul de rezumat de pe Acasă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите от одного до четырёх нутриентов для сводки на главном экране."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть рівно чотири нутрієнти для рядка підсумків на Головній."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为主页摘要行选择一到四种营养素。"
          }
        }
      }
    },
    "Pick one to four nutrients. Water is shown after them while tracking is enabled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige de uno a cuatro nutrientes. El agua se muestra después de ellos mientras el seguimiento esté activado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من عنصر إلى أربعة عناصر غذائية. يظهر الماء بعدها أثناء تفعيل التتبع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Birdən dördə qədər qida maddəsi seçin. İzləmə aktiv olduqda su onlardan sonra göstərilir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber jednu až čtyři živiny. Pokud je sledování zapnuté, za nimi se zobrazí voda."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein bis vier Nährstoffe. Wasser wird danach angezeigt, solange die Aufzeichnung aktiviert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un à quatre nutriments. L’eau s’affiche ensuite tant que le suivi est activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक से चार पोषक तत्व चुनें। ट्रैकिंग चालू रहने पर उनके बाद पानी दिखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli da uno a quattro nutrienti. L’acqua viene mostrata dopo, finché il monitoraggio è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "栄養素を1〜4個選んでください。記録がオンの間は、その後に水分が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영양소를 1~4개 선택하세요. 기록이 켜져 있으면 그 뒤에 물이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies één tot vier voedingsstoffen. Water wordt daarna getoond zolang bijhouden is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz od jednego do czterech składników. Gdy śledzenie jest włączone, po nich pokazuje się woda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha de um a quatro nutrientes. A água aparece depois deles enquanto o registro estiver ativado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege între unul și patru nutrienți. Apa apare după ei cât timp urmărirea este activată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите от одного до четырёх нутриентов. При включённом учёте воды вода отображается после них."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ile üç arasında besin seçin. Su takibi etkinken bunlardan sonra gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оберіть від одного до чотирьох нутрієнтів. При увімкненому відстеженні води вода відображається після них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一到四种营养素。开启饮水记录时，饮水会显示在它们之后。"
          }
        }
      }
    },
