    "Removes the Fud AI file from iCloud. This iPhone is unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el archivo de Fud AI de iCloud. Este iPhone no cambia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє файл Fud AI з iCloud. Цей iPhone залишається без змін."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI dosyasını iCloud'dan kaldırır. Bu iPhone'daki veriler değişmez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل ملف Fud AI من iCloud. لا يتغير شيء على هذا الـ iPhone."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI faylını iCloud-dan silir. Bu iPhone dəyişmir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní soubor Fud AI z iCloudu. Tento iPhone zůstane beze změny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die Fud AI-Datei aus iCloud. Dieses iPhone bleibt unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le fichier Fud AI d’iCloud. Cet iPhone n’est pas modifié."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud से Fud AI फ़ाइल हटाता है। इस iPhone में कोई बदलाव नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove il file di Fud AI da iCloud. Questo iPhone resta invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudからFud AIのファイルを削除します。このiPhoneは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에서 Fud AI 파일을 삭제합니다. 이 iPhone은 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert het Fud AI-bestand uit iCloud. Deze iPhone blijft ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa plik Fud AI z iCloud. Ten iPhone pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o arquivo do Fud AI do iCloud. Este iPhone não é alterado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină fișierul Fud AI din iCloud. Acest iPhone rămâne neschimbat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет файл Fud AI из iCloud. Этот iPhone не изменится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 iCloud 删除 Fud AI 文件。此 iPhone 不受影响。"
          }
        }
      }
    },
