          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts gözlənilməz cavab qaytardı."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Food Facts hat eine unerwartete Antwort zurückgegeben."
          }
        },
        "en": {
