    "Enable Fasting Tracking in Settings to use this shortcut.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل تتبع الصيام في الإعدادات لاستخدام هذا الاختصار."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu qısayoldan istifadə etmək üçün Parametrlərdə Oruc izləməni aktiv edin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Fasten-Tracking in den Einstellungen, um diese Kurzaktion zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Fasting Tracking in Settings to use this shortcut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el seguimiento de ayuno en Ajustes para usar este atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le suivi du jeûne dans Réglages pour utiliser ce raccourci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस शॉर्टकट का उपयोग करने के लिए सेटिंग्स में उपवास ट्रैकिंग चालू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva il monitoraggio digiuno in Impostazioni per usare questa scorciatoia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このショートカットを使うには、設定で断食トラッキングをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단축키를 사용하려면 설정에서 단식 추적을 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel Vasten bijhouden in Instellingen in om deze snelkoppeling te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Śledzenie postu w Ustawieniach, aby użyć tego skrótu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Acompanhamento de jejum em Ajustes para usar este atalho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează Urmărirea postului în Setări pentru a folosi această scurtătură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите отслеживание голодания в Настройках, чтобы использовать этот ярлык."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть відстеження голодування в налаштуваннях, щоб використовувати це швидке посилання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中开启禁食追踪以使用此快捷方式。"
          }
        }
      }
    },
    "Keep your nutrition, steps, and body\nmeasurements in sync automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حافظ على تزامن التغذية والخطوات\nوقياسات الجسم تلقائيًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qidalanma, addımlar və bədən\nölçülərini avtomatik sinxron saxlayın."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte Ernährung, Schritte und Körper-\nmaße automatisch synchron."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén tu nutrición, pasos y medidas\ncorporales sincronizados automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez votre nutrition, vos pas et vos mesures\ncorporelles synchronisés automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पोषण, कदम और शरीर के\nमाप को अपने आप सिंक रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni sincronizzati automaticamente nutrizione, passi\ne misure corporee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "栄養、歩数、身体測定を\n自動的に同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영양, 걸음 수, 신체 측정을\n자동으로 동기화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je voeding, stappen en lichaams-\nmetingen automatisch gesynchroniseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj automatycznie odżywianie, kroki\ni pomiary ciała."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha nutrição, passos e medidas\ncorporais sincronizados automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează sincronizate automat nutriția, pașii\nși măsurătorile corporale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизируйте питание, шаги и измерения\nтела автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизируйте питание, шаги и измерения\nтела автоматически."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动同步营养、步数和身体\n测量数据。"
          }
        }
      }
    },
