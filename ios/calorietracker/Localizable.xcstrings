        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे भोजन आपकी डायरी से हट जाता है। सहेजे गए पसंदीदा बने रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’alimento viene rimosso dal diario. I preferiti salvati restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この食品を日記から削除します。保存したお気に入りは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일기에서 이 음식을 제거합니다. 저장한 즐겨찾기는 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt het voedingsmiddel uit je dagboek verwijderd. Opgeslagen favorieten blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usunie jedzenie z dziennika. Zapisane ulubione zostaną zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o alimento do seu diário. Os favoritos salvos são mantidos."
