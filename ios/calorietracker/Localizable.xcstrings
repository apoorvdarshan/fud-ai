    "iCloud restores first, then Apple Health adds only what's missing. Nothing gets overwritten.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم الاستعادة من iCloud أولًا، ثم يضيف Apple Health ما ينقص فقط. لن يُستبدل أي شيء."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Əvvəlcə iCloud bərpa olunur, sonra Apple Health yalnız çatışmayanları əlavə edir. Heç nə üzərinə yazılmır."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív se obnoví iCloud, potom Apple Health doplní jen to, co chybí. Nic se nepřepíše."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst wird iCloud wiederhergestellt, dann ergänzt Apple Health nur, was fehlt. Nichts wird überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se restaura iCloud y luego Apple Health añade solo lo que falta. No se sobrescribe nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est restauré en premier, puis Apple Health ajoute uniquement ce qui manque. Rien n’est écrasé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले iCloud रीस्टोर होता है, फिर Apple Health सिर्फ़ वही जोड़ता है जो नहीं है। कुछ भी ओवरराइट नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima viene ripristinato iCloud, poi Apple Health aggiunge solo ciò che manca. Non viene sovrascritto nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にiCloudから復元し、そのあとApple Healthから足りないデータだけを追加します。上書きされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud를 먼저 복원한 다음 Apple Health에서 빠진 항목만 추가해요. 아무것도 덮어쓰지 않아요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerst wordt iCloud teruggezet, daarna voegt Apple Health alleen toe wat ontbreekt. Er wordt niets overschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw przywracany jest iCloud, a potem Apple Health dodaje tylko to, czego brakuje. Nic nie zostanie nadpisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro o iCloud é restaurado, depois o Apple Health adiciona só o que falta. Nada é substituído."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai întâi se restaurează iCloud, apoi Apple Health adaugă doar ce lipsește. Nimic nu este suprascris."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала восстанавливается iCloud, затем Apple Health добавляет только недостающее. Ничего не перезаписывается."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce iCloud geri yüklenir, ardından Apple Sağlık yalnızca eksik olanları ekler. Hiçbir şeyin üzerine yazılmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу відновлюється iCloud, потім Apple Health додає лише те, чого бракує. Нічого не перезаписується."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先从 iCloud 恢复，再由 Apple Health 补充缺少的数据，不会覆盖任何内容。"
          }
        }
      }
    },
    "Bringing your data back…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ استعادة بياناتك…"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məlumatlarınız geri qaytarılır…"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vracíme tvoje data…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten werden zurückgeholt …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperando tus datos…"
          }
        },
        "fr": {
