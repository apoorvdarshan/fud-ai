    "This conversation reached the 15-minute limit. Start a new one to keep going.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغت هذه المحادثة حد الـ 15 دقيقة. ابدأ محادثة جديدة لتتابع."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu söhbət 15 dəqiqəlik limitə çatdı. Davam etmək üçün yenisini başladın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahle konverzace dosáhla limitu 15 minut. Pokračuj tím, že začneš novou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gespräch hat das Limit von 15 Minuten erreicht. Starte ein neues, um weiterzumachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación llegó al límite de 15 minutos. Empieza otra para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation a atteint la limite de 15 minutes. Lancez-en une nouvelle pour continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह बातचीत 15 मिनट की सीमा तक पहुँच गई। जारी रखने के लिए नई बातचीत शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa conversazione ha raggiunto il limite di 15 minuti. Avviane una nuova per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話は15分の上限に達しました。続けるには新しい会話を始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화가 15분 한도에 도달했습니다. 계속하려면 새 대화를 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit gesprek heeft de limiet van 15 minuten bereikt. Begin een nieuw gesprek om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta rozmowa osiągnęła limit 15 minut. Zacznij nową, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa chegou ao limite de 15 minutos. Comece outra para continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această conversație a atins limita de 15 minute. Începe una nouă ca să continui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот разговор достиг лимита в 15 минут. Начните новый, чтобы продолжить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konuşma 15 dakikalık sınıra ulaştı. Devam etmek için yeni bir konuşma başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця розмова досягла ліміту в 15 хвилин. Почніть нову, щоб продовжити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次对话已达到 15 分钟上限。开始新的对话即可继续。"
          }
        }
      }
    },
    "Too many voice sessions right now. Try again in a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عدد كبير جدًا من الجلسات الصوتية الآن. حاول مرة أخرى بعد دقيقة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırda çox sayda səsli sessiya var. Bir dəqiqədən sonra yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Teď probíhá příliš mnoho hlasových relací. Zkus to znovu za minutu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerade laufen zu viele Sprachsitzungen. Versuch es in einer Minute noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiadas sesiones de voz ahora mismo. Inténtalo de nuevo en un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de sessions vocales en ce moment. Réessayez dans une minute."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी बहुत अधिक वॉइस सत्र चल रहे हैं। एक मिनट में फिर से कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppe sessioni vocali in questo momento. Riprova tra un minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、音声セッションが混み合っています。1分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 음성 세션이 너무 많습니다. 1분 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn nu te veel spraaksessies. Probeer het over een minuut opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za dużo sesji głosowych w tej chwili. Spróbuj ponownie za minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há sessões de voz demais agora. Tente de novo em um minuto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt prea multe sesiuni vocale acum. Încearcă din nou peste un minut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас слишком много голосовых сеансов. Повторите попытку через минуту."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anda çok fazla sesli oturum var. Bir dakika sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз забагато голосових сеансів. Спробуйте ще раз за хвилину."
          }
