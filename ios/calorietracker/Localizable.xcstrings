    "Stop and save an exercise timer, or enter reps for a strength exercise on %@, before calculating workout calories.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén y guarda el temporizador de un ejercicio, o introduce las repeticiones de un ejercicio de fuerza el %@, antes de calcular las calorías del entrenamiento."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف واحفظ مؤقت تمرين، أو أدخل التكرارات لتمرين قوة في %@، قبل حساب سعرات التمرين."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Məşq kalorilərini hesablamazdan əvvəl hərəkət taymerini dayandırıb saxlayın və ya %@ tarixində güc hərəkəti üçün təkrarları daxil edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Než spočítáš kalorie z tréninku, zastav a ulož časovač cviku nebo zadej opakování u silového cviku dne %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppe und speichere einen Übungstimer oder gib für eine Kraftübung am %@ Wiederholungen ein, bevor du die Trainingskalorien berechnest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez et enregistrez un minuteur d’exercice, ou saisissez les répétitions d’un exercice de force le %@, avant de calculer les calories de l’entraînement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कआउट कैलोरी की गणना से पहले किसी एक्सरसाइज़ टाइमर को रोककर सहेजें, या %@ को किसी स्ट्रेंथ एक्सरसाइज़ के रेप्स दर्ज करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferma e salva il timer di un esercizio, oppure inserisci le ripetizioni di un esercizio di forza del %@, prima di calcolare le calorie dell’allenamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークアウトのカロリーを計算する前に、種目のタイマーを停止して保存するか、%@の筋トレ種目に回数を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 칼로리를 계산하기 전에 운동 타이머를 중지하고 저장하거나, %@의 근력 운동에 반복 횟수를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop en bewaar een oefeningstimer, of voer herhalingen in voor een krachtoefening op %@, voordat je de trainingscalorieën berekent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zanim obliczysz kalorie treningu, zatrzymaj i zapisz minutnik ćwiczenia albo wpisz powtórzenia ćwiczenia siłowego z dnia %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare e salve o cronômetro de um exercício ou informe as repetições de um exercício de força em %@ antes de calcular as calorias do treino."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprește și salvează cronometrul unui exercițiu sau introdu repetările pentru un exercițiu de forță din %@ înainte de a calcula caloriile antrenamentului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежде чем рассчитывать калории тренировки, остановите и сохраните таймер упражнения или введите повторения для силового упражнения за %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenman kalorilerini hesaplamadan önce bir egzersiz zamanlayıcısını durdurup kaydedin veya %@ tarihindeki bir kuvvet egzersizi için tekrar girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перш ніж розраховувати калорії тренування, зупиніть і збережіть таймер вправи або введіть повторення для силової вправи за %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算训练热量前，请先停止并保存某个动作的计时器，或为 %@ 的力量动作输入次数。"
          }
        }
      }
    },
