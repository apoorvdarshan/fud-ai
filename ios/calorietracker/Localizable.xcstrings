    "Focus each day around one major muscle or body region.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Centra cada día en un músculo principal o una región del cuerpo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ركّز كل يوم على عضلة رئيسية واحدة أو منطقة واحدة من الجسم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hər günü bir əsas əzələ və ya bədən nahiyəsi ətrafında qurun."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý den se zaměř na jednu hlavní svalovou skupinu nebo oblast těla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte jeden Tag auf einen großen Muskel oder eine Körperregion aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrez chaque jour sur un grand muscle ou une région du corps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन को एक मुख्य मांसपेशी या शरीर के हिस्से पर केंद्रित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dedica ogni giorno a un muscolo principale o a una zona del corpo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日ごとに1つの主要な筋肉または部位に集中します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 하나의 주요 근육이나 신체 부위에 집중합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Richt elke dag op één grote spier of lichaamsregio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy dzień skupiaj na jednej głównej grupie mięśni lub partii ciała."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentre cada dia em um músculo principal ou região do corpo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrează fiecare zi pe un mușchi principal sau o regiune a corpului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посвящайте каждый день одной крупной мышце или зоне тела."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her günü tek bir ana kas veya vücut bölgesine odaklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Присвячуйте кожен день одному великому м’язу або ділянці тіла."
          }
        },
        "zh-Hans": {
          "stringUnit": {
