    "whisper.error.notDownloaded": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تنزيل Whisper Base. نزّله من الإعدادات ← تحويل الكلام إلى نص."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base endirilməyib. Onu Parametrlər → Nitqdən mətnə bölməsindən endirin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base wurde nicht heruntergeladen. Lade es unter Einstellungen → Sprache-zu-Text herunter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whisper Base is not downloaded. Download it in Settings → Speech-to-Text."
