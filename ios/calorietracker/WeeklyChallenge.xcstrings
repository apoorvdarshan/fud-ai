    "Use 2 to 40 letters or numbers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من 2 إلى 40 حرفًا: أحرف أو أرقام أو مسافات أو نقطة أو شرطة سفلية أو فاصلة عليا أو شرطة"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 simvol: hərflər, rəqəmlər, boşluqlar, nöqtə, alt xətt, apostrof və ya defis"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 Zeichen: Buchstaben, Zahlen, Leerzeichen, Punkt, Unterstrich, Apostroph oder Bindestrich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 2 to 40 letters or numbers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De 2 a 40 caracteres: letras, números, espacios, punto, guion bajo, apóstrofo o guion"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 à 40 caractères : lettres, chiffres, espaces, point, tiret bas, apostrophe ou tiret"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 वर्ण: अक्षर, अंक, स्पेस, बिंदु, अंडरस्कोर, एपॉस्ट्रॉफ़ी या हाइफ़न"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 caratteri: lettere, numeri, spazi, punto, trattino basso, apostrofo o trattino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2～40文字：文字、数字、スペース、ピリオド、アンダースコア、アポストロフィ、ハイフン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2~40자: 문자, 숫자, 공백, 마침표, 밑줄, 아포스트로피 또는 하이픈"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 tekens: letters, cijfers, spaties, punt, laag streepje, apostrof of koppelteken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj od 2 do 40 liter lub cyfr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De 2 a 40 caracteres: letras, números, espaços, ponto, sublinhado, apóstrofo ou hífen"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 de caractere: litere, cifre, spații, punct, linie de subliniere, apostrof sau cratimă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От 2 до 40 символов: буквы, цифры, пробелы, точка, подчёркивание, апостроф или дефис"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте від 2 до 40 літер або цифр."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2–40 个字符：字母、数字、空格、句点、下划线、撇号或连字符"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 ile 40 arası harf veya rakam kullanın."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použij 2 až 40 písmen nebo číslic."
          }
        }
      }
    },
