    "Best for lifting: rate effort by how many reps you had left.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para pesas: valora el esfuerzo según cuántas repeticiones te quedaban."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأفضل لرفع الأثقال: قيّم الجهد حسب عدد التكرارات المتبقية لديك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlıq qaldırmaq üçün ən yaxşısı: səyi neçə təkrar ehtiyatınız qaldığına görə qiymətləndirin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejlepší pro silový trénink: hodnoť námahu podle toho, kolik opakování ti zbývalo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal fürs Krafttraining: Bewerte die Anstrengung danach, wie viele Wiederholungen noch drin gewesen wären."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idéal pour la musculation : évaluez l’effort selon le nombre de répétitions qu’il vous restait."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिफ़्टिंग के लिए सबसे अच्छा: बचे हुए रेप्स के आधार पर प्रयास रेट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideale per i pesi: valuta lo sforzo in base a quante ripetizioni ti restavano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋トレに最適：あと何回できたかで負荷を評価します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웨이트 트레이닝에 가장 적합: 남은 반복 횟수로 운동 강도를 평가합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideaal voor krachttraining: beoordeel de inspanning op hoeveel herhalingen je nog over had."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepsze do treningu siłowego: oceniaj wysiłek według liczby powtórzeń, które jeszcze mogłeś zrobić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal para musculação: avalie o esforço pelas repetições que ainda restavam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal pentru forță: evaluează efortul după câte repetări mai puteai face."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше всего для силовых: оценивайте усилие по количеству повторений в запасе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık antrenmanı için en iyisi: eforu kaç tekrarınız kaldığına göre değerlendirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найкраще для силових: оцінюйте зусилля за кількістю повторень у запасі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最适合力量训练：根据你还能再做几次来评估用力程度。"
          }
        }
      }
    },
