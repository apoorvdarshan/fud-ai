          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimite orice masă ca link care se deschide direct în Fud AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делитесь любым приёмом пищи ссылкой, которая открывается прямо в Fud AI."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Діліться будь-якою стравою як посиланням, що відкривається прямо у Fud AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
