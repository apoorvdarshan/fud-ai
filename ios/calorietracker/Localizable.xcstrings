          "stringUnit": {
            "state": "translated",
            "value": "سجل دهون الجسم: راجع واحذف الإدخالات الفردية تمامًا كما في الوزن."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bədən yağı tarixçəsi: çəki kimi ayrı-ayrı qeydlərə baxın və silin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Körperfett-Verlauf: einzelne Einträge ansehen und löschen, genau wie beim Gewicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial de grasa corporal: revisa y elimina entradas individuales, igual que con el peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique de masse grasse : consultez et supprimez chaque entrée, comme pour le poids."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बॉडी फ़ैट इतिहास: वज़न की तरह हर प्रविष्टि देखें और हटाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Storico grasso corporeo: consulta ed elimina le singole voci, proprio come per il peso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体脂肪履歴：体重と同じように、個別の記録を確認・削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체지방 기록: 체중과 마찬가지로 개별 항목을 확인하고 삭제할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetpercentagegeschiedenis: bekijk en verwijder losse metingen, net als bij gewicht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia tkanki tłuszczowej: przeglądaj i usuwaj pojedyncze wpisy, tak jak przy wadze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Histórico de gordura corporal: veja e exclua entradas individuais, como no peso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoric grăsime corporală: vezi și șterge intrări individuale, la fel ca la greutate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История жира: просматривайте и удаляйте отдельные записи, как и с весом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Історія жиру в організмі: переглядайте та видаляйте окремі записи, так само як і вагу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体脂历史：像体重一样查看并删除单条记录。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Historie tělesného tuku: prohlížej a maž jednotlivé záznamy, stejně jako u váhy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vücut yağı geçmişi: tıpkı kiloda olduğu gibi, ölçümleri tek tek inceleyip silebilirsiniz."
          }
        }
      }
    },
