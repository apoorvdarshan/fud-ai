    "gemma.unsupportedDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوفر نموذج الصور والنصوص هذا الذي يعمل على الجهاز على أجهزة iPhone المزودة بذاكرة فعلية لا تقل عن 8 غيغابايت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaxili şəkil və mətn modeli ən azı 8 GB fiziki yaddaşa malik iPhone-larda əlçatandır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild- und Textmodell auf dem Gerät ist auf iPhones mit mindestens 8 GB physischem Arbeitsspeicher verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This on-device image and text model is available on iPhones with at least 8 GB of physical memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo de imágenes y texto en el dispositivo está disponible en iPhone con al menos 8 GB de memoria física."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle d’image et de texte sur l’appareil est disponible sur les iPhone disposant d’au moins 8 Go de mémoire physique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस पर चलने वाला यह इमेज और टेक्स्ट मॉडल कम से कम 8 GB फ़िज़िकल मेमोरी वाले iPhone पर उपलब्ध है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modello di immagini e testo sul dispositivo è disponibile sugli iPhone con almeno 8 GB di memoria fisica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオンデバイス画像・テキストモデルは、物理メモリを 8 GB 以上搭載した iPhone で利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 온디바이스 이미지 및 텍스트 모델은 물리 메모리가 8GB 이상인 iPhone에서 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit beeld- en tekstmodel op het apparaat is beschikbaar op iPhones met ten minste 8 GB fysiek geheugen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten działający na urządzeniu model obrazu i tekstu jest dostępny na iPhone’ach z co najmniej 8 GB pamięci fizycznej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo de imagem e texto no dispositivo está disponível em iPhones com pelo menos 8 GB de memória física."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest model de imagine și text de pe dispozitiv este disponibil pe iPhone-uri cu cel puțin 8 GB de memorie fizică."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта локальная модель для изображений и текста доступна на iPhone как минимум с 8 ГБ физической памяти."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ета локальна модель для изображений и текста доступна на iPhone как минимум с 8 ГБ физической пам'яті."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备端图像和文本模型可用于物理内存至少为 8 GB 的 iPhone。"
          }
        }
      }
    },
    "gemma.downloadDescription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجم التنزيل 2.59 غيغابايت. يتحقق Fud AI من توفر مساحة إضافية خالية قدرها 1 غيغابايت للتثبيت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Endirmə ölçüsü 2,59 GB-dır. Fud AI quraşdırma üçün əlavə 1 GB boş yerin olmasını yoxlayır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "2,59 GB Download. Fud AI prüft, ob zusätzlich 1 GB freier Speicher für die Installation verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2.59 GB download. Fud AI checks for an additional 1 GB of free installation headroom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga de 2,59 GB. Fud AI comprueba que haya 1 GB adicional de espacio libre para la instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement de 2,59 Go. Fud AI vérifie qu’un espace libre supplémentaire de 1 Go est disponible pour l’installation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2.59 GB का डाउनलोड। Fud AI इंस्टॉलेशन के लिए 1 GB अतिरिक्त खाली जगह की जांच करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download da 2,59 GB. Fud AI verifica che sia disponibile 1 GB aggiuntivo di spazio libero per l’installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2.59 GB のダウンロードです。Fud AI はインストール用にさらに 1 GB の空き容量があることを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2.59GB 다운로드입니다. Fud AI는 설치 여유 공간으로 1GB가 추가로 비어 있는지 확인합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download van 2,59 GB. Fud AI controleert of er 1 GB extra vrije installatieruimte beschikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieranie 2,59 GB. Fud AI sprawdza, czy dostępny jest dodatkowy 1 GB wolnego miejsca na instalację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Download de 2,59 GB. O Fud AI verifica se há mais 1 GB de espaço livre para a instalação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Descărcare de 2,59 GB. Fud AI verifică dacă mai există 1 GB de spațiu liber pentru instalare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер загрузки — 2,59 ГБ. Fud AI проверяет наличие ещё 1 ГБ свободного места для установки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір завантаження — 2,59 ГБ. Fud AI перевірет наличие ещё 1 ГБ вільного місця для установки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载大小为 2.59 GB。Fud AI 会检查是否另有 1 GB 可用安装空间。"
          }
        }
      }
    },
    "gemma.storedWithSize": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التحقق منه وتخزينه محليًا (%@). اضغط على «تحضير» الآن، وإلا فسيتم تحميله عند أول استخدام."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoxlanılıb və yerli olaraq saxlanılıb (%@). İndi Hazırla seçiminə toxunun, əks halda ilk istifadədə yüklənəcək."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüft und lokal gespeichert (%@). Tippe jetzt auf „Vorbereiten“, andernfalls wird das Modell bei der ersten Verwendung geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified and stored locally (%@). Tap Prepare now, or it will load on first use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificado y almacenado localmente (%@). Toca Preparar ahora; de lo contrario, se cargará la primera vez que se use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifié et stocké localement (%@). Touchez Préparer maintenant, sinon il se chargera lors de la première utilisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि करके स्थानीय रूप से स्टोर किया गया (%@)। अभी तैयार करें पर टैप करें, नहीं तो यह पहली बार उपयोग करने पर लोड होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificato e archiviato localmente (%@). Tocca Prepara ora, altrimenti verrà caricato al primo utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証され、ローカルに保存されています（%@）。今すぐ「準備」をタップしてください。操作しない場合は初回使用時に読み込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인 후 로컬에 저장됨(%@). 지금 준비를 탭하세요. 그렇지 않으면 처음 사용할 때 불러옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geverifieerd en lokaal opgeslagen (%@). Tik nu op Voorbereiden, anders wordt het model bij het eerste gebruik geladen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweryfikowano i zapisano lokalnie (%@). Stuknij teraz Przygotuj, w przeciwnym razie model zostanie wczytany przy pierwszym użyciu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificado e armazenado localmente (%@). Toque em Preparar agora; caso contrário, ele será carregado no primeiro uso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificat și stocat local (%@). Atingeți Pregătește acum; altfel, se va încărca la prima utilizare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверено и сохранено локально (%@). Нажмите «Подготовить» сейчас, иначе модель загрузится при первом использовании."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірено та збережено локально (%@). Натисніть «Підготувати» сейчас, иначе модель завантажиться під час першого використання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已验证并存储在本地（%@）。现在轻点“准备”，否则将在首次使用时加载。"
          }
        }
      }
    },
