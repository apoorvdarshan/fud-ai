    "We'll keep your calories steady\nto maintain your current weight.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantendremos tus calorías estables\npara conservar tu peso actual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Manterremo costanti le tue calorie\nper conservare il tuo peso attuale."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymamy stałą liczbę kalorii,\naby zachować obecną wagę."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы будем поддерживать калории на стабильном уровне,\nчтобы сохранить ваш текущий вес."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми триматимемо калорії на стабільному рівні,\nщоб зберегти вашу поточну вагу."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorie nastavíme tak,\naby tvoje váha zůstala stejná."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut kilonuzu korumak için\nkalorilerinizi sabit tutacağız."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنحافظ على ثبات سعراتك الحرارية\nللحفاظ على وزنك الحالي."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırkı çəkinizi qorumaq üçün\nkalorilərinizi sabit saxlayacağıq."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir halten deine Kalorien stabil,\num dein aktuelles Gewicht zu halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous garderons vos calories stables\npour maintenir votre poids actuel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम आपका वर्तमान वज़न बनाए रखने के लिए\nआपकी कैलोरी स्थिर रखेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の体重を維持するために\nカロリーを安定させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 체중을 유지하도록\n칼로리를 안정적으로 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We houden je calorieën stabiel\nom je huidige gewicht te behouden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manteremos suas calorias estáveis\npara conservar seu peso atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vom menține caloriile constante\npentru a-ți păstra greutatea actuală."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会让你的卡路里保持稳定，\n以维持当前体重。"
          }
        }
      }
    },
    "We're setting everything\nup for you": {
      "localizations": {
        "es": {
