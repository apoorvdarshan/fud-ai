        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将该食物从日记中移除。已保存的收藏会保留。"
          }
        }
      }
    },
    "This removes the workout from your diary. Saved exercises are kept.": {
