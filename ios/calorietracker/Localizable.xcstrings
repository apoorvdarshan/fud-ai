    "Remove %@'s entry of %@? This also deletes the matching sample from Apple Health.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Remove %1$@'s entry of %2$@? This also deletes the matching sample from Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar el registro de %2$@ del %1$@? También se eliminará la muestra correspondiente de Apple Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere la voce del %1$@ di %2$@? Verrà eliminato anche il campione corrispondente da Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć wpis %1$@ dla %2$@? Spowoduje to też usunięcie pasującej próbki z Apple Health."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить запись %1$@ о %2$@? Это также удалит соответствующую запись из Apple Health."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити запис за %1$@ (%2$@)? Відповідний запис також буде видалено з Apple Health."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odebrat záznam z %1$@ s hodnotou %2$@? Smaže se tím i odpovídající vzorek z Apple Health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adlı kişinin %@ kaydı kaldırılsın mı? Bu işlem, Apple Sağlık'taki eşleşen örneği de siler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة إدخال %1$@ بقيمة %2$@؟ سيؤدي ذلك أيضًا إلى حذف العينة المطابقة من Apple Health."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tarixli %2$@ qeydi silinsin? Bu, Apple Health-dəki uyğun nümunəni də silir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eintrag vom %1$@ (%2$@) entfernen? Dadurch wird auch der passende Wert in Apple Health gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer l’entrée du %1$@ (%2$@) ? L’échantillon correspondant sera aussi supprimé d’Apple Health."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ की %2$@ वाली प्रविष्टि हटाएं? इससे Apple Health से मेल खाता सैंपल भी हट जाएगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の%2$@の記録を削除しますか？Apple Healthの対応するデータも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 %2$@ 항목을 삭제할까요? Apple Health의 해당 샘플도 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Item van %1$@ (%2$@) verwijderen? Hiermee wordt ook het bijbehorende monster uit Apple Health verwijderd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover o registro de %2$@ de %1$@? Isso também apaga a amostra correspondente do Apple Health."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimini intrarea din %1$@ (%2$@)? Se șterge și eșantionul corespunzător din Apple Health."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除 %1$@ 的 %2$@ 记录吗？这也会删除 Apple Health 中对应的样本。"
          }
        }
      }
    },
