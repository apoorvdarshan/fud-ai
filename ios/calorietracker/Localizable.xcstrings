        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Lebensmittel aus deinem Tagebuch entfernt. Gespeicherte Favoriten bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retire l’aliment de votre journal. Les favoris enregistrés sont conservés."
          }
