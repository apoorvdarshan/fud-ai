    "Exports your logged meals, nutrition totals, and water intake as a file you can save or send to another app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta tus comidas registradas, los totales nutricionales y el consumo de agua como un archivo que puedes guardar o enviar a otra app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğiniz öğünleri, besin değerleri toplamlarını ve su tüketimini kaydedebileceğiniz veya başka bir uygulamaya gönderebileceğiniz bir dosya olarak dışa aktarır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يصدّر وجباتك المسجلة وإجماليات التغذية واستهلاك الماء كملف يمكنك حفظه أو إرساله إلى تطبيق آخر."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeyd etdiyiniz yeməkləri, qida cəmlərini və su qəbulunu saxlaya və ya başqa tətbiqə göndərə biləcəyiniz fayl kimi ixrac edir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportuje zapsaná jídla, souhrny výživy a příjem vody jako soubor, který můžeš uložit nebo poslat do jiné aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiert deine eingetragenen Mahlzeiten, Nährwertsummen und Wasseraufnahme als Datei, die du speichern oder an eine andere App senden kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte vos repas enregistrés, vos totaux nutritionnels et votre consommation d’eau dans un fichier que vous pouvez enregistrer ou envoyer à une autre app."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लॉग किए गए भोजन, पोषण का कुल योग और पानी का सेवन एक फ़ाइल के रूप में एक्सपोर्ट करता है, जिसे आप सहेज सकते हैं या किसी दूसरे ऐप में भेज सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta pasti registrati, totali nutrizionali e acqua assunta in un file da salvare o inviare a un’altra app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した食事、栄養の合計、水分摂取量を、保存したり別のアプリに送ったりできるファイルとして書き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 식사, 영양 합계, 물 섭취량을 저장하거나 다른 앱으로 보낼 수 있는 파일로 내보냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteert je gelogde maaltijden, voedingstotalen en waterinname als bestand dat je kunt bewaren of naar een andere app kunt sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuje zapisane posiłki, sumy wartości odżywczych i spożycie wody do pliku, który możesz zapisać lub wysłać do innej aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta suas refeições registradas, totais nutricionais e consumo de água como um arquivo que você pode salvar ou enviar para outro app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportă mesele înregistrate, totalurile nutriționale și consumul de apă într-un fișier pe care îl poți salva sau trimite altei aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортирует записанные приёмы пищи, итоги по питанию и потребление воды в файл, который можно сохранить или отправить в другое приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експортує записані прийоми їжі, підсумки харчування та споживання води у файл, який можна зберегти або надіслати в інший застосунок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将已记录的餐食、营养总量和饮水量导出为文件，可保存或发送到其他 App。"
          }
        }
      }
    },
