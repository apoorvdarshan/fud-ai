            "value": "Não foi possível conectar ao serviço de voz. Verifique sua conexão e tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a putut face conexiunea la serviciul vocal. Verifică-ți conexiunea și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к голосовому сервису. Проверьте подключение и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
