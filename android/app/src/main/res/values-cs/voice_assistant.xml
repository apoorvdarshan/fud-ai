    <string name="voice_notice_setup_title">Hlasový asistent</string>
    <string name="voice_notice_setup_body">Mluv a zapisuj jídla, skenuj jídlo i čárové kódy a ptej se na svůj pokrok. Hlasový asistent běží s plánem Fud AI Plus nebo Pro, nebo s tvým vlastním API klíčem od Gemini, OpenAI, xAI či Qwen.</string>
    <string name="voice_notice_missing_key_title">Přidej klíč pro %1$s</string>
    <string name="voice_notice_missing_key_body">Hlasový asistent používá %1$s, což vyžaduje tvůj API klíč. Přidej ho v části Poskytovatelé AI nebo zvol jiného poskytovatele v nastavení hlasového asistenta.</string>
    <string name="voice_notice_subscription_title">Hlas Fud AI vyžaduje plán Plus nebo Pro</string>
    <string name="voice_notice_subscription_body">Hlasové konverzace hostované službou Fud AI jsou součástí plánů Plus (20 minut měsíčně) a Pro (100 minut měsíčně). Můžeš také použít vlastní klíč Gemini, OpenAI, xAI nebo Qwen.</string>
    <string name="voice_notice_minutes_title">Došly ti hlasové minuty</string>
    <string name="voice_notice_minutes_body">Hlasové minuty tvého plánu na tento měsíc jsou vyčerpané. Kup si kredity a mluv dál (4 kredity za minutu), nebo použij vlastní klíč od Gemini, OpenAI, xAI či Qwen.</string>
    <string name="voice_notice_limit_title">Byl dosažen limit konverzace</string>
    <string name="voice_notice_limit_body">Tahle konverzace dosáhla limitu 15 minut. Pokračuj tím, že začneš novou.</string>
    <string name="voice_notice_mic_title">Je potřeba přístup k mikrofonu</string>
    <string name="voice_notice_mic_body">Pokud chceš mluvit s asistentem, povol aplikaci Fud AI přístup k mikrofonu v nastavení systému.</string>
    <string name="voice_notice_mic_busy_title">Mikrofon není k dispozici.</string>
    <string name="voice_notice_mic_busy_body">Mikrofon možná používá jiná aplikace. Zavři ji a zkus to znovu.</string>
    <string name="voice_notice_key_rejected_title">%1$s odmítl klíč</string>
    <string name="voice_notice_key_rejected_body">V části Poskytovatelé AI zkontroluj API klíč pro %1$s, jeho fakturaci a přístup k modelům pro hlasové konverzace v reálném čase.</string>
    <string name="voice_notice_unauthorized_title">Tvůj plán se nepodařilo ověřit</string>
    <string name="voice_notice_unauthorized_body">Tvé předplatné se nepodařilo ověřit. Zkus Obnovit nákupy v Nastavení → Přístup k AI.</string>
    <string name="voice_notice_busy_title">Příliš mnoho požadavků</string>
    <string name="voice_notice_busy_body">Teď probíhá příliš mnoho hlasových relací. Zkus to znovu za minutu.</string>
    <string name="voice_notice_unavailable_title">Hlas teď není k dispozici. Zkus to znovu později.</string>
    <string name="voice_notice_unavailable_body">Hlasová služba narazila na problém. Zkus to znovu.</string>
    <string name="voice_notice_connect_title">Nepodařilo se připojit</string>
    <string name="voice_notice_connect_body">Nepodařilo se připojit k hlasové službě. Zkontroluj připojení a zkus to znovu.</string>
    <string name="voice_notice_lost_title">Hlasové spojení skončilo.</string>
    <string name="voice_notice_lost_body">Hlasové spojení skončilo. Zkontroluj připojení k internetu a zkus to znovu.</string>

