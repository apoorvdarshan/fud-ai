    "Changes apply to the next conversation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبّق التغييرات على المحادثة التالية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Dəyişikliklər növbəti söhbətdə tətbiq olunur."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny se projeví při příští konverzaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen gelten ab dem nächsten Gespräch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican en la próxima conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements s’appliquent à la prochaine conversation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव अगली बातचीत से लागू होंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si applicano alla prossima conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は次回の会話から適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 다음 대화부터 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen gelden vanaf het volgende gesprek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany zostaną zastosowane w następnej rozmowie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mudanças serão aplicadas na próxima conversa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările se aplică de la conversația următoare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения вступят в силу в следующем разговоре."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler bir sonraki sohbette geçerli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни набудуть чинності в наступній розмові."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改将在下一次对话中生效。"
          }
        }
      }
    },
