{
  "sourceLanguage": "en",
  "strings": {
    "iCloud Backup": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервна копія iCloud"
          }
        }
      }
    },
    "Off until you turn it on. Uses the iCloud account on this iPhone. API keys stay on the device.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнено, доки ви не увімкнете. Використовує обліковий запис iCloud на цьому iPhone. Ключі API залишаються на пристрої."
          }
        }
      }
    },
    "Uploads your diary, workouts, fasting, photos, and settings to your iCloud. API keys stay on the phone.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує ваш щоденник, тренування, голодування, фото та налаштування в iCloud. Ключі API залишаються на телефоні."
          }
        }
      }
    },
    "Restore backup?": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити резервну копію?"
          }
        }
      }
    },
    "Restore it, or keep this phone.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити її чи залишити цей телефон?"
          }
        }
      }
    },
    "Restore": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити"
          }
        }
      }
    },
    "Keep this phone": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишити цей телефон"
          }
        }
      }
    },
    "Back up now": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервне копіювання зараз"
          }
        }
      }
    },
    "Restore now": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити зараз"
          }
        }
      }
    },
    "Delete cloud backup": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити хмарну резервну копію"
          }
        }
      }
    },
    "Delete cloud backup?": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити хмарну резервну копію?"
          }
        }
      }
    },
    "Removes the Fud AI file from iCloud. This iPhone is unchanged.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє файл Fud AI з iCloud. Цей iPhone залишається без змін."
          }
        }
      }
    },
