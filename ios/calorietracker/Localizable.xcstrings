    "We just launched. A vote helps more people find Fud AI.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabamos de lanzarlo. Un voto ayuda a que más personas encuentren Fud AI."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أطلقنا للتو. يساعد التصويت مزيدًا من الناس على اكتشاف Fud AI."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Biz yenicə istifadəyə verdik. Səsiniz daha çox insanın Fud AI-ı tapmasına kömək edir."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Právě jsme spustili. Hlas pomůže, aby Fud AI našlo víc lidí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sind gerade gestartet. Eine Stimme hilft mehr Menschen, Fud AI zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous venons de lancer. Un vote aide plus de personnes à découvrir Fud AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने अभी लॉन्च किया है। आपका वोट ज़्यादा लोगों को Fud AI खोजने में मदद करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo appena lanciato. Un voto aiuta più persone a scoprire Fud AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローンチしたばかりです。投票してもらえると、より多くの人にFud AIを知ってもらえます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 출시했습니다. 투표해 주시면 더 많은 사람이 Fud AI를 찾을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We zijn net gelanceerd. Een stem helpt meer mensen Fud AI te ontdekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Właśnie wystartowaliśmy. Twój głos pomoże większej liczbie osób znaleźć Fud AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabamos de lançar. Um voto ajuda mais pessoas a encontrar o Fud AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocmai ne-am lansat. Un vot ajută mai mulți oameni să descopere Fud AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы только что запустились. Ваш голос поможет большему числу людей найти Fud AI."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni yayına çıktık. Bir oy, daha fazla kişinin Fud AI'ı bulmasına yardımcı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми щойно запустилися. Ваш голос допоможе більшій кількості людей знайти Fud AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们刚刚上线。你的投票能帮助更多人发现 Fud AI。"
          }
        }
      }
    },
