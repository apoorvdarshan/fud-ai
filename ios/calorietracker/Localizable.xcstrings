        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głównie siedzący tryb w pracy i w domu; mało lub brak zaplanowanego ruchu.\nOrientacyjnie: poniżej 5000 kroków/dzień."
