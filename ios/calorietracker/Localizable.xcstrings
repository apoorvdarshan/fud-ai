    "10 new theme colors, now picked inline in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "10 ألوان جديدة للسمة، تُختار الآن مباشرة من الإعدادات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "10 yeni tema rəngi — indi birbaşa Parametrlərdə seçilir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "10 neue Themenfarben, jetzt direkt in den Einstellungen wählbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "10 nuevos colores de tema, ahora elegidos directamente en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "10 nouvelles couleurs de thème, désormais choisies directement dans les Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "10 नए थीम रंग, अब सेटिंग्स में ही चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "10 nuovi colori tema, ora scelti direttamente nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマカラーを10色追加。設定内でそのまま選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마 색상 10종 추가 — 이제 설정에서 바로 선택합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 nieuwe themakleuren, nu direct te kiezen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "10 nowych kolorów motywu, wybieranych teraz bezpośrednio w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "10 novas cores de tema, agora escolhidas direto nos Ajustes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "10 culori noi de temă, alese acum direct din Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "10 новых цветов темы — теперь выбираются прямо в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "10 нових кольорів теми, які тепер можна вибрати прямо в Налаштуваннях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新增 10 种主题色，现在可在设置中直接选择。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "10 nových barev motivu, nově vybíraných přímo v Nastavení."
          }
        }
      }
    },
