    "Check the package label and follow your clinician's advice.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la etiqueta del paquete y sigue las indicaciones de tu médico."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من ملصق العبوة واتبع نصيحة طبيبك."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Qablaşdırma etiketini yoxlayın və həkiminizin tövsiyəsinə əməl edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontroluj etiketu na obalu a řiď se radou svého lékaře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe das Etikett auf der Verpackung und folge dem Rat deiner Ärztin oder deines Arztes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’étiquette de l’emballage et suivez les conseils de votre médecin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैकेट का लेबल देखें और अपने चिकित्सक की सलाह मानें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla l’etichetta della confezione e segui i consigli del tuo medico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージの表示を確認し、医師の指示に従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포장 라벨을 확인하고 담당 의료진의 조언을 따르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer het etiket op de verpakking en volg het advies van je arts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź etykietę na opakowaniu i postępuj zgodnie z zaleceniami lekarza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o rótulo da embalagem e siga a orientação do seu médico."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică eticheta ambalajului și urmează sfatul medicului tău."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте этикетку на упаковке и следуйте рекомендациям врача."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket etiketini kontrol edin ve doktorunuzun tavsiyesine uyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте етикетку на упаковці та дотримуйтеся порад лікаря."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请查看包装标签，并遵循医生的建议。"
          }
        }
      }
    },
    "Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet bağlantınızı kontrol edip yeniden deneyin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقّق من اتصالك وحاول مرة أخرى."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantınızı yoxlayın və yenidən cəhd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkontroluj připojení a zkus to znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie ta connexion et réessaie."
          }
        },
        "hi": {
