    "Leaderboard results are visible only to people who join. You can leave and delete your remote challenge data at any time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تظهر نتائج لوحة الصدارة إلا للمنضمين. يمكنك المغادرة وحذف بيانات التحدي البعيدة في أي وقت."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Reytinq nəticələrini yalnız qoşulanlar görür. İstənilən vaxt çıxıb uzaq serverdəki çağırış məlumatlarınızı silə bilərsiniz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranglistenergebnisse sind nur für Teilnehmende sichtbar. Du kannst jederzeit austreten und deine Remote-Challenge-Daten löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaderboard results are visible only to people who join. You can leave and delete your remote challenge data at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quienes participan pueden ver los resultados de la clasificación. Puedes salir y borrar tus datos remotos del reto en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats du classement ne sont visibles que par les participants. Vous pouvez quitter et supprimer vos données de défi en ligne à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लीडरबोर्ड के नतीजे केवल शामिल होने वालों को दिखते हैं। आप कभी भी छोड़कर अपना रिमोट चुनौती डेटा हटा सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati della classifica sono visibili solo a chi partecipa. Puoi uscire ed eliminare i dati remoti della sfida in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランキングの結果は参加者だけが見られます。いつでも退出して、サーバー上のチャレンジデータを削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "순위표 결과는 참여한 사람에게만 보입니다. 언제든지 나가서 서버에 있는 챌린지 데이터를 삭제할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranglijstresultaten zijn alleen zichtbaar voor deelnemers. Je kunt op elk moment stoppen en je externe uitdagingsgegevens verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyniki rankingu widzą tylko uczestnicy. W każdej chwili możesz odejść i usunąć swoje zdalne dane wyzwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados da classificação ficam visíveis só para quem participa. Você pode sair e apagar seus dados remotos do desafio a qualquer momento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatele clasamentului sunt vizibile doar participanților. Poți ieși și șterge oricând datele provocării de pe server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты рейтинга видны только участникам. Вы можете в любой момент выйти и удалить свои данные соревнования на сервере."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результати рейтингу бачать лише учасники. Ви можете будь-коли вийти й видалити свої дані змагання на сервері."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排行榜结果仅对加入者可见。你可以随时退出并删除服务器上的挑战数据。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralama sonuçları yalnızca katılan kişilere görünür. İstediğiniz zaman ayrılabilir ve uzak yarışma verilerinizi silebilirsiniz."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledky žebříčku vidí jen ti, kdo se připojí. Kdykoli můžeš odejít a smazat svá vzdálená data výzvy."
          }
        }
      }
    },
    "Leave & Delete Remote Data": {
      "localizations": {
