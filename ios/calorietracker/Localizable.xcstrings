    "Hosted AI is temporarily unavailable. Please try again shortly.": {
      "comment": "Hosted AI error when the AI provider behind the service is down.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء الاصطناعي المستضاف غير متاح مؤقتًا. يُرجى المحاولة مرة أخرى بعد قليل."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
