    "In the iOS Settings app, open Action Button, choose Shortcut, then Fud AI → Talk to Fud AI.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في تطبيق الإعدادات على iOS، افتح زر الإجراءات، واختر اختصار، ثم Fud AI ← تحدث إلى Fud AI."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Ayarlar tətbiqində Fəaliyyət düyməsini açın, Qısayol seçin, sonra Fud AI → Fud AI ilə danış."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V aplikaci Nastavení otevři Akční tlačítko, vyber Zkratku a pak Fud AI → Mluvit s Fud AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in der Einstellungen-App „Aktionstaste“, wähle „Kurzbefehl“ und dann Fud AI → Mit Fud AI sprechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la app Ajustes, abre Botón de acción, elige Atajo y luego Fud AI → Hablar con Fud AI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans l’app Réglages, ouvrez Bouton Action, choisissez Raccourci, puis Fud AI → Parler à Fud AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS सेटिंग्स ऐप में ऐक्शन बटन खोलें, शॉर्टकट चुनें, फिर Fud AI → Fud AI से बात करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell’app Impostazioni apri Tasto Azione, scegli Comando rapido, poi Fud AI → Parla con Fud AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの「設定」アプリで「アクションボタン」を開き、「ショートカット」を選んで、Fud AI →「Fud AIと話す」を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정 앱에서 동작 버튼을 열고 단축어를 선택한 다음 Fud AI → Fud AI와 대화하기를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in de Instellingen-app ‘Actieknop’, kies ‘Opdracht’ en daarna Fud AI → Praat met Fud AI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W aplikacji Ustawienia otwórz Przycisk czynności, wybierz Skrót, a potem Fud AI → Porozmawiaj z Fud AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No app Ajustes, abra Botão de Ação, escolha Atalho e depois Fud AI → Falar com o Fud AI."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "În aplicația Configurări, deschide Butonul Acțiune, alege Scurtătură, apoi Fud AI → Vorbește cu Fud AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В приложении «Настройки» откройте «Кнопка действия», выберите «Быстрая команда», затем Fud AI → «Поговорить с Fud AI»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Ayarlar uygulamasında Eylem Düğmesi’ni açın, Kestirme’yi seçin, ardından Fud AI → Fud AI ile konuş’u seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У програмі «Параметри» відкрийте «Кнопка дії», виберіть «Швидка команда», а потім Fud AI → «Поговорити з Fud AI»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS“设置”App 中打开“操作按钮”，选择“快捷指令”，然后选择 Fud AI →“与 Fud AI 对话”。"
          }
        }
      }
    },
