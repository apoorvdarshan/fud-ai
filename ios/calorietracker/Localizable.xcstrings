    "Pick a photo or PDF of your allergy blood-test report.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una foto o un PDF de tu informe de análisis de sangre de alergias."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صورة أو ملف PDF لتقرير فحص الدم الخاص بالحساسية."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
