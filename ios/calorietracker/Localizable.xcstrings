            "state": "translated",
            "value": "75 kg 또는 165 lb처럼 체중을 말씀해 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem een gewicht, bijvoorbeeld 75 kg of 165 lb."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj wagę, na przykład 75 kg lub 165 lb."
          }
        },
        "pt-BR": {
          "stringUnit": {
