          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist nur für reine Textanfragen verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est disponible uniquement pour les requêtes textuelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence केवल टेक्स्ट वाले अनुरोधों के लिए उपलब्ध है।"
          }
        },
        "it": {
