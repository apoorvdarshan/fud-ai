    "Paste your %@ API key in the field above. The hint text is not a key.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega tu clave API de %@ en el campo de arriba. El texto de ayuda no es una clave."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق مفتاح API الخاص بـ %@ في الحقل أعلاه. النص التوضيحي ليس مفتاحًا."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API açarınızı yuxarıdakı sahəyə yapışdırın. İpucu mətni açar deyil."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlož svůj API klíč %@ do pole výše. Text nápovědy není klíč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen %@-API-Schlüssel oben in das Feld ein. Der Hinweistext ist kein Schlüssel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez votre clé API %@ dans le champ ci-dessus. Le texte indicatif n’est pas une clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी %@ API कुंजी ऊपर वाले फ़ील्ड में पेस्ट करें। संकेत वाला टेक्स्ट कुंजी नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla la tua chiave API %@ nel campo qui sopra. Il testo di suggerimento non è una chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のAPIキーを上の欄に貼り付けてください。ヒントの文字はキーではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위 필드에 %@ API 키를 붙여넣으세요. 안내 문구는 키가 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak je %@-API-sleutel in het veld hierboven. De hinttekst is geen sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej swój klucz API %@ w polu powyżej. Tekst podpowiedzi nie jest kluczem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole sua chave de API do %@ no campo acima. O texto de dica não é uma chave."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește cheia API %@ în câmpul de mai sus. Textul indicativ nu este o cheie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте свой ключ API %@ в поле выше. Текст подсказки — не ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ API anahtarınızı yukarıdaki alana yapıştırın. İpucu metni bir anahtar değildir."
          }
