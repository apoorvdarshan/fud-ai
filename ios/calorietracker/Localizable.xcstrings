    "Say \"Hey Siri, talk to Fud AI\".": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل: «يا Siri، تحدث إلى Fud AI»."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Deyin: “Hey Siri, Fud AI ilə danış”."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Řekni „Hej Siri, mluvit s Fud AI“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag „Hey Siri, mit Fud AI sprechen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di «Oye Siri, hablar con Fud AI»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites « Dis Siri, parler à Fud AI »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कहें “Hey Siri, Fud AI से बात करें”।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di’ «Ehi Siri, parla con Fud AI»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Hey Siri、Fud AIと話す」と言います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“Siri야, Fud AI와 대화하기”라고 말하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeg ‘Hé Siri, praat met Fud AI’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz „Hej Siri, porozmawiaj z Fud AI”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga “E aí, Siri, falar com o Fud AI”."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Spune „Hey Siri, vorbește cu Fud AI”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажите: «Привет, Siri, поговорить с Fud AI»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Hey Siri, Fud AI ile konuş” deyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажіть: «Привіт, Siri, поговорити з Fud AI»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说“嘿 Siri，与 Fud AI 对话”。"
          }
        }
      }
    },
