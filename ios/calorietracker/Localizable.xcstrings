    "Mostly seated at work and home; little or no planned exercise.\nApprox. step guide: under 5,000 steps/day.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentado la mayor parte del tiempo en el trabajo y en casa; poco o ningún ejercicio planificado.\nGuía aprox. de pasos: menos de 5000 pasos/día."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş ve evde çoğunlukla oturarak; planlı egzersiz çok az ya da hiç yok.\nYaklaşık adım sayısı: günde 5.000 adımdan az."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجلوس معظم الوقت في العمل والمنزل؛ قليل من التمارين المخططة أو لا شيء.\nدليل تقريبي: أقل من 5,000 خطوة/يوم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "İşdə və evdə əsasən oturaq; az və ya heç planlı məşq yoxdur.\nTəxmini göstərici: gündə 5 000 addımdan az."
          }
