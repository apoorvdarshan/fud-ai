    "Choose how you want to power AI in Fud AI. The app stays free either way.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كيف تريد تشغيل الذكاء الاصطناعي في Fud AI. التطبيق يبقى مجانيًا في كلتا الحالتين."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI-da AI-ni necə işlətmək istədiyinizi seçin. Tətbiq hər iki halda pulsuz qalır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie du KI in Fud AI nutzen möchtest. Die App bleibt in beiden Fällen kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo quieres usar la IA en Fud AI. La app sigue siendo gratis de cualquier forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis comment alimenter l'IA dans Fud AI. L'app reste gratuite dans les deux cas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि Fud AI में AI कैसे चलाना है। दोनों तरीकों में ऐप मुफ़्त रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli come alimentare l'IA in Fud AI. L'app resta gratuita in entrambi i casi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AIでAIをどう使うか選びましょう。どちらの方法でもアプリは無料のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fud AI에서 AI를 어떻게 사용할지 선택하세요. 두 방법 모두 앱은 무료입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe je AI in Fud AI wilt gebruiken. De app blijft in beide gevallen gratis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak chcesz korzystać z AI w Fud AI. Aplikacja pozostaje darmowa w obu przypadkach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como quer usar a IA no Fud AI. O app continua gratuito de qualquer forma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege cum vrei să folosești AI în Fud AI. Aplicația rămâne gratuită oricum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбери, как использовать ИИ в Fud AI. Приложение остаётся бесплатным в любом случае."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери, як використовувати ШІ у Fud AI. Застосунок залишається безкоштовним у будь-якому разі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择如何在 Fud AI 中使用 AI。无论哪种方式，应用都保持免费。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber, jak chceš v Fud AI používat AI. Aplikace zůstane v obou případech zdarma."
          }
        }
      }
    },
    "Add your own AI provider key — Gemini, OpenAI, Groq, and more are supported.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مفتاح مزود الذكاء الاصطناعي الخاص بك — Gemini وOpenAI وGroq والمزيد مدعومة."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Öz AI provayder açarınızı əlavə edin — Gemini, OpenAI, Groq və daha çoxu dəstəklənir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge deinen eigenen KI-Anbieter-Schlüssel hinzu — Gemini, OpenAI, Groq und mehr werden unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu propia clave de proveedor de IA — se admiten Gemini, OpenAI, Groq y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ta propre clé de fournisseur IA — Gemini, OpenAI, Groq et plus sont pris en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी AI प्रोवाइडर कुंजी जोड़ें — Gemini, OpenAI, Groq और अन्य समर्थित हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi la tua chiave del provider IA — sono supportati Gemini, OpenAI, Groq e altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のAIプロバイダーキーを追加 — Gemini、OpenAI、Groqなどに対応。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 AI 제공업체 키를 추가하세요 — Gemini, OpenAI, Groq 등을 지원합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg je eigen AI-providersleutel toe — Gemini, OpenAI, Groq en meer worden ondersteund."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj własny klucz dostawcy AI — obsługujemy Gemini, OpenAI, Groq i inne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sua própria chave de provedor de IA — Gemini, OpenAI, Groq e mais são suportados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă propria cheie de furnizor AI — Gemini, OpenAI, Groq și altele sunt suportate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавь свой ключ провайдера ИИ — поддерживаются Gemini, OpenAI, Groq и другие."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додай свій ключ провайдера ШІ — підтримуються Gemini, OpenAI, Groq та інші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加你自己的 AI 提供商密钥 — 支持 Gemini、OpenAI、Groq 等。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidej klíč svého AI poskytovatele — podporujeme Gemini, OpenAI, Groq a další."
          }
        }
      }
    },
    "Subscribe to Plus or Pro for hosted AI — no API key needed. Switch to BYOK anytime in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك في Plus أو Pro للذكاء الاصطناعي المستضاف — بدون مفتاح API. يمكنك التبديل إلى BYOK في أي وقت من الإعدادات."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Host edilmiş AI üçün Plus və ya Pro abunə olun — API açarı lazım deyil. İstənilən vaxt Parametrlərdə BYOK-a keçin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonniere Plus oder Pro für gehostete KI — kein API-Schlüssel nötig. Wechsle jederzeit in den Einstellungen zu BYOK."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete a Plus o Pro para IA alojada — no necesitas clave API. Cambia a BYOK cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonne-toi à Plus ou Pro pour l'IA hébergée — pas de clé API requise. Passe à BYOK à tout moment dans Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होस्टेड AI के लिए Plus या Pro सब्सक्राइब करें — API कुंजी की ज़रूरत नहीं। सेटिंग्स में कभी भी BYOK पर स्विच करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati a Plus o Pro per l'IA ospitata — nessuna chiave API necessaria. Passa a BYOK quando vuoi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト型AIにはPlusまたはProに登録 — APIキー不要。設定からいつでもBYOKに切り替え可能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스팅 AI를 위해 Plus 또는 Pro를 구독하세요 — API 키 불필요. 설정에서 언제든 BYOK로 전환할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer op Plus of Pro voor gehoste AI — geen API-sleutel nodig. Schakel wanneer je wilt over naar BYOK in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrybuj Plus lub Pro na hostowane AI — bez klucza API. W każdej chwili przełącz się na BYOK w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine Plus ou Pro para IA hospedada — sem chave de API. Troque para BYOK a qualquer momento em Ajustes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonează-te la Plus sau Pro pentru AI găzduit — fără cheie API. Treci oricând la BYOK din Setări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформи Plus или Pro для хостинг-ИИ — ключ API не нужен. В любой момент переключись на BYOK в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформи Plus або Pro для хостинг-ШІ — ключ API не потрібен. У будь-який момент перейди на BYOK у Налаштуваннях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅 Plus 或 Pro 使用托管 AI — 无需 API 密钥。可随时在设置中切换到 BYOK。"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předplať si Plus nebo Pro pro hostovanou AI — bez API klíče. Na BYOK můžeš kdykoli přepnout v Nastavení."
          }
        }
      }
    },
