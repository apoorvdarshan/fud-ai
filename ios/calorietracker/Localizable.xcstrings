    "Log something before the day ends.": {
      "comment": "Body of the streak reminder notification.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل شيئًا قبل انتهاء اليوم."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün bitməzdən əvvəl nəsə qeyd edin."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapiš něco, než den skončí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag noch etwas ein, bevor der Tag endet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra algo antes de que acabe el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre quelque chose avant la fin de la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन खत्म होने से पहले कुछ लॉग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra qualcosa prima che finisca la giornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日が終わる前に、何か記録しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘이 끝나기 전에 무엇이든 기록하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log iets voordat de dag voorbij is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj coś, zanim skończy się dzień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre algo antes que o dia acabe."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înregistrează ceva înainte să se termine ziua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите что-нибудь до конца дня."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gün bitmeden bir şey kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть щось до кінця дня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在今天结束前记录点什么吧。"
          }
        }
      }
    },
    "You ate %lld of %lld kcal today. %lld remaining!": {
      "comment": "Body of the daily summary notification: calories eaten, the daily calorie goal, and calories left. kcal is an abbreviation that does not change with the number; vary the remaining count by plural where the language needs it.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تناولت اليوم %1$lld من %2$lld kcal. المتبقي: %3$lld!"
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gün %1$lld / %2$lld kcal qəbul etdiniz. %3$lld kcal qaldı!"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnešní příjem: %1$lld z %2$lld kcal. %#@remaining@"
          },
          "substitutions": {
            "remaining": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Zbývají %arg kcal!"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Zbývá %arg kcal!"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Zbývá %arg kcal!"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "Zbývá %arg kcal!"
                    }
                  }
