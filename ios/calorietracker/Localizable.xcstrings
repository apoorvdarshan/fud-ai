        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încheie conversația vocală curentă înainte de a asculta o mostră de voce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите текущий голосовой разговор, прежде чем прослушать образец голоса."
