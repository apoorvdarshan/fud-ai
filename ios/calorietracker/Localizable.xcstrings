    "Subscribe to Plus or Pro to use hosted AI without bringing your own key.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اشترك في Plus أو Pro لاستخدام الذكاء الاصطناعي المستضاف دون إحضار مفتاحك الخاص."
          }
        },
        "az": {
          "stringUnit": {
            "state": "translated",
            "value": "Öz açarınızı gətirmədən host edilmiş AI istifadə etmək üçün Plus və ya Pro abunə olun."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonniere Plus oder Pro, um gehostete KI ohne eigenen Schlüssel zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscríbete a Plus o Pro para usar IA alojada sin traer tu propia clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonne-toi à Plus ou Pro pour utiliser l'IA hébergée sans ta propre clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कुंजी लाए बिना होस्टेड AI उपयोग करने के लिए Plus या Pro सब्सक्राइब करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbonati a Plus o Pro per usare l'IA ospitata senza portare la tua chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のキーなしでホスト型AIを使うにはPlusまたはProに登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 키 없이 호스팅 AI를 쓰려면 Plus 또는 Pro를 구독하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonneer op Plus of Pro om gehoste AI te gebruiken zonder je eigen sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrybuj Plus lub Pro, aby korzystać z hostowanego AI bez własnego klucza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assine Plus ou Pro para usar IA hospedada sem trazer sua própria chave."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonează-te la Plus sau Pro pentru a folosi AI găzduit fără propria cheie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформи Plus или Pro, чтобы пользоваться хостинг-ИИ без своего ключа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформи Plus або Pro, щоб користуватися хостинг-ШІ без власного ключа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
