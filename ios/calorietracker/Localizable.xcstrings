    "Get gentle reminders at meal times\nso you never forget to track.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi promemoria discreti agli orari dei pasti\nper non dimenticare di registrarli."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj delikatne przypomnienia w porach posiłków,\naby nie zapomnieć o śledzeniu."
